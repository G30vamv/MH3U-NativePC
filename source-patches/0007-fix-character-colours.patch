+    /// One group of four `DOT4` (r1.x, r1.y, r1.z, r1.w against 1.0), each with the output modifier "divide by 2", writing r0.xyzw.
+    fn dot_product_group() -> Vec<u8> {
+        let mut program = vec![
+            2,
+            (8 << 26) | (3 << 18),
+            0,
+            (0x28 << 23) | (1 << 21) | (3 << 9) | (2 << 6) | (1 << 3),
+        ];
+        for k in 0..4u32 {
+            program.push(1 | (k << 10) | (249 << 13) | if k == 3 { 1 << 31 } else { 0 });
+            program.push((0x50 << 7) | (1 << 4) | (3 << 5) | (k << 29));
+        }
+        words(&program)
+    }
