diff --git a/crates/mh3u-rt/src/cheats.rs b/crates/mh3u-rt/src/cheats.rs
new file mode 100644
index 0000000..ce4a35e
--- /dev/null
+++ b/crates/mh3u-rt/src/cheats.rs
@@ -0,0 +1,491 @@
+//! Cheats, opt-in: `MH3U_CHEATS=onehit=1000,sharp,money=10,items` (the launcher writes it from its Cheats section). Each cheat
+//! is one row of `CHEATS`: its id, the hooks it needs (names of `mods/hooks.txt`) and how to make the callback of each. To add a
+//! cheat: write its callback maker, add the row, add the hook to `mods/hooks.txt` and a row to the launcher's `CHEATS` list.
+//!
+//! The addresses are those of the update's executable (`docs/ghidra.md`), read with Ghidra:
+//! - `hit_resolve` is `f_02129ef4`, the function that resolves one hit: r4 = the target, r5 = the hit record, whose byte +6 is the
+//!   attacker's class (0 = a hunter, 1 = a monster, 2 = an object such as a shell, a trap or a rock), byte +7 the class of whoever
+//!   made that object, words +0x10 / +0x14 the attacker and the owner, and float +0x44 the base damage the function multiplies by
+//!   weapon and hit zone.
+//! - `sharp_change` is `f_0285f530(hunter, change, flag)`: adds `change` to the weapon's sharpness (negative: it wears).
+//! - `money_add` is `f_0219c720(_, change, &money)` and `item_to_pouch` is `f_0219aeac(save, item, count, ...)`: a negative count
+//!   is an item taken out; the two return addresses below are the calls of the function that uses an item in a quest.
+//!
+//! Every cheat writes to the log what it saw and what it did, the first times it acts and then now and then (`[cheats] ...`), so a
+//! log shows whether a cheat fires at all. `MH3U_CHEATS_PROBE=1` also watches what changes in the target of the monsters' hits
+//! (to find where a hunter's health is).
+
+use crate::guest::Guest;
+use crate::hooks::{Callback, Hook, Registry};
+use std::sync::atomic::{AtomicU32, Ordering::Relaxed};
+use std::sync::{Mutex, OnceLock};
+
+/// Hunter's hits (`hit_resolve`'s record, byte +6, or +7 for an object).
+const KIND_HUNTER: u8 = 0;
+/// Monster's hits.
+const KIND_MONSTER: u8 = 1;
+/// An object (shell, trap, rock...): the class of its maker is in byte +7.
+const KIND_OBJECT: u8 = 2;
+/// Where the base damage of a hit is in its record.
+const BASE_DAMAGE: u32 = 0x44;
+/// Return addresses of the two calls `f_0285ecd4` (use an item in a quest) makes to `item_to_pouch`.
+const ITEM_USE_RETURNS: [u32; 2] = [0x0285_ed6c, 0x0285_edac];
+
+/// How many times a cheat writes to the log when it acts, and then how often.
+const LOG_FIRST: u32 = 12;
+const LOG_EVERY: u32 = 250;
+
+/// Whether the cheat's `n`th action (counted from 0) goes to the log.
+fn should_log(n: u32) -> bool {
+    n < LOG_FIRST || (n + 1).is_multiple_of(LOG_EVERY)
+}
+
+struct Cheat {
+    id: &'static str,
+    /// The hooks it needs and what runs on each; the maker gets the cheat's value (the multiplier, if it has one).
+    hooks: &'static [(&'static str, fn(f32) -> Callback)],
+    /// The value when `MH3U_CHEATS` does not give one.
+    default: f32,
+}
+
+/// Every cheat. An id not in this list is reported and ignored.
+const CHEATS: &[Cheat] = &[
+    // "One Hit Kill": the hunter's hits do `value` times the damage
+    Cheat {
+        id: "onehit",
+        hooks: &[("hit_resolve", one_hit_kill)],
+        default: 1000.0,
+    },
+    // infinite sharpness: the weapon never wears
+    Cheat {
+        id: "sharp",
+        hooks: &[("sharp_change", infinite_sharpness)],
+        default: 1.0,
+    },
+    // more zenny: every gain of zenny is `value` times bigger
+    Cheat {
+        id: "money",
+        hooks: &[("money_add", more_zenny)],
+        default: 10.0,
+    },
+    // infinite items: the items used in a quest are not taken out of the pouch
+    Cheat {
+        id: "items",
+        hooks: &[("item_to_pouch", infinite_items)],
+        default: 1.0,
+    },
+    // read-only: the life of the monsters of the quest, on the overlay (`combat.rs`)
+    Cheat {
+        id: "monsterhp",
+        hooks: &[("monster_init", monster_life)],
+        default: 1.0,
+    },
+    // read-only: the damage the monsters' life goes down by, and the DPS of the hunter's own hits (`combat.rs`)
+    Cheat {
+        id: "dmgmeter",
+        hooks: &[("monster_init", damage_meter_monsters), ("hit_resolve", damage_meter_hits)],
+        default: 1.0,
+    },
+];
+
+/// `MH3U_CHEATS` as (id, value): `onehit=1000,sharp` is [("onehit", Some(1000.0)), ("sharp", None)]. Bad pieces are left out.
+fn parse(spec: &str) -> Vec<(String, Option<f32>)> {
+    spec.split(',')
+        .filter_map(|piece| {
+            let piece = piece.trim();
+            let (id, value) = match piece.split_once('=') {
+                Some((id, v)) => (id.trim(), Some(v.trim().parse::<f32>().ok().filter(|v| v.is_finite() && *v >= 1.0)?)),
+                None => (piece, None),
+            };
+            (!id.is_empty()).then(|| (id.to_ascii_lowercase(), value))
+        })
+        .collect()
+}
+
+/// Registers the callbacks of the cheats `MH3U_CHEATS` asks for; gives how many cheats are on.
+pub fn register(r: &mut Registry) -> usize {
+    // the probe goes first, so it sees a hit's record as the game made it, before a cheat changes it
+    if probing() && r.on("hit_resolve", Box::new(probe_hit)) {
+        eprintln!("[cheats] probe on: the target of each monster hit is compared with how it was at the one before");
+    }
+    let Ok(spec) = std::env::var("MH3U_CHEATS") else { return 0 };
+    let mut on = 0;
+    for (id, value) in parse(&spec) {
+        let Some(cheat) = CHEATS.iter().find(|c| c.id == id) else {
+            eprintln!("[cheats] unknown cheat `{id}` (MH3U_CHEATS), left out");
+            continue;
+        };
+        let value = value.unwrap_or(cheat.default);
+        let mut missing = Vec::new();
+        for (hook, make) in cheat.hooks {
+            if !r.on(hook, make(value)) {
+                missing.push(*hook);
+            }
+        }
+        if missing.is_empty() {
+            on += 1;
+            eprintln!("[cheats] {id} on (value {value})");
+        } else {
+            eprintln!("[cheats] {id} needs the hook(s) {missing:?}: build the game again with the launcher's current mods/hooks.txt");
+        }
+    }
+    on
+}
+
+/// Said when the game has no hooks at all (it was translated without a hooks list): the cheats cannot work then.
+pub fn no_hooks_warning() {
+    if std::env::var("MH3U_CHEATS").is_ok_and(|v| !v.trim().is_empty()) {
+        eprintln!(
+            "[cheats] cheats are on but this build of the game has no hooks, so none can work: build the game again with a launcher that has mods/hooks.txt"
+        );
+    }
+}
+
+/// The class of whoever a hit is from: the attacker's, or, for an object, its maker's.
+fn attacker(g: &Guest, record: u32) -> u8 {
+    match g.u8(record + 6) {
+        KIND_OBJECT => g.u8(record + 7),
+        kind => kind,
+    }
+}
+
+/// Whether the target of a hit is what made it (a hunter's own explosion): such hits are left alone.
+fn self_hit(g: &Guest, record: u32, target: u32) -> bool {
+    target != 0 && (g.u32(record + 0x10) == target || g.u32(record + 0x14) == target)
+}
+
+/// The most the cheat makes of a hit's base damage. The game works the final damage out from it (zone, sharpness, affinity...) and keeps
+/// it in 16 bits: a bowgun shot with base 27 made 27 000, went over, and did NO damage; 10 000 (what a sword's 10 became) kills the same.
+const MOST_BASE: f32 = 10_000.0;
+
+/// The base damage with the multiplier on, never above [`MOST_BASE`] (and never below what the hit had).
+fn multiplied(damage: f32, times: f32) -> f32 {
+    (damage * times).min(MOST_BASE).max(damage)
+}
+
+fn one_hit_kill(times: f32) -> Callback {
+    let acted = AtomicU32::new(0);
+    Box::new(move |h: &mut Hook| {
+        let (target, record) = (h.ctx.r[4], h.ctx.r[5]);
+        let g = Guest::new(h.ctx.mem);
+        if record == 0 || attacker(&g, record) != KIND_HUNTER || self_hit(&g, record, target) {
+            return;
+        }
+        let damage = f32::from_bits(g.u32(record + BASE_DAMAGE));
+        if damage > 0.0 {
+            let more = multiplied(damage, times);
+            g.put_u32(record + BASE_DAMAGE, more.to_bits());
+            let n = acted.fetch_add(1, Relaxed);
+            if should_log(n) {
+                eprintln!("[cheats] onehit: hit {} on {target:#x}, base damage {damage} -> {more}", n + 1);
+            }
+        }
+    })
+}
+
+/// The life of the monsters on the overlay.
+fn monster_life(_: f32) -> Callback {
+    crate::combat::enable_life();
+    crate::combat::monster_init()
+}
+
+/// The damage meter needs to know the monsters, and which hits are the hunter's own.
+fn damage_meter_monsters(_: f32) -> Callback {
+    crate::combat::enable_meter();
+    crate::combat::monster_init()
+}
+
+fn damage_meter_hits(_: f32) -> Callback {
+    crate::combat::mark_own_hits()
+}
+
+fn infinite_sharpness(_: f32) -> Callback {
+    let acted = AtomicU32::new(0);
+    let seen = AtomicU32::new(0);
+    Box::new(move |h: &mut Hook| {
+        // r4 = the change: only the wear (negative) is dropped; sharpening goes on
+        let change = h.ctx.r[4] as i32;
+        if change < 0 {
+            h.ctx.r[4] = 0;
+            let n = acted.fetch_add(1, Relaxed);
+            if should_log(n) {
+                eprintln!("[cheats] sharp: wear {change} dropped (flag {}, lr {:#x}), time {}", h.ctx.r[5], h.ctx.lr, n + 1);
+            }
+        } else {
+            let n = seen.fetch_add(1, Relaxed);
+            if n < 3 {
+                eprintln!("[cheats] sharp: change {change} kept (sharpening)");
+            }
+        }
+    })
+}
+
+/// The zenny a gain of `change` becomes with the multiplier (a loss, or nothing, stays as it is).
+fn zenny(change: i32, times: f32) -> i32 {
+    if change <= 0 {
+        return change;
+    }
+    (f64::from(change) * f64::from(times)).min(f64::from(i32::MAX)) as i32
+}
+
+fn more_zenny(times: f32) -> Callback {
+    let seen = AtomicU32::new(0);
+    Box::new(move |h: &mut Hook| {
+        let change = h.ctx.r[4] as i32;
+        let more = zenny(change, times);
+        h.ctx.r[4] = more as u32;
+        let n = seen.fetch_add(1, Relaxed);
+        if should_log(n) {
+            if more == change {
+                eprintln!("[cheats] money: change {change} left as it is (lr {:#x})", h.ctx.lr);
+            } else {
+                eprintln!("[cheats] money: gain {change} -> {more} (lr {:#x}, money at {:#x})", h.ctx.lr, h.ctx.r[5]);
+            }
+        }
+    })
+}
+
+/// Whether `item_to_pouch(.., count)` called from `lr` is an item used in a quest.
+fn item_used(lr: u32, count: u32) -> bool {
+    ITEM_USE_RETURNS.contains(&lr) && (count as i32) < 0
+}
+
+fn infinite_items(_: f32) -> Callback {
+    let acted = AtomicU32::new(0);
+    let others = AtomicU32::new(0);
+    Box::new(move |h: &mut Hook| {
+        if item_used(h.ctx.lr, h.ctx.r[5]) {
+            let n = acted.fetch_add(1, Relaxed);
+            if should_log(n) {
+                eprintln!("[cheats] items: item {:#x} used, {} taken out dropped (lr {:#x})", h.ctx.r[4], h.ctx.r[5] as i32, h.ctx.lr);
+            }
+            h.ctx.r[5] = 0;
+        } else if (h.ctx.r[5] as i32) < 0 {
+            // an item taken out from somewhere else (a shop, the box, a craft): stays, said a few times
+            let n = others.fetch_add(1, Relaxed);
+            if n < 5 {
+                eprintln!("[cheats] items: {} taken out from lr {:#x} is not an item used in a quest, kept", h.ctx.r[5] as i32, h.ctx.lr);
+            }
+        }
+        // a take-out of an item `item_used` does not know would be another caller of the use function: the log of the
+        // quest's last item use tells it
+    })
+}
+
+// ---- the probe: where is a hunter's health? ----
+
+fn probing() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("MH3U_CHEATS_PROBE").is_ok_and(|v| v.trim() == "1"))
+}
+
+/// What was in a stretch of the target's memory when a monster's hit began.
+struct Region {
+    base: u32,
+    bytes: Vec<u8>,
+}
+
+/// The target of the last monster hit and what its memory held then.
+static LAST: Mutex<Option<(u32, Vec<Region>)>> = Mutex::new(None);
+static DIFFS: AtomicU32 = AtomicU32::new(0);
+static HITS: AtomicU32 = AtomicU32::new(0);
+
+/// How much of a target object is kept, and how much of the data its +0xe30 points to.
+const TARGET_BYTES: usize = 0x2800;
+const DATA_BYTES: usize = 0x1400;
+
+fn plausible(address: u32) -> bool {
+    (0x0200_0000..0xB000_0000).contains(&address)
+}
+
+fn read_region(g: &Guest, base: u32, len: usize) -> Region {
+    let mut bytes = vec![0u8; len];
+    g.read(base, &mut bytes);
+    Region { base, bytes }
+}
+
+/// Runs first on every hit. Compares the target of the last monster hit with how it was then (16-bit values that went down by
+/// 1 to 1000, where a health that took the hit would show), and keeps the target of this one if a monster made it.
+fn probe_hit(h: &mut Hook) {
+    let (target, record) = (h.ctx.r[4], h.ctx.r[5]);
+    let g = Guest::new(h.ctx.mem);
+    let mut last = LAST.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some((before_target, regions)) = last.take() {
+        let n = DIFFS.fetch_add(1, Relaxed);
+        if n < 25 {
+            let mut lines = 0;
+            for r in &regions {
+                let now = read_region(&g, r.base, r.bytes.len());
+                for off in (0..r.bytes.len() - 1).step_by(2) {
+                    let old = u16::from_be_bytes([r.bytes[off], r.bytes[off + 1]]);
+                    let new = u16::from_be_bytes([now.bytes[off], now.bytes[off + 1]]);
+                    if new < old && old - new <= 1000 && old <= 5000 && lines < 80 {
+                        eprintln!("[cheats probe] change {} (target {before_target:#x}) {:#x}+{off:#x}: {old} -> {new}", n + 1, r.base);
+                        lines += 1;
+                    }
+                }
+            }
+            if lines == 0 {
+                eprintln!("[cheats probe] change {} (target {before_target:#x}): nothing went down", n + 1);
+            }
+        }
+    }
+    if record != 0 && plausible(target) && attacker(&g, record) == KIND_MONSTER {
+        let n = HITS.fetch_add(1, Relaxed);
+        if n < 25 {
+            let words: Vec<String> = (0..0x1cu32).map(|i| format!("{:08x}", g.u32(record + 4 * i))).collect();
+            eprintln!("[cheats probe] monster hit {} on {target:#x}, record: {}", n + 1, words.join(" "));
+            let mut regions = vec![read_region(&g, target, TARGET_BYTES)];
+            let data = g.u32(target + 0xe30);
+            if plausible(data) {
+                regions.push(read_region(&g, data, DATA_BYTES));
+            }
+            *last = Some((target, regions));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::BTreeMap;
+
+    #[test]
+    fn the_multiplied_damage_stays_under_the_most_the_game_keeps() {
+        assert_eq!(multiplied(10.0, 1000.0), 10_000.0, "a sword's hit as before");
+        assert_eq!(multiplied(7.0, 1000.0), 7_000.0);
+        assert_eq!(multiplied(27.0, 1000.0), MOST_BASE, "a bowgun shot would have gone over 16 bits and done nothing");
+        assert_eq!(multiplied(20_000.0, 1000.0), 20_000.0, "a hit already above is left as it is");
+        assert_eq!(multiplied(5.0, 2.0), 10.0);
+    }
+
+    #[test]
+    fn the_spec_is_read_piece_by_piece() {
+        assert_eq!(
+            parse("onehit=1000, sharp ,MONEY=2.5,bad=x,=3,,items"),
+            vec![
+                ("onehit".to_string(), Some(1000.0)),
+                ("sharp".to_string(), None),
+                ("money".to_string(), Some(2.5)),
+                ("items".to_string(), None)
+            ]
+        );
+        // a multiplier under 1 or not a number would turn the cheat into a penalty: the piece is left out
+        assert!(parse("onehit=0,money=-5,items=nan").is_empty());
+    }
+
+    #[test]
+    fn zenny_grows_only_when_it_is_a_gain_and_never_overflows() {
+        assert_eq!(zenny(310, 10.0), 3100);
+        assert_eq!(zenny(-200, 10.0), -200);
+        assert_eq!(zenny(0, 10.0), 0);
+        assert_eq!(zenny(i32::MAX, 1000.0), i32::MAX);
+    }
+
+    #[test]
+    fn only_an_item_used_in_a_quest_is_not_taken_out() {
+        assert!(item_used(0x0285_edac, u32::MAX));
+        assert!(item_used(0x0285_ed6c, (-3i32) as u32));
+        assert!(!item_used(0x0285_edac, 2), "a gain stays");
+        assert!(!item_used(0x021d_397c, u32::MAX), "taking items out in a shop or the box stays");
+    }
+
+    #[test]
+    fn the_log_says_the_first_actions_and_then_now_and_then() {
+        assert!((0..LOG_FIRST).all(should_log));
+        assert!(!should_log(LOG_FIRST));
+        assert!(should_log(LOG_EVERY - 1));
+        assert!(!should_log(LOG_EVERY));
+    }
+
+    /// A hit record at `at`: attacker class `kind`, maker class `owner`, base damage `damage`.
+    fn hit(g: &Guest, at: u32, kind: u8, owner: u8, damage: f32) {
+        g.put_u8(at + 6, kind);
+        g.put_u8(at + 7, owner);
+        g.put_u32(at + BASE_DAMAGE, damage.to_bits());
+    }
+
+    fn damage(g: &Guest, at: u32) -> f32 {
+        f32::from_bits(g.u32(at + BASE_DAMAGE))
+    }
+
+    #[test]
+    fn an_object_hit_counts_for_whoever_made_the_object() {
+        let mut m = vec![0u8; 0x400];
+        let g = Guest::new(m.as_mut_ptr());
+        hit(&g, 0x100, KIND_OBJECT, KIND_HUNTER, 5.0);
+        assert_eq!(attacker(&g, 0x100), KIND_HUNTER, "a shell or a bomb of a hunter");
+        hit(&g, 0x100, KIND_OBJECT, KIND_MONSTER, 5.0);
+        assert_eq!(attacker(&g, 0x100), KIND_MONSTER, "a rock a monster threw");
+        hit(&g, 0x100, KIND_MONSTER, KIND_HUNTER, 5.0);
+        assert_eq!(attacker(&g, 0x100), KIND_MONSTER, "+7 matters only for an object");
+    }
+
+    #[test]
+    fn a_hit_on_the_one_that_made_it_is_a_self_hit() {
+        let mut m = vec![0u8; 0x400];
+        let g = Guest::new(m.as_mut_ptr());
+        g.put_u32(0x100 + 0x10, 0x2000);
+        g.put_u32(0x100 + 0x14, 0x3000);
+        assert!(self_hit(&g, 0x100, 0x2000));
+        assert!(self_hit(&g, 0x100, 0x3000));
+        assert!(!self_hit(&g, 0x100, 0x4000));
+        assert!(!self_hit(&g, 0x100, 0), "no target is nobody's self-hit");
+    }
+
+    /// The cheats that change the game on the hooks they name, run through a registry like the game's.
+    #[test]
+    fn each_cheat_changes_what_it_should_on_its_hook() {
+        let list: BTreeMap<u32, String> = [
+            (0x0212_9ef4, "hit_resolve".to_string()),
+            (0x0259_fc98, "monster_init".to_string()),
+            (0x0285_f530, "sharp_change".to_string()),
+            (0x0219_c720, "money_add".to_string()),
+            (0x0219_aeac, "item_to_pouch".to_string()),
+        ]
+        .into();
+        let mut r = Registry::new(&list);
+        for c in CHEATS {
+            // the two read-only helpers read the game's player tables, which this small test memory does not have
+            if matches!(c.id, "monsterhp" | "dmgmeter") {
+                continue;
+            }
+            for (hook, make) in c.hooks {
+                assert!(r.on(hook, make(if c.id == "onehit" { 1000.0 } else { 3.0 })), "{} is in the list", hook);
+            }
+        }
+        let mut m = vec![0u8; 0x400];
+        let g = Guest::new(m.as_mut_ptr());
+        let mut ctx = crate::game::new_ctx(m.as_mut_ptr());
+        ctx.r[4] = 0x300; // the target of the hits
+        ctx.r[5] = 0x100;
+        // the hunter's hit, base damage 10
+        hit(&g, 0x100, KIND_HUNTER, 0, 10.0);
+        r.run(0x0212_9ef4, &mut ctx);
+        assert_eq!(damage(&g, 0x100), 10_000.0);
+        // a hunter's own shell that hits the hunter is left as it is
+        hit(&g, 0x100, KIND_OBJECT, KIND_HUNTER, 10.0);
+        g.put_u32(0x100 + 0x14, 0x300);
+        r.run(0x0212_9ef4, &mut ctx);
+        assert_eq!(damage(&g, 0x100), 10.0, "self-hit");
+        g.put_u32(0x100 + 0x14, 0x500);
+        r.run(0x0212_9ef4, &mut ctx);
+        assert_eq!(damage(&g, 0x100), 10_000.0, "a hunter's shell on a monster");
+        // sharpness: wear dropped, sharpening kept
+        ctx.r[4] = (-2i32) as u32;
+        r.run(0x0285_f530, &mut ctx);
+        assert_eq!(ctx.r[4], 0);
+        ctx.r[4] = 5;
+        r.run(0x0285_f530, &mut ctx);
+        assert_eq!(ctx.r[4], 5);
+        // zenny: a gain x3
+        ctx.r[4] = 100;
+        r.run(0x0219_c720, &mut ctx);
+        assert_eq!(ctx.r[4], 300);
+        // items: used in a quest, not taken out
+        ctx.lr = 0x0285_edac;
+        ctx.r[5] = u32::MAX;
+        r.run(0x0219_aeac, &mut ctx);
+        assert_eq!(ctx.r[5], 0);
+    }
+}
