+/// Where the player dragged the monsters' life panel and the damage panel to: the top-right corner of each, as a fraction of the screen
+/// (so it keeps its place when the window changes size). `None` is the default place, the top-right corner of the screen.
+#[derive(Clone, Copy, Default, Debug, PartialEq)]
+struct HudLayout {
+    life: Option<(f32, f32)>,
+    meter: Option<(f32, f32)>,
+}
+
+impl HudLayout {
+    fn parse(text: &str) -> HudLayout {
+        let mut layout = HudLayout::default();
+        for line in text.lines() {
+            let Some((key, value)) = line.split_once('=') else { continue };
+            let mut numbers = value.split(',').map(|n| n.trim().parse::<f32>().ok().filter(|n| n.is_finite()));
+            let (Some(Some(x)), Some(Some(y))) = (numbers.next(), numbers.next()) else { continue };
+            let place = Some((x.clamp(0.0, 1.0), y.clamp(0.0, 1.0)));
+            match key.trim() {
+                "life" => layout.life = place,
+                "meter" => layout.meter = place,
+                _ => {}
+            }
+        }
+        layout
+    }
+
+    fn to_text(self) -> String {
+        let line = |key: &str, v: Option<(f32, f32)>| v.map(|(x, y)| format!("{key}={x:.4},{y:.4}\n")).unwrap_or_default();
+        line("life", self.life) + &line("meter", self.meter)
+    }
+
+    fn load(path: &Path) -> HudLayout {
+        std::fs::read_to_string(path).map(|t| HudLayout::parse(&t)).unwrap_or_default()
+    }
+
+    fn save(self, path: &Path) {
+        let _ = if self == HudLayout::default() { std::fs::remove_file(path) } else { std::fs::write(path, self.to_text()) };
+    }
+}
