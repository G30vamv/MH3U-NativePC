+];
+
+/// The name of the monster with this id in the language asked for (`spanish`), or "Monster NNN" / "Monstruo NNN" when the game has none.
+pub fn name(id: u8, spanish: bool) -> String {
+    match NAMES.get(id as usize) {
+        Some(&(en, es)) if !en.is_empty() => (if spanish { es } else { en }).to_string(),
+        _ => format!("{} {:03}", if spanish { "Monstruo" } else { "Monster" }, id),
+    }
+}
+
+/// Whether the kind is a small monster (a Jaggi, a Felyne, a Kelbi, a rock...): the others are the large monsters of a quest.
+pub fn is_small(id: u8) -> bool {
+    matches!(id, 10 | 11 | 13 | 17 | 21..=23 | 26..=40 | 48..=50 | 76..=84)
+}
+
+#[cfg(test)]
