+//! Read-only combat information for the overlay: the life of the monsters of a quest and what the hunter has done to them.
+//!
+//! The monsters are found when the game sets their life at spawn (the hook `monster_init`, `uEnemy::initMaxHp` 0x0259fc98, r3 = the
+//! monster). Their state is `*(monster + 0x1be0)` (the game's own table of debug properties names the fields, see `docs/ghidra.md`):
+//! `+0x8b8` is the life now and `+0x8bc` the most it has (`hp_vital` and `max_hp_vital`, 32-bit), `+2` its id (`em_id`).
+//!
+//! At each frame swap (`mods::on_frame`, with the baton) the monsters are read: what a monster's life went down by is damage dealt;
+//! it counts as the hunter's own when one of the hunter's hits was resolved a moment before (`hit_resolve` marks them). Nothing is
+//! written to the game. The overlay draws what [`snapshot`] gives.
+
+use crate::guest::Guest;
+use crate::hooks::{Callback, Hook};
+use std::collections::VecDeque;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering::Relaxed};
+use std::sync::{Arc, Mutex};
+
+/// `sPlayer`'s and `sGame`'s instance pointers; the players table is at `sPlayer + 0x40` (8 pointers) and the local player's number
+/// at `sGame + 0x4b`.
+const PLAYER_SINGLETON: u32 = 0x1031_4b80;
+const GAME_SINGLETON: u32 = 0x101f_db9c;
+/// Where the hunter's own state is in a hunter (`hunter + 0xe30`) is not needed here; the monster's state is.
+const MONSTER_STATE: u32 = 0x1be0;
+const HP_NOW: u32 = 0x8b8;
+const HP_MAX: u32 = 0x8bc;
+const EM_ID: u32 = 2;
+/// Another reader of the same structure finds the id one byte further (`+3`, with a 1 in `+4`) and the monsters' names came out
+/// wrong with `+2` (a small monster with a large one's name): the diagnostic line of `on_frame` shows the bytes, `monster_id` picks.
+const EM_ID_ALT: u32 = 3;
+
+/// The most monsters followed at once.
+const MOST_MONSTERS: usize = 24;
+/// Frames after one of the hunter's hits in which a fall of a monster's life is counted as the hunter's.
+const OWN_FRAMES: u64 = 3;
+/// The seconds the DPS looks back over.
+const WINDOW_SECS: f32 = 5.0;
+
+static LIFE_ON: AtomicBool = AtomicBool::new(false);
+static METER_ON: AtomicBool = AtomicBool::new(false);
+/// The frame (`crate::FRAMES`) of the last hit of the hunter's own.
+static OWN_HIT: AtomicU64 = AtomicU64::new(0);
+
+/// The life bars are on (the cheat `monsterhp`).
+pub fn enable_life() {
+    LIFE_ON.store(true, Relaxed);
+}
+
+/// The damage meter is on (the cheat `dmgmeter`).
+pub fn enable_meter() {
+    METER_ON.store(true, Relaxed);
+}
+
+/// Whether anything of this is on (the overlay draws only then).
+pub fn enabled() -> bool {
+    LIFE_ON.load(Relaxed) || METER_ON.load(Relaxed) || cfg!(test) && ENABLED_FOR_TEST.load(Relaxed)
+}
+
+/// Lets the tests turn the counters on without the cheats.
+#[allow(dead_code)]
+static ENABLED_FOR_TEST: AtomicBool = AtomicBool::new(false);
+
+/// One monster as of the last frame.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Monster {
+    pub address: u32,
+    /// The game's number for the kind of monster (`em_id`).
+    pub id: u8,
+    pub hp: i32,
+    pub max: i32,
+}
+
+/// What the overlay draws.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Snapshot {
+    pub monsters: Vec<Monster>,
+    /// Damage the monsters' life went down by since the counters began: all of it, and the part after the hunter's own hits.
+    pub dealt: i64,
+    pub dealt_own: i64,
+    /// Damage a second over the last [`WINDOW_SECS`] seconds (the hunter's own), and the mean since the first hit.
+    pub dps: f32,
+    pub dps_mean: f32,
+    pub life_on: bool,
+    pub meter_on: bool,
+}
+
+struct State {
+    /// The monsters, with the life each had at the last frame (-1: not read yet).
+    monsters: Vec<(u32, i32)>,
+    /// (seconds since the start, damage, the hunter's own) of each fall of life, newest last.
+    falls: VecDeque<(f32, i32, bool)>,
+    dealt: i64,
+    dealt_own: i64,
+    first_hit: Option<f32>,
+    last_hit: f32,
+    started: std::time::Instant,
+    snapshot: Arc<Snapshot>,
+}
+
+static STATE: Mutex<Option<State>> = Mutex::new(None);
+
+fn with_state<R>(f: impl FnOnce(&mut State) -> R) -> R {
+    let mut s = STATE.lock().unwrap_or_else(|e| e.into_inner());
+    f(s.get_or_insert_with(|| State {
+        monsters: Vec::new(),
+        falls: VecDeque::new(),
+        dealt: 0,
+        dealt_own: 0,
+        first_hit: None,
+        last_hit: 0.0,
+        started: std::time::Instant::now(),
+        snapshot: Arc::new(Snapshot::default()),
+    }))
+}
+
+/// A monster began to exist: it is followed from now on. The counters start again when no monster was left.
+pub fn add_monster(address: u32) {
+    with_state(|s| {
+        if s.monsters.iter().any(|m| m.0 == address) {
+            return;
+        }
+        if s.monsters.is_empty() {
+            s.falls.clear();
+            s.dealt = 0;
+            s.dealt_own = 0;
+            s.first_hit = None;
+        }
+        if s.monsters.len() >= MOST_MONSTERS {
+            s.monsters.remove(0);
+        }
+        s.monsters.push((address, -1));
+    });
+}
+
+/// Starts the counters again (what the overlay's button does).
+pub fn reset() {
+    with_state(|s| {
+        s.falls.clear();
+        s.dealt = 0;
+        s.dealt_own = 0;
+        s.first_hit = None;
+    });
+}
+
+/// What the overlay shows now.
+pub fn snapshot() -> Arc<Snapshot> {
+    with_state(|s| s.snapshot.clone())
+}
+
+/// The hunter that plays here (the game's player table, entry `sGame + 0x4b`), or 0.
+pub fn local_hunter(g: &Guest) -> u32 {
+    let (players, game) = (g.u32(PLAYER_SINGLETON), g.u32(GAME_SINGLETON));
+    if players == 0 || game == 0 {
+        return 0;
+    }
+    let number = g.u8(game + 0x4b);
+    if number >= 8 {
+        return 0;
+    }
+    let hunter = g.u32(players + 0x40 + 4 * u32::from(number));
+    // the game checks the same top bits of the object's flags before it trusts an entry
+    if hunter != 0 && matches!(g.u32(hunter + 0xc) >> 29, 1 | 2) { hunter } else { 0 }
+}
+
+/// Whether the address can hold a monster the game made.
+fn plausible(address: u32) -> bool {
+    (0x1000_0000..0x5000_0000).contains(&address) && address.is_multiple_of(4)
+}
+
+/// The life of the monster at `address` as (id, now, most), or none if it is not a monster that exists.
+pub fn read_monster(g: &Guest, address: u32) -> Option<(u8, i32, i32)> {
+    if !plausible(address) || !matches!(g.u32(address + 0xc) >> 29, 1 | 2) {
+        return None;
+    }
+    let state = g.u32(address + MONSTER_STATE);
+    if !plausible(state) {
+        return None;
+    }
+    let (now, max) = (g.u32(state + HP_NOW) as i32, g.u32(state + HP_MAX) as i32);
+    (max > 0 && max <= 5_000_000 && (0..=max).contains(&now)).then(|| (monster_id(g, state), now, max))
+}
+
+/// The kind of monster whose state is at `state`: the byte at `+3` when a 1 follows it (the layout the other reader describes),
+/// else the byte at `+2`.
+fn monster_id(g: &Guest, state: u32) -> u8 {
+    let alt = g.u8(state + EM_ID_ALT);
+    if g.u8(state + EM_ID_ALT + 1) == 1 && (1..=85).contains(&alt) { alt } else { g.u8(state + EM_ID) }
+}
+
+/// At each frame swap: reads the monsters and counts what their life went down by. Does nothing when nothing of this is on.
+pub(crate) fn on_frame(g: &Guest) {
+    if !enabled() {
+        return;
+    }
+    let frame = crate::FRAMES.load(Relaxed);
+    let own = frame.wrapping_sub(OWN_HIT.load(Relaxed)) <= OWN_FRAMES;
+    with_state(|s| {
+        let now_s = s.started.elapsed().as_secs_f32();
+        let mut list = Vec::with_capacity(s.monsters.len());
+        let mut kept = Vec::with_capacity(s.monsters.len());
+        for &(address, before) in &s.monsters {
+            let Some((id, hp, max)) = read_monster(g, address) else {
+                // gone (or not ready yet): dropped once it has been seen to exist, kept while it has not been read at all
+                if before >= 0 {
+                    continue;
+                }
+                kept.push((address, before));
+                continue;
+            };
+            if before < 0 {
+                // the first time this monster is read: the bytes where its id may be, to settle which one is (the next test shows it)
+                let state = g.u32(address + MONSTER_STATE);
+                let b: Vec<String> = (0..8).map(|i| format!("{:02x}", g.u8(state + i))).collect();
+                eprintln!(
+                    "[combat] monster {address:#x} state {state:#x} bytes +0..+7 {}, size float +0xa0 {:#x} +0xa4 {:#x}; life {hp}/{max}, id used {id}",
+                    b.join(" "),
+                    g.u32(state + 0xa0),
+                    g.u32(state + 0xa4)
+                );
+            }
+            if before > hp {
+                let fall = before - hp;
+                s.dealt += i64::from(fall);
+                if own {
+                    s.dealt_own += i64::from(fall);
+                }
+                s.falls.push_back((now_s, fall, own));
+                s.first_hit.get_or_insert(now_s);
+                s.last_hit = now_s;
+            }
+            kept.push((address, hp));
+            list.push(Monster { address, id, hp, max });
+        }
+        s.monsters = kept;
+        while s.falls.front().is_some_and(|f| now_s - f.0 > 60.0) {
+            s.falls.pop_front();
+        }
+        let in_window: i64 = s.falls.iter().filter(|f| f.2 && now_s - f.0 <= WINDOW_SECS).map(|f| i64::from(f.1)).sum();
+        let mean = s.first_hit.map_or(0.0, |t| {
+            // the time from the first hit to the last, at least a second so a single hit does not give a huge number
+            s.dealt_own as f32 / (s.last_hit - t).max(1.0)
+        });
+        s.snapshot = Arc::new(Snapshot {
+            monsters: list,
+            dealt: s.dealt,
+            dealt_own: s.dealt_own,
+            dps: in_window as f32 / WINDOW_SECS,
+            dps_mean: mean,
+            life_on: LIFE_ON.load(Relaxed),
+            meter_on: METER_ON.load(Relaxed),
+        });
+    });
+}
+
+/// The callback of `monster_init`: r3 is the monster.
+pub fn monster_init() -> Callback {
+    Box::new(|h: &mut Hook| {
+        let monster = h.ctx.r[3];
+        if plausible(monster) {
+            add_monster(monster);
+            if h.calls < 12 {
+                eprintln!("[combat] monster {monster:#x} appeared (call {})", h.calls + 1);
+            }
+        }
+    })
+}
+
+/// Whether the hit record `record` was made by the hunter at `hunter` (its own hit, or an object it made).
+pub fn own_hit(g: &Guest, record: u32, hunter: u32) -> bool {
+    if hunter == 0 || record == 0 {
+        return false;
+    }
+    match g.u8(record + 6) {
+        0 => g.u32(record + 0x10) == hunter,
+        // an object (a shell, a bomb): its maker's class is in +7 and the owner in +0x14
+        2 => g.u8(record + 7) == 0 && g.u32(record + 0x14) == hunter,
+        _ => false,
+    }
+}
+
+/// The callback of `hit_resolve` for the meter: marks the frame of each of the hunter's own hits.
+pub fn mark_own_hits() -> Callback {
+    Box::new(|h: &mut Hook| {
+        let record = h.ctx.r[5];
+        let g = Guest::new(h.ctx.mem);
+        if own_hit(&g, record, local_hunter(&g)) {
+            OWN_HIT.store(crate::FRAMES.load(Relaxed), Relaxed);
+        }
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The tests share the one state, so they take turns.
+    static TURN: Mutex<()> = Mutex::new(());
+
+    /// A monster at 0x2000_0000 whose state (0x2000_1000) holds a life of `hp` out of `max`, in a guest memory of its own.
+    fn put_monster(g: &Guest, hp: i32, max: i32) {
+        let (monster, state) = (0x2000_0000u32, 0x2000_1000u32);
+        g.put_u32(monster + 0xc, 1 << 29);
+        g.put_u32(monster + MONSTER_STATE, state);
+        g.put_u32(state + HP_NOW, hp as u32);
+        g.put_u32(state + HP_MAX, max as u32);
+        g.put_u8(state + EM_ID, 25);
+    }
+
+    #[test]
+    fn a_monsters_life_is_read_through_its_state() {
+        let mut memory = crate::memory::GuestMemory::reserve().unwrap();
+        let g = Guest::new(memory.as_mut_ptr());
+        assert_eq!(read_monster(&g, 0x2000_0000), None, "nothing there");
+        put_monster(&g, 1800, 2000);
+        assert_eq!(read_monster(&g, 0x2000_0000), Some((25, 1800, 2000)));
+        // a life above the most, or the -1 the game puts in at a reset, is not a life
+        put_monster(&g, 2500, 2000);
+        assert_eq!(read_monster(&g, 0x2000_0000), None);
+        put_monster(&g, -1, 2000);
+        assert_eq!(read_monster(&g, 0x2000_0000), None);
+        // a monster that is gone (its flags' top bits are not alive) is not read
+        put_monster(&g, 10, 2000);
+        g.put_u32(0x2000_0000 + 0xc, 0);
+        assert_eq!(read_monster(&g, 0x2000_0000), None);
+        assert!(!plausible(0x0000_1000), "code and low memory are not monsters");
+        assert!(!plausible(0x2000_0002), "not aligned");
+    }
+
+    #[test]
+    fn the_id_is_the_byte_before_a_one_when_there_is_one_and_the_plain_byte_otherwise() {
+        let mut memory = crate::memory::GuestMemory::reserve().unwrap();
+        let g = Guest::new(memory.as_mut_ptr());
+        put_monster(&g, 1800, 2000);
+        let state = g.u32(0x2000_0000 + MONSTER_STATE);
+        // the layout where the id is at +3 with a 1 at +4 (a Great Jaggi, 12)
+        g.put_u8(state + 3, 12);
+        g.put_u8(state + 4, 1);
+        assert_eq!(monster_id(&g, state), 12);
+        // no 1 after it, or a number that is no monster: the byte at +2 (25 in `put_monster`)
+        g.put_u8(state + 4, 0);
+        assert_eq!(monster_id(&g, state), 25);
+        g.put_u8(state + 3, 200);
+        g.put_u8(state + 4, 1);
+        assert_eq!(monster_id(&g, state), 25);
+    }
+
+    #[test]
+    fn what_a_monsters_life_goes_down_by_is_damage_and_the_hunters_own_after_its_hits() {
+        let _turn = TURN.lock().unwrap_or_else(|e| e.into_inner());
+        let mut memory = crate::memory::GuestMemory::reserve().unwrap();
+        let g = Guest::new(memory.as_mut_ptr());
+        ENABLED_FOR_TEST.store(true, Relaxed);
+        reset();
+        with_state(|s| s.monsters.clear());
+        put_monster(&g, 2000, 2000);
+        add_monster(0x2000_0000);
+        on_frame(&g);
+        assert_eq!(snapshot().monsters, vec![Monster { address: 0x2000_0000, id: 25, hp: 2000, max: 2000 }]);
+        // the life falls with a hit of the hunter's own a moment before
+        OWN_HIT.store(crate::FRAMES.load(Relaxed), Relaxed);
+        put_monster(&g, 1700, 2000);
+        on_frame(&g);
+        let s = snapshot();
+        assert_eq!((s.dealt, s.dealt_own), (300, 300));
+        assert!(s.dps > 0.0 && s.dps_mean > 0.0);
+        // a fall long after it is not the hunter's
+        OWN_HIT.store(crate::FRAMES.load(Relaxed).wrapping_sub(100), Relaxed);
+        put_monster(&g, 1600, 2000);
+        on_frame(&g);
+        let s = snapshot();
+        assert_eq!((s.dealt, s.dealt_own), (400, 300));
+        // a healed monster is not damage
+        put_monster(&g, 1900, 2000);
+        on_frame(&g);
+        assert_eq!(snapshot().dealt, 400);
+        reset();
+        with_state(|s| s.monsters.clear());
+        ENABLED_FOR_TEST.store(false, Relaxed);
+    }
+
+    #[test]
+    fn the_hunters_own_hits_are_told_from_the_others() {
+        let mut m = vec![0u8; 0x400];
+        let g = Guest::new(m.as_mut_ptr());
+        let (record, hunter) = (0x100u32, 0x2000u32);
+        g.put_u8(record + 6, 0);
+        g.put_u32(record + 0x10, hunter);
+        assert!(own_hit(&g, record, hunter));
+        assert!(!own_hit(&g, record, 0x3000), "another hunter's hit");
+        // an object the hunter made
+        g.put_u8(record + 6, 2);
+        g.put_u8(record + 7, 0);
+        g.put_u32(record + 0x14, hunter);
+        assert!(own_hit(&g, record, hunter));
+        g.put_u8(record + 7, 1);
+        assert!(!own_hit(&g, record, hunter), "an object a monster made");
+        // a monster's hit
+        g.put_u8(record + 6, 1);
+        assert!(!own_hit(&g, record, hunter));
+        assert!(!own_hit(&g, record, 0), "no hunter, no own hit");
+    }
+
+    #[test]
+    fn counters_start_again_with_the_first_monster_after_none_were_left() {
+        let _turn = TURN.lock().unwrap_or_else(|e| e.into_inner());
+        reset();
+        add_monster(0x2000_0000);
+        with_state(|s| {
+            s.dealt = 500;
+            s.monsters.clear();
+        });
+        add_monster(0x2000_4000);
+        with_state(|s| {
+            assert_eq!(s.dealt, 0, "a new quest starts from zero");
+            assert_eq!(s.monsters.len(), 1);
+        });
+        // the same monster twice is followed once
+        add_monster(0x2000_4000);
+        with_state(|s| assert_eq!(s.monsters.len(), 1));
+        with_state(|s| s.monsters.clear());
+    }
+}
