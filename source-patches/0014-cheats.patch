+    #[test]
+    fn small_and_large_monsters_are_told_apart() {
+        assert!(is_small(10), "Jaggi");
+        assert!(is_small(30), "Felyne");
+        assert!(is_small(40), "rock");
+        assert!(!is_small(12), "Great Jaggi");
+        assert!(!is_small(2), "Rathalos");
+        assert!(!is_small(74), "Brachydios");
+    }
+
+    #[test]
+    fn known_ids_have_their_names_in_both_languages() {
+        assert_eq!(name(2, false), "Rathalos");
+        assert_eq!(name(12, false), "Great Jaggi");
+        assert_eq!(name(12, true), "Gran Jaggi");
+        assert_eq!(name(74, false), "Brachydios");
+    }
+
+    #[test]
+    fn unknown_ids_keep_a_number() {
+        assert_eq!(name(0, true), "Monstruo 000");
+        assert_eq!(name(200, false), "Monster 200");
+    }
+}
