 //!   in the game), and after it how the next frames went (the slowest, the mean, the pipelines, the shaders and the textures).
 
 use crate::pipelines::PipelineCounts;
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering};
 use std::time::{Duration, Instant};
 
+/// How long the GPU took to finish a frame's work after the queue had it all (microseconds): the sum, the longest and how many frames,
+/// for the `[gfx gpu]` line. Not the GPU's own time for the frame (that needs timestamp queries): it also holds the wait behind earlier
+/// frames, so a GPU that keeps up shows a little more than one frame's work, and one that falls behind shows it growing.
+static LAG_SUM_US: AtomicU64 = AtomicU64::new(0);
+static LAG_MAX_US: AtomicU64 = AtomicU64::new(0);
+static LAG_FRAMES: AtomicU64 = AtomicU64::new(0);
+
+/// Called just before a frame is presented, with everything of the frame submitted: notes when the GPU has finished it.
+pub(crate) fn watch_gpu(queue: &wgpu::Queue) {
+    static ON: OnceLock<bool> = OnceLock::new();
+    if !*ON.get_or_init(|| std::env::var_os("MH3U_GFX_TIMES").is_some() || std::env::var_os("MH3U_FPS").is_some()) {
+        return;
+    }
+    let at = Instant::now();
+    queue.on_submitted_work_done(move || {
+        let us = at.elapsed().as_micros() as u64;
+        LAG_SUM_US.fetch_add(us, Ordering::Relaxed);
+        LAG_MAX_US.fetch_max(us, Ordering::Relaxed);
+        LAG_FRAMES.fetch_add(1, Ordering::Relaxed);
+    });
+}
+
+/// The `[gfx gpu]` line of the frames since the last one (and starts the next count).
+fn gpu_text() -> Option<String> {
+    let frames = LAG_FRAMES.swap(0, Ordering::Relaxed);
+    let (sum, max) = (LAG_SUM_US.swap(0, Ordering::Relaxed), LAG_MAX_US.swap(0, Ordering::Relaxed));
+    (frames > 0).then(|| {
+        format!(
+            "[gfx gpu] {frames} frames finished by the GPU: {:.2} ms on average after the queue had all their work, {:.2} ms at most",
+            sum as f64 / frames as f64 / 1000.0,
+            max as f64 / 1000.0
+        )
+    })
+}
