+/// The CPU time (kernel + user) each thread of this process has used so far: (thread id, its name if it has one, milliseconds).
+/// For the per-thread load of the timing reports. Windows only; threads that cannot be opened are left out.
+#[cfg(windows)]
+pub fn thread_cpu_times() -> Vec<(u32, String, f64)> {
+    use windows_sys::Win32::Foundation::{CloseHandle, FILETIME, INVALID_HANDLE_VALUE, LocalFree};
+    use windows_sys::Win32::System::Diagnostics::ToolHelp::{
+        CreateToolhelp32Snapshot, TH32CS_SNAPTHREAD, THREADENTRY32, Thread32First, Thread32Next,
+    };
+    use windows_sys::Win32::System::Threading::{
+        GetCurrentProcessId, GetThreadDescription, GetThreadTimes, OpenThread, THREAD_QUERY_LIMITED_INFORMATION,
+    };
+    let ticks = |t: FILETIME| (u64::from(t.dwHighDateTime) << 32 | u64::from(t.dwLowDateTime)) as f64 / 10_000.0;
+    let mut out = Vec::new();
+    // SAFETY: plain Win32 calls on handles opened here and closed before the end; the structs are filled in by the calls (`dwSize` is
+    // set as `Thread32First` asks), and the description buffer the system allocates is read within its terminating zero and freed.
+    unsafe {
+        let snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+        if snapshot == INVALID_HANDLE_VALUE {
+            return out;
+        }
+        let pid = GetCurrentProcessId();
+        let mut entry: THREADENTRY32 = std::mem::zeroed();
+        entry.dwSize = std::mem::size_of::<THREADENTRY32>() as u32;
+        let mut more = Thread32First(snapshot, &mut entry) != 0;
+        while more {
+            if entry.th32OwnerProcessID == pid {
+                let thread = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, 0, entry.th32ThreadID);
+                if !thread.is_null() {
+                    let zero = FILETIME {
+                        dwLowDateTime: 0,
+                        dwHighDateTime: 0,
+                    };
+                    let (mut created, mut exited, mut kernel, mut user) = (zero, zero, zero, zero);
+                    if GetThreadTimes(thread, &mut created, &mut exited, &mut kernel, &mut user) != 0 {
+                        let mut name = String::new();
+                        let mut text: *mut u16 = std::ptr::null_mut();
+                        if GetThreadDescription(thread, &mut text) >= 0 && !text.is_null() {
+                            let mut len = 0;
+                            while *text.add(len) != 0 {
+                                len += 1;
+                            }
+                            name = String::from_utf16_lossy(std::slice::from_raw_parts(text, len));
+                            LocalFree(text.cast());
+                        }
+                        out.push((entry.th32ThreadID, name, ticks(kernel) + ticks(user)));
+                    }
+                    CloseHandle(thread);
+                }
+            }
+            more = Thread32Next(snapshot, &mut entry) != 0;
+        }
+        CloseHandle(snapshot);
+    }
+    out
+}
+
+#[cfg(not(windows))]
+pub fn thread_cpu_times() -> Vec<(u32, String, f64)> {
+    Vec::new()
+}
