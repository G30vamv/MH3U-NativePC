+/// The `[gfx threads]` line: the CPU each thread used in the `secs` since `before`, as a percentage of one core, busiest first, leaving
+/// out those under 2 %. `now` and `before` are `mh3u_rt::thread_cpu_times` (a thread not in `before` is new: all of its time counts).
+pub(crate) fn threads_text(now: &[(u32, String, f64)], before: &std::collections::HashMap<u32, f64>, secs: f64) -> String {
+    let mut used: Vec<(f64, String)> = now
+        .iter()
+        .map(|(tid, name, ms)| {
+            let pct = (ms - before.get(tid).copied().unwrap_or(0.0)) / (secs * 10.0);
+            (
+                pct,
+                if name.is_empty() {
+                    format!("thread {tid}")
+                } else {
+                    format!("{name} ({tid})")
+                },
+            )
+        })
+        .collect();
+    let total: f64 = used.iter().map(|(p, _)| p).sum();
+    used.retain(|(p, _)| *p >= 2.0);
+    used.sort_by(|a, b| b.0.total_cmp(&a.0));
+    let list: Vec<String> = used.iter().map(|(p, n)| format!("{n} {p:.0}%")).collect();
+    format!(
+        "[gfx threads] {} threads, {total:.0}% of one core in all: {}",
+        now.len(),
+        list.join(", ")
+    )
 }
 
