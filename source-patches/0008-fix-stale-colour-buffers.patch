+    /// The colour buffer a draw samples when the texture `t` (a `GX2Texture`) points at `image`: the one the game drew into there,
+    /// unless the texture has another size than that buffer. Then the game put an ordinary texture (a leaf, say) in the memory the
+    /// buffer used before, and the buffer's old picture (a screen capture) must not be drawn on it.
+    pub(crate) fn sampled_target(&self, g: &Guest, t: u32, image: u32) -> Option<&crate::gx2::Target> {
+        let target = self.targets.get(&image)?;
+        let size = (g.u32(t + 4), g.u32(t + 8));
+        if t == 0 || target.guest_size == size {
+            return Some(target);
+        }
+        Lap::count("render targets not sampled: another texture in their memory", 1);
+        // said once for each buffer and texture size (the log shows when the game reused a buffer's memory)
+        static SAID: std::sync::Mutex<Vec<(u32, (u32, u32))>> = std::sync::Mutex::new(Vec::new());
+        if let Ok(mut said) = SAID.lock()
+            && said.len() < 64
+            && !said.contains(&(image, size))
+        {
+            said.push((image, size));
+            eprintln!(
+                "[gfx] the colour buffer at {image:#x} ({}x{}) is not drawn on a {}x{} texture read from the same memory",
+                target.guest_size.0, target.guest_size.1, size.0, size.1
+            );
+        }
+        None
+    }
