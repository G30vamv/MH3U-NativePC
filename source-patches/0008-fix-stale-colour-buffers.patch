+    #[test]
+    fn a_texture_in_the_memory_of_an_old_colour_buffer_is_not_replaced_by_the_buffer() {
+        let mut gx2 = Gx2::new(crate::Display::noop());
+        let image = 0xf561_e800;
+        let texture = gx2.d.device.create_texture(&wgpu::TextureDescriptor {
+            label: None,
+            size: wgpu::Extent3d {
+                width: 16,
+                height: 16,
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: wgpu::TextureFormat::Rgba8Unorm,
+            usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::RENDER_ATTACHMENT,
+            view_formats: &[],
+        });
+        let view = texture.create_view(&Default::default());
+        gx2.targets.insert(
+            image,
+            crate::gx2::Target {
+                texture,
+                format: wgpu::TextureFormat::Rgba8Unorm,
+                view,
+                guest_size: (1920, 1080),
+            },
+        );
+        let mut m = vec![0u8; 0x400];
+        let g = Guest::new(m.as_mut_ptr());
+        // a GX2Texture at 0x100 whose image is the buffer's memory: first the buffer itself (1920x1080), then a 256x256 leaf there
+        g.put_u32(0x124, image);
+        for (width, height, is_buffer) in [(1920u32, 1080u32, true), (256, 256, false), (1920, 540, false)] {
+            g.put_u32(0x104, width);
+            g.put_u32(0x108, height);
+            assert_eq!(gx2.sampled_target(&g, 0x100, image).is_some(), is_buffer, "{width}x{height}");
+        }
+        // nothing drawn into there: no buffer at all
+        assert!(gx2.sampled_target(&g, 0x100, image + 0x1000).is_none());
+        gx2.end_pass();
+    }
