+/// A moment the player marks as it happens (F8, or Share + R3 on a gamepad): one numbered line with the traffic of the window so far, so
+/// a stutter seen in a room can be found in the log by its time and numbers.
+pub fn mark(how: &str) {
+    static N: AtomicU32 = AtomicU32::new(0);
+    let n = N.fetch_add(1, Ordering::Relaxed) + 1;
+    eprintln!("[mark] #{n} ({how})");
+    let now = Instant::now();
+    let guard = P2P.lock().unwrap_or_else(|e| e.into_inner());
+    let secs = guard.0.map_or(0.0, |s| now.duration_since(s).as_secs_f32());
+    for (peer, st) in guard.1.iter() {
+        let silent = st.last_recv.map_or(0, |t| now.duration_since(t).as_millis().min(u128::from(u32::MAX)) as u32);
+        let silent_sent = st.last_sent.map_or(0, |t| now.duration_since(t).as_millis().min(u128::from(u32::MAX)) as u32);
+        eprintln!(
+            "[mark] #{n} {peer}: window so far {secs:.1} s: sent {}, received {}, gaps over 100 ms {} (longest {} ms, silent for {silent} ms), sent gaps over 100 ms {} (longest {} ms, silent for {silent_sent} ms)",
+            st.sent, st.recv, st.over_100, st.longest_ms, st.sent_over_100, st.sent_longest_ms
+        );
+    }
+}
