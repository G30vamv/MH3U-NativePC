+/// The number of the hunter of the host of a room (and of a hunter alone).
+const HOST_SLOT: u8 = 0;
+
+/// Whether the `hit_register` hook is in the game, so the host's meter is fed with the exact damage of each hit (set at start-up).
+static REGISTER_HITS: AtomicBool = AtomicBool::new(false);
+
+/// The `hit_register` hook is in this build: on the host the meter counts what each hit really does, hunter by hunter.
+pub fn use_register_hits() {
+    REGISTER_HITS.store(true, Relaxed);
+}
+
+/// Whether a line of the damage probe is written for its `n`th hit (counted from 0): the first ones all, then every fifth, then none.
+fn probe_line(n: u32) -> bool {
+    n < 150 || (n < 1500 && n % 5 == 0)
+}
+
+/// The damage probe (`[dmg]` lines, on host AND guest; `MH3U_DMG_PROBE=0` turns it off): first half, the callback of `hit_resolve` (it
+/// goes first, so it sees the record as the game made it, before One Hit Kill changes it): who is the attacker, the base damage, whether
+/// the target is a monster and its life. It changes nothing.
+pub fn damage_probe_resolve() -> Callback {
+    let count = AtomicU32::new(0);
+    Box::new(move |h: &mut Hook| {
+        let (target, record) = (h.ctx.r[4], h.ctx.r[5]);
+        if record == 0 {
+            return;
+        }
+        let g = Guest::new(h.ctx.mem);
+        // only the hunters' hits (or those of their objects): the monsters' are not what is measured
+        let Some(slot) = attacker_slot(&g, record) else { return };
+        let n = count.fetch_add(1, Relaxed);
+        if !probe_line(n) {
+            return;
+        }
+        let life = read_monster(&g, target).map(|(id, now, max)| format!("monster id {id} life {now}/{max}")).unwrap_or_else(|| "not a monster".into());
+        eprintln!(
+            "[dmg] resolve {}: hunter {slot}, this machine's {:?}, class {}/{}, base {:.1}, owner {:#x}/{:#x}, target {target:#x} ({life}), lr {:#x}",
+            n + 1,
+            local_slot(&g),
+            g.u8(record + 6),
+            g.u8(record + 7),
+            f32::from_bits(g.u32(record + 0x44)),
+            g.u32(record + 0x10),
+            g.u32(record + 0x14),
+            h.ctx.lr
+        );
+        if n < 4 {
+            let words: Vec<String> = (0..0x1cu32).map(|i| format!("{:08x}", g.u32(record + 4 * i))).collect();
+            eprintln!("[dmg] resolve {} record: {}", n + 1, words.join(" "));
+        }
+    })
+}
+
+/// Second half, the callback of `hit_register` (`f_025c824c`, which `hit_resolve` calls at the end of a hit that landed on a monster to
+/// register it: its registers are said raw, since which is which is what is being found out: the monster, the kind, the hunter's number,
+/// the final damage). Says too the life of the monster, so the next line shows what the hit took.
+pub fn damage_probe_register(log: bool) -> Callback {
+    let count = AtomicU32::new(0);
+    Box::new(move |h: &mut Hook| {
+        let n = count.fetch_add(1, Relaxed);
+        let g = Guest::new(h.ctx.mem);
+        let r = &h.ctx.r;
+        // the host (or a hunter alone) resolves every hit of the room: r4 0 = a hit on a monster, r5 = the hunter, r6 = the damage it does
+        if REGISTER_HITS.load(Relaxed) && r[4] == 0 && r[6] as i32 > 0 && r[5] < SLOTS as u32 {
+            let local = local_slot(&g);
+            if local == Some(HOST_SLOT) && read_monster(&g, r[3]).is_some() {
+                note_hit_on(r[5] as u8, (r[6] as i32) as f32, local, r[3]);
+            }
+        }
+        if !log || !probe_line(n) {
+            return;
+        }
+        let life = [r[3], r[4]]
+            .iter()
+            .find_map(|&m| read_monster(&g, m).map(|(id, now, max)| format!("monster {m:#x} id {id} life {now}/{max}")))
+            .unwrap_or_else(|| "no monster in r3/r4".into());
+        eprintln!(
+            "[dmg] register {}: r3 {:#x} r4 {:#x} r5 {:#x} r6 {:#x} ({}) r7 {:#x} r8 {:#x}; {life}; this machine's {:?}; lr {:#x}",
+            n + 1,
+            r[3],
+            r[4],
+            r[5],
+            r[6],
+            r[6] as i32,
+            r[7],
+            r[8],
+            local_slot(&g),
+            h.ctx.lr
+        );
+    })
+}
