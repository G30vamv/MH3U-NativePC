+//! A copy of the guest's memory that the draws are worked out from, kept by messages in order.
+//!
+//! The thread that works out the draws (`front.rs`) must read what the game's thread wrote, but the game's thread goes on and rewrites
+//! it. So the game's thread copies what a draw is going to read into the messages it sends (`Updates`), and the other thread applies
+//! them, in the order they were sent, to a second 4 GiB address space of its own (`Back`): when it works out a draw, that memory holds
+//! what the game's had when the draw was made. A page is copied the first time a draw reads it and again only after `GX2Invalidate`
+//! covers it: the game announces what its code writes for the GPU to read (the read log found no write that was not announced in the
+//! village and the house, see `PerformanceUpdate.md`).
+
+use mh3u_rt::{Guest, GuestMemory};
+use std::sync::{Arc, Mutex};
+
+const PAGES: usize = 1 << 20;
+/// Slots of the table of what was copied in the current stretch.
+const DONE: usize = 8192;
+const PAGE: u32 = 4096;
+
+/// Pages to put in the copy: runs of (first page, pages), and their bytes one after the other.
+#[derive(Default)]
+pub(crate) struct Updates {
+    pub runs: Vec<(u32, u32)>,
+    pub data: Vec<u8>,
+    /// Exact ranges (address, bytes) that go in after the pages, their bytes in `fresh_data`: for what changes without being announced.
+    pub fresh: Vec<(u32, u32)>,
+    pub fresh_data: Vec<u8>,
+}
+
+impl Updates {
+    fn is_empty(&self) -> bool {
+        self.runs.is_empty() && self.fresh.is_empty()
+    }
+
+    fn clear(&mut self) {
+        self.runs.clear();
+        self.data.clear();
+        self.fresh.clear();
+        self.fresh_data.clear();
+    }
+}
+
+/// Updates the other thread has applied, given back with their buffers: making a message's buffers anew (and the pages they are written
+/// into, which the system has to give zeroed) for each of the thousands of messages a frame cost more than copying what they carry.
+#[derive(Clone, Default)]
+pub(crate) struct Pool(Arc<Mutex<Vec<Box<Updates>>>>);
+
+impl Pool {
+    /// How many are kept: more than the messages in flight at once, which the channel and the frames ahead bound.
+    const KEPT: usize = 4096;
+
+    fn get(&self) -> Box<Updates> {
+        self.0.lock().unwrap().pop().unwrap_or_default()
+    }
+
+    pub(crate) fn give(&self, mut u: Box<Updates>) {
+        u.clear();
+        // a buffer that grew far beyond what messages usually carry is let go rather than kept
+        if u.data.capacity() > 8 << 20 || u.fresh_data.capacity() > 8 << 20 {
+            return;
+        }
+        let mut kept = self.0.lock().unwrap();
+        if kept.len() < Self::KEPT {
+            kept.push(u);
+        }
+    }
+}
+
+/// The game's thread's side: which pages the other thread's copy holds up to date.
+pub(crate) struct Front {
+    valid: Vec<u64>,
+    /// The pages copied for shaders (what a blanket shader invalidation drops).
+    tagged: Vec<u64>,
+    /// The same pages as a list, so that dropping them does not walk the whole table.
+    tagged_pages: Vec<u32>,
+    pending: Box<Updates>,
+    pool: Pool,
+    /// What the game's code has done since: bumped each time the game calls into the graphics, since its code runs between those calls and
+    /// may write anything. Within one stretch (a display list played back, whose draws follow each other with no game code between) the
+    /// memory does not change, so an exact range copied once in it need not be copied again.
+    epoch: u32,
+    /// The last (address, bytes, stretch) copied, by a hash of the first two: a collision only means copying once more.
+    done: Vec<(u32, u32, u32)>,
+    /// Bytes copied, for the report.
+    pub copied: u64,
+}
+
+impl Front {
+    pub(crate) fn new() -> Front {
+        Front {
+            valid: vec![0; PAGES / 64],
+            tagged: vec![0; PAGES / 64],
+            tagged_pages: Vec::new(),
+            pending: Box::default(),
+            pool: Pool::default(),
+            epoch: 1,
+            done: vec![(0, 0, 0); DONE],
+            copied: 0,
+        }
+    }
+
+    /// The game's code may have run since the last copy: copies made before no longer stand for the memory.
+    pub(crate) fn new_stretch(&mut self) {
+        self.epoch = self.epoch.wrapping_add(1).max(1);
+    }
+
+    /// Where the other thread gives the updates back.
+    pub(crate) fn pool(&self) -> Pool {
+        self.pool.clone()
+    }
+
+    /// Makes sure the copy will hold the `len` bytes at `address` as they are now.
+    pub(crate) fn ensure(&mut self, g: &Guest, address: u32, len: u32, tag: bool) {
+        if len == 0 {
+            return;
+        }
+        let first = (address / PAGE) as usize;
+        let last = (((u64::from(address) + u64::from(len) - 1) / u64::from(PAGE)) as usize).min(PAGES - 1);
+        let mut page = first;
+        while page <= last {
+            let (word, bit) = (page / 64, page % 64);
+            if bit == 0 && self.valid[word] == u64::MAX && page + 63 <= last && !tag {
+                page += 64;
+                continue;
+            }
+            if tag && self.tagged[word] >> bit & 1 == 0 {
+                self.tagged[word] |= 1 << bit;
+                self.tagged_pages.push(page as u32);
+            }
+            if self.valid[word] >> bit & 1 == 0 {
+                self.valid[word] |= 1 << bit;
+                g.with_bytes((page as u32) << 12, PAGE as usize, |raw| self.pending.data.extend_from_slice(raw));
+                self.copied += u64::from(PAGE);
+                match self.pending.runs.last_mut() {
+                    Some((start, n)) if (*start + *n) as usize == page => *n += 1,
+                    _ => self.pending.runs.push((page as u32, 1)),
+                }
+            }
+            page += 1;
+        }
+    }
+
+    /// Copies the `len` bytes at `address` as they are now, whatever the copy holds: for structures the game changes without saying so.
+    pub(crate) fn fresh(&mut self, g: &Guest, address: u32, len: u32) {
+        if len == 0 {
+            return;
+        }
+        let slot = ((address.wrapping_mul(0x9E37_79B1) ^ len.wrapping_mul(0x85EB_CA6B)) >> 19) as usize % DONE;
+        if self.done[slot] == (address, len, self.epoch) {
+            return;
+        }
+        self.done[slot] = (address, len, self.epoch);
+        g.with_bytes(address, len as usize, |raw| self.pending.fresh_data.extend_from_slice(raw));
+        self.pending.fresh.push((address, len));
+        self.copied += u64::from(len);
+    }
+
+    /// The game announced it wrote `size` bytes at `address`: the pages are copied again when next wanted.
+    pub(crate) fn invalidate(&mut self, address: u32, size: u32) {
+        let first = (address / PAGE) as usize;
+        let last = (((u64::from(address) + u64::from(size.max(1)) - 1) / u64::from(PAGE)) as usize).min(PAGES - 1);
+        for page in first..=last {
+            self.valid[page / 64] &= !(1 << (page % 64));
+        }
+    }
+
+    /// A blanket invalidation of shaders (the whole address space, which says nothing of where): the pages copied for shaders are
+    /// copied again when next wanted.
+    pub(crate) fn invalidate_shaders(&mut self) {
+        for page in self.tagged_pages.drain(..) {
+            let (word, bit) = (page as usize / 64, page % 64);
+            self.valid[word] &= !(1 << bit);
+            self.tagged[word] &= !(1 << bit);
+        }
+    }
+
+    /// What is to go with the next message.
+    pub(crate) fn take(&mut self) -> Option<Box<Updates>> {
+        if self.pending.is_empty() {
+            return None;
+        }
+        let next = self.pool.get();
+        Some(std::mem::replace(&mut self.pending, next))
+    }
+}
+
+/// The other thread's side: the copy itself.
+pub(crate) struct Back {
+    memory: GuestMemory,
+}
+
+impl Back {
+    pub(crate) fn new() -> anyhow::Result<Back> {
+        Ok(Back {
+            memory: GuestMemory::reserve()?,
+        })
+    }
+
+    pub(crate) fn guest(&mut self) -> Guest {
+        Guest::new(self.memory.as_mut_ptr())
+    }
+
+    pub(crate) fn apply(&mut self, u: &Updates) {
+        let g = self.guest();
+        let mut at = 0usize;
+        for &(first, pages) in &u.runs {
+            let len = pages as usize * PAGE as usize;
+            g.write(first << 12, &u.data[at..at + len]);
+            at += len;
+        }
+        let mut at = 0usize;
+        for &(address, len) in &u.fresh {
+            g.write(address, &u.fresh_data[at..at + len as usize]);
+            at += len as usize;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pages_are_copied_once_until_invalidated_and_arrive_in_order() {
+        let mut game = GuestMemory::reserve().unwrap();
+        let live = Guest::new(game.as_mut_ptr());
+        let mut front = Front::new();
+        let mut back = Back::new().unwrap();
+        live.put_u32(0x1000_0004, 0x1111);
+        live.put_u32(0x1000_1008, 0x2222);
+        front.ensure(&live, 0x1000_0000, 0x1800, false);
+        let first = front.take().expect("two pages");
+        assert_eq!(first.runs, [(0x10000, 2)]);
+        // nothing new until something is invalidated
+        front.ensure(&live, 0x1000_0000, 0x1800, false);
+        assert!(front.take().is_none());
+        // the game writes and announces it; the page is sent again, and only that one
+        live.put_u32(0x1000_1008, 0x3333);
+        front.invalidate(0x1000_1000, 8);
+        front.ensure(&live, 0x1000_0000, 0x1800, false);
+        let second = front.take().expect("one page");
+        assert_eq!(second.runs, [(0x10001, 1)]);
+        // the back sees what the game had at each step, in order
+        let copy = back.guest();
+        back.apply(&first);
+        assert_eq!((copy.u32(0x1000_0004), copy.u32(0x1000_1008)), (0x1111, 0x2222));
+        back.apply(&second);
+        assert_eq!((copy.u32(0x1000_0004), copy.u32(0x1000_1008)), (0x1111, 0x3333));
+    }
+
+    #[test]
+    fn an_exact_range_is_copied_once_in_a_stretch_and_again_in_the_next() {
+        let mut game = GuestMemory::reserve().unwrap();
+        let live = Guest::new(game.as_mut_ptr());
+        let mut front = Front::new();
+        live.put_u32(0x1000_0000, 7);
+        front.fresh(&live, 0x1000_0000, 16);
+        front.fresh(&live, 0x1000_0000, 16);
+        // another length at the same address is another range
+        front.fresh(&live, 0x1000_0000, 8);
+        let first = front.take().expect("copies");
+        assert_eq!(first.fresh, [(0x1000_0000, 16), (0x1000_0000, 8)], "the repeat was left out");
+        // the game's code runs between calls: what it may have written has to be copied again
+        live.put_u32(0x1000_0000, 9);
+        front.new_stretch();
+        front.fresh(&live, 0x1000_0000, 16);
+        let second = front.take().expect("copied again");
+        assert_eq!(second.fresh, [(0x1000_0000, 16)]);
+        assert_eq!(&second.fresh_data[..4], &9u32.to_be_bytes());
+    }
+
+    #[test]
+    fn a_blanket_shader_invalidation_drops_only_the_pages_copied_for_shaders() {
+        let mut game = GuestMemory::reserve().unwrap();
+        let live = Guest::new(game.as_mut_ptr());
+        let mut front = Front::new();
+        front.ensure(&live, 0x2000_0000, 0x1000, true);
+        front.ensure(&live, 0x2000_1000, 0x1000, false);
+        assert_eq!(front.take().expect("two pages").runs, [(0x20000, 2)]);
+        front.invalidate_shaders();
+        front.ensure(&live, 0x2000_0000, 0x2000, false);
+        // the shader page comes again, the other (not a shader's) stays as it was
+        assert_eq!(front.take().expect("one page").runs, [(0x20000, 1)]);
+        // and a page not copied for shaders is not dropped later either
+        front.invalidate_shaders();
+        front.ensure(&live, 0x2000_0000, 0x2000, false);
+        assert!(front.take().is_none());
+    }
+
+    #[test]
+    fn updates_given_back_come_out_empty_and_are_used_again() {
+        let pool = Pool::default();
+        let mut u = Box::<Updates>::default();
+        u.runs.push((1, 1));
+        u.data.extend_from_slice(&[1; 4096]);
+        u.fresh.push((4, 4));
+        u.fresh_data.extend_from_slice(&[2; 4]);
+        pool.give(u);
+        let again = pool.get();
+        assert!(again.is_empty() && again.data.is_empty() && again.fresh_data.is_empty());
+        assert!(again.data.capacity() >= 4096, "the buffer is kept");
+    }
+}
