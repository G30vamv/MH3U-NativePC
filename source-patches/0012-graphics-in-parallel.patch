diff --git a/crates/mh3u-gfx/src/reads.rs b/crates/mh3u-gfx/src/reads.rs
new file mode 100644
index 0000000..e0b2327
--- /dev/null
+++ b/crates/mh3u-gfx/src/reads.rs
@@ -0,0 +1,162 @@
+//! A measuring aid (`MH3U_GFX_READLOG=1`): which parts of the guest's memory each draw reads while its resources are worked out, sorted
+//! by what the draw's state says they are (the shaders' structures, the textures', the vertex buffers, the uniform blocks...). It tells
+//! what a copy of "everything a draw reads" would hold and what it would cost, for moving that work to another thread.
+
+use crate::state::State;
+use mh3u_rt::Guest;
+use std::collections::HashMap;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+/// A mirror of the pages the draws read, to check whether `GX2Invalidate` is enough to know when they changed: a page is copied the
+/// first time it is read and dropped when an invalidation covers it; a later read whose bytes differ from the copy is a write the game
+/// did not announce.
+static MIRROR: Mutex<Option<HashMap<u32, Box<[u8; 4096]>>>> = Mutex::new(None);
+static STALE: [AtomicU64; 13] = [const { AtomicU64::new(0) }; 13];
+static STALE_BYTES: [AtomicU64; 13] = [const { AtomicU64::new(0) }; 13];
+static FIRST: [AtomicU64; 13] = [const { AtomicU64::new(0) }; 13];
+static CHECKED: [AtomicU64; 13] = [const { AtomicU64::new(0) }; 13];
+
+/// An invalidation of `size` bytes at `address`: the mirror forgets those pages.
+pub(crate) fn invalidated(address: u32, size: u32) {
+    if let Some(m) = MIRROR.lock().unwrap().as_mut() {
+        let first = address >> 12;
+        let last = (u64::from(address) + u64::from(size.max(1)) - 1) >> 12;
+        if last - u64::from(first) > 4096 {
+            m.retain(|&p, _| p < first || u64::from(p) > last);
+        } else {
+            for p in first..=(last as u32) {
+                m.remove(&p);
+            }
+        }
+    }
+}
+
+fn check(g: &Guest, category: usize, address: u32, len: u32) {
+    let mut guard = MIRROR.lock().unwrap();
+    let m = guard.get_or_insert_with(HashMap::new);
+    let end = u64::from(address) + u64::from(len.max(1));
+    let mut page = address >> 12;
+    while u64::from(page) << 12 < end {
+        let (from, to) = (address.max(page << 12), (end.min((u64::from(page) + 1) << 12)) as u32);
+        let (a, n) = (from, (to - from) as usize);
+        let mut live = vec![0u8; n];
+        g.read_unlogged(a, &mut live);
+        match m.get(&page) {
+            Some(copy) => {
+                CHECKED[category].fetch_add(n as u64, Ordering::Relaxed);
+                let off = (a & 0xfff) as usize;
+                if copy[off..off + n] != live[..] {
+                    STALE[category].fetch_add(1, Ordering::Relaxed);
+                    STALE_BYTES[category].fetch_add(n as u64, Ordering::Relaxed);
+                    // what the game changed is what the draw reads now
+                    let mut whole = Box::new([0u8; 4096]);
+                    g.read_unlogged(page << 12, &mut whole[..]);
+                    m.insert(page, whole);
+                }
+            }
+            None => {
+                FIRST[category].fetch_add(1, Ordering::Relaxed);
+                let mut whole = Box::new([0u8; 4096]);
+                g.read_unlogged(page << 12, &mut whole[..]);
+                m.insert(page, whole);
+            }
+        }
+        page += 1;
+    }
+}
+
+const NAMES: [&str; 13] = [
+    "vertex shader struct",
+    "pixel shader struct",
+    "geometry shader struct",
+    "fetch shader",
+    "texture structs",
+    "sampler structs",
+    "colour buffer structs",
+    "depth buffer struct",
+    "vertex buffers",
+    "uniform blocks",
+    "index buffer",
+    "other (reached by pointer)",
+    "state-less reads",
+];
+
+static CALLS: [AtomicU64; 13] = [const { AtomicU64::new(0) }; 13];
+static BYTES: [AtomicU64; 13] = [const { AtomicU64::new(0) }; 13];
+static DRAWS: AtomicU64 = AtomicU64::new(0);
+/// The biggest "other" read of the window, to see what it is.
+static BIGGEST: AtomicU64 = AtomicU64::new(0);
+
+pub(crate) fn enabled() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("MH3U_GFX_READLOG").is_some())
+}
+
+/// Sorts the reads of one draw by what they are.
+pub(crate) fn note(g: &Guest, st: &State, indexed: Option<(u32, u32)>, count: u32, reads: &[(u32, u32)]) {
+    let mut regions: Vec<(usize, u32, u32)> = vec![
+        (0, st.vertex_shader, 0x140),
+        (1, st.pixel_shader, 0xe8),
+        (2, st.geometry_shader, 0x140),
+        (3, st.fetch_shader, 0x40),
+        (7, st.depth_buffer, 0x80),
+    ];
+    regions.extend(st.pixel_textures.iter().map(|&a| (4, a, 0x100)));
+    regions.extend(st.pixel_samplers.iter().map(|&a| (5, a, 0x10)));
+    regions.extend(st.colour_buffers.iter().map(|&a| (6, a, 0x80)));
+    regions.extend(st.attrib_buffers.iter().map(|b| (8, b.address, b.size)));
+    for blocks in [&st.vertex_blocks, &st.pixel_blocks, &st.geometry_blocks] {
+        regions.extend(blocks.iter().map(|b| (9, b.address, b.size)));
+    }
+    if let Some((kind, address)) = indexed {
+        let width = if matches!(kind, 1 | 9) { 4 } else { 2 };
+        regions.push((10, address, count.saturating_mul(width)));
+    }
+    DRAWS.fetch_add(1, Ordering::Relaxed);
+    for &(address, len) in reads {
+        let category = regions
+            .iter()
+            .find(|&&(_, start, size)| start != 0 && address >= start && address - start < size.max(1))
+            .map_or(11, |r| r.0);
+        check(g, category, address, len);
+        CALLS[category].fetch_add(1, Ordering::Relaxed);
+        BYTES[category].fetch_add(u64::from(len), Ordering::Relaxed);
+        if category == 11 {
+            BIGGEST.fetch_max(u64::from(len), Ordering::Relaxed);
+        }
+    }
+}
+
+/// The `[gfx reads]` lines of the draws since the last call.
+pub(crate) fn text(frames: u64) -> Vec<String> {
+    let draws = DRAWS.swap(0, Ordering::Relaxed);
+    if draws == 0 {
+        return Vec::new();
+    }
+    let per = frames.max(1) as f64;
+    let mut out = vec![format!("[gfx reads] {draws} draws ({:.0} a frame); per frame: reads, bytes", draws as f64 / per)];
+    let mut total = 0;
+    for i in 0..13 {
+        let (c, b) = (CALLS[i].swap(0, Ordering::Relaxed), BYTES[i].swap(0, Ordering::Relaxed));
+        total += b;
+        if c > 0 {
+            out.push(format!(
+                "[gfx reads]   {:28} {:8.0} reads {:10.0} bytes; mirror: {} pages first seen, {} bytes compared, {} reads found changed without an invalidation ({} bytes)",
+                NAMES[i],
+                c as f64 / per,
+                b as f64 / per,
+                FIRST[i].swap(0, Ordering::Relaxed),
+                CHECKED[i].swap(0, Ordering::Relaxed),
+                STALE[i].swap(0, Ordering::Relaxed),
+                STALE_BYTES[i].swap(0, Ordering::Relaxed)
+            ));
+        }
+    }
+    out.push(format!(
+        "[gfx reads]   total {:.0} bytes a frame; biggest single read reached by pointer {} bytes",
+        total as f64 / per,
+        BIGGEST.swap(0, Ordering::Relaxed)
+    ));
+    out
+}
