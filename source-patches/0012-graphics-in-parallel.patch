diff --git a/crates/mh3u-gfx/src/front.rs b/crates/mh3u-gfx/src/front.rs
new file mode 100644
index 0000000..24c1d71
--- /dev/null
+++ b/crates/mh3u-gfx/src/front.rs
@@ -0,0 +1,854 @@
+//! Working out the draws on a thread of their own.
+//!
+//! The game's thread used to do everything a GX2 call asks for: read the shaders, textures and vertices out of the guest's memory, make or
+//! find the GPU resources for them, and record the draw. Most of that is not the game's business, so here the game's thread (`Front`)
+//! only does what the game has to see at once, and hands the rest, call by call and in order, to a thread that owns the graphics
+//! (`Gx2`). What a draw reads from the guest's memory is copied into the messages (`mirror.rs`), so the other thread sees it as the
+//! game left it, not as the game's code, which has gone on, has rewritten it since.
+//!
+//! `MH3U_GFX_RESOLVER`: `thread` (the default here), `sync` (the same work on the game's thread, through the same copy: for comparing),
+//! `check` (`sync`, and every read of the guest's memory is compared with the memory itself: a difference is something a draw read that
+//! was not copied in time), `off` (no front: the graphics work on the game's thread as before).
+
+use crate::draw::{AttribStream, attribute_size};
+use crate::gx2::{Call, Gx2, Recorded, Recording, Seen, apply_state_call, init_fetch_shader, is_immediate};
+use crate::mirror;
+use crate::state::{State, arg, farg};
+use mh3u_rt::{AssertSend, Ctx, Guest, Gx2Backend};
+use crate::fxmap::HashMap;
+use std::sync::mpsc::{Receiver, SyncSender, sync_channel};
+use std::sync::{Arc, Condvar, Mutex};
+use std::time::{Duration, Instant};
+
+/// How many frames the game's thread may be ahead of the one drawing (`MH3U_GFX_FRAMES_AHEAD` changes it, for measuring).
+const FRAMES_AHEAD: u32 = 2;
+const FRAME: Duration = Duration::from_nanos(16_683_333);
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum Mode {
+    Off,
+    Sync,
+    Check,
+    Thread,
+}
+
+/// The mode asked for in `MH3U_GFX_RESOLVER`, if it says one.
+pub fn mode_from_env() -> Option<Mode> {
+    match std::env::var("MH3U_GFX_RESOLVER").unwrap_or_default().trim().to_ascii_lowercase().as_str() {
+        "off" | "0" | "no" | "false" => Some(Mode::Off),
+        "sync" => Some(Mode::Sync),
+        "check" => Some(Mode::Check),
+        "thread" | "on" | "1" | "yes" | "true" => Some(Mode::Thread),
+        _ => None,
+    }
+}
+
+/// Without a setting, only NVIDIA cards get the thread: on an integrated AMD card (limited by the GPU, not the CPU) it measured slower,
+/// and the other makes are not measured yet.
+fn default_mode(vendor: u32) -> Mode {
+    if vendor == 0x10de { Mode::Thread } else { Mode::Off }
+}
+
+/// What the thread that draws is sent.
+enum Msg {
+    /// Messages sent together (a message sent by itself wakes the other thread, which costs more than the call it carries).
+    Batch(Vec<Msg>),
+    /// A context to take the calls' registers from.
+    Init(Box<SendCtx>),
+    Call {
+        updates: Option<Box<mirror::Updates>>,
+        rec: Recorded,
+    },
+    FetchShader {
+        updates: Option<Box<mirror::Updates>>,
+        shader: u32,
+        streams: Arc<[AttribStream]>,
+    },
+}
+
+// the context's pointer to the guest's memory is not used by the graphics, which take their registers from it only
+type SendCtx = AssertSend<Ctx>;
+
+/// How many frames are waiting for the thread that draws.
+type Pending = Arc<(Mutex<u32>, Condvar)>;
+
+enum Back {
+    Inline {
+        gx2: Box<Gx2>,
+        memory: mirror::Back,
+        ctx: Option<SendCtx>,
+        check: bool,
+    },
+    Thread {
+        tx: SyncSender<Msg>,
+        pending: Pending,
+        batch: Vec<Msg>,
+    },
+}
+
+/// How many messages go in a batch at most.
+const BATCH: usize = 256;
+
+/// Vertices and indices up to this size are copied as they are at each draw (exact bytes); bigger ones would go by pages. Every size is
+/// copied as it is for now: the game writes vertex data for the GPU without announcing it.
+const SMALL: u32 = u32::MAX;
+
+pub struct Front {
+    back: Back,
+    contexts: HashMap<u32, State>,
+    current: u32,
+    recording: Option<Recording>,
+    lists: HashMap<u32, Arc<[Recorded]>>,
+    /// The buffer lists are recorded into, kept between lists so it is not grown from nothing for each (a list is thousands of calls).
+    scratch_calls: Vec<Recorded>,
+    fetch: HashMap<u32, Arc<[AttribStream]>>,
+    mirror: mirror::Front,
+    /// The registers calls are applied through (a copy of the game's, made at the first call).
+    scratch: Option<SendCtx>,
+    swaps: u32,
+    interval: u32,
+    next_vsync: Instant,
+    mismatches: u64,
+    inval_bytes: u64,
+    inval_calls: u64,
+    draws: u64,
+    spans_seen: u64,
+    inval_biggest: (u32, u32, u32),
+    /// Bytes copied by the kind of thing (see `CATEGORIES`), and the time capturing, since the last report.
+    by_kind: [u64; 8],
+    /// The image addresses of the colour and depth buffers the game drew into: a texture there is a render target (the graphics sample
+    /// it from the GPU), so its memory is not read.
+    targets: std::collections::HashSet<u32>,
+    capture: Duration,
+    frames_reported: u32,
+    /// Times of the game's thread's share, for the report (only with `MH3U_GFX_FRONT_TIMES`: reading the clock for each call costs a good part of what is measured).
+    timing: bool,
+    tm: Times,
+    ahead: u32,
+    batch_size: usize,
+}
+
+#[derive(Default)]
+struct Times {
+    /// all of `run` (every GX2 call), the state calls' share, the sending, the waits (limiter, vsync), calls seen
+    run: Duration,
+    state: Duration,
+    forward: Duration,
+    wait: Duration,
+    record: Duration,
+    calls: u64,
+}
+
+/// The backend for the game: `gx2` as it is (`Off`), or behind a front.
+pub fn backend(gx2: Gx2, mode: Option<Mode>) -> Box<dyn Gx2Backend> {
+    let mode = mode.unwrap_or_else(|| default_mode(gx2.vendor()));
+    if mode == Mode::Off {
+        return Box::new(gx2);
+    }
+    let gx2 = Box::new(gx2);
+    let mirror = mirror::Front::new();
+    let pool = mirror.pool();
+    let back = match mode {
+        Mode::Thread => {
+            let (tx, rx) = sync_channel(8192);
+            let pending: Pending = Arc::new((Mutex::new(0), Condvar::new()));
+            let (gx2, p, pool) = (AssertSend(gx2), pending.clone(), pool);
+            std::thread::Builder::new()
+                .name("mh3u resolver".into())
+                .spawn(move || {
+                    let gx2 = gx2;
+                    run(*gx2.0, rx, p, pool)
+                })
+                .expect("the resolver thread");
+            eprintln!("[gfx] draws worked out on a thread of their own (MH3U_GFX_RESOLVER=off to work them out on the game's)");
+            Back::Thread {
+                tx,
+                pending,
+                batch: Vec::with_capacity(BATCH),
+            }
+        }
+        _ => {
+            eprintln!(
+                "[gfx] draws worked out on the game's thread through the copy of its memory (MH3U_GFX_RESOLVER={})",
+                if mode == Mode::Check { "check" } else { "sync" }
+            );
+            Back::Inline {
+                gx2,
+                memory: mirror::Back::new().expect("the copy of the guest's memory"),
+                ctx: None,
+                check: mode == Mode::Check,
+            }
+        }
+    };
+    Box::new(Front {
+        back,
+        contexts: HashMap::default(),
+        current: 0,
+        recording: None,
+        lists: HashMap::default(),
+        scratch_calls: Vec::new(),
+        fetch: HashMap::default(),
+        mirror,
+        scratch: None,
+        swaps: 0,
+        interval: 1,
+        next_vsync: Instant::now(),
+        mismatches: 0,
+        inval_bytes: 0,
+        inval_calls: 0,
+        draws: 0,
+        spans_seen: 0,
+        inval_biggest: (0, 0, 0),
+        by_kind: [0; 8],
+        targets: std::collections::HashSet::new(),
+        capture: Duration::ZERO,
+        frames_reported: 0,
+        timing: std::env::var_os("MH3U_GFX_FRONT_TIMES").is_some(),
+        tm: Times::default(),
+        ahead: std::env::var("MH3U_GFX_FRAMES_AHEAD").ok().and_then(|v| v.trim().parse().ok()).map_or(FRAMES_AHEAD, |n: u32| n.clamp(1, 8)),
+        batch_size: std::env::var("MH3U_GFX_BATCH").ok().and_then(|v| v.trim().parse().ok()).map_or(BATCH, |n: usize| n.clamp(1, 8192)),
+    })
+}
+
+/// The thread that draws: applies each message, in order, to the graphics.
+fn run(mut gx2: Gx2, rx: Receiver<Msg>, pending: Pending, pool: mirror::Pool) {
+    let mut memory = match mirror::Back::new() {
+        Ok(m) => m,
+        Err(e) => {
+            eprintln!("[gfx] the copy of the guest's memory could not be made: {e:#}");
+            std::process::exit(1);
+        }
+    };
+    let g = memory.guest();
+    let mut ctx: Option<SendCtx> = None;
+    while let Ok(msg) = rx.recv() {
+        let batch = match msg {
+            Msg::Batch(v) => v,
+            one => vec![one],
+        };
+        for msg in batch {
+            match msg {
+                Msg::Batch(_) => {}
+                Msg::Init(c) => ctx = Some(*c),
+                Msg::Call { updates, rec } => {
+                    if let Some(u) = updates {
+                        memory.apply(&u);
+                        pool.give(u);
+                    }
+                    let Some(c) = ctx.as_mut() else { continue };
+                    rec.load(&mut c.0);
+                    gx2.exec(rec.call, &mut c.0, &g, Some(&rec.stack));
+                    if rec.call == Call::SwapScanBuffers {
+                        let (n, done) = &*pending;
+                        *n.lock().unwrap() -= 1;
+                        done.notify_all();
+                    }
+                }
+                Msg::FetchShader {
+                    updates,
+                    shader,
+                    streams,
+                } => {
+                    if let Some(u) = updates {
+                        memory.apply(&u);
+                        pool.give(u);
+                    }
+                    let streams = gx2.intern_fetch(streams);
+                    gx2.fetch_shaders.insert(shader, streams);
+                }
+            }
+        }
+    }
+}
+
+/// A guest address that can be the start of something to read.
+fn pointer(a: u32) -> bool {
+    a >= 0x0200_0000
+}
+
+impl Front {
+    /// A structure the game may change without announcing it: copied again each time (exact bytes, not pages).
+    fn fresh_kind(&mut self, g: &Guest, kind: usize, address: u32, len: u32) {
+        if pointer(address) {
+            let before = self.mirror.copied;
+            self.mirror.fresh(g, address, len);
+            self.by_kind[kind] += self.mirror.copied - before;
+        }
+    }
+
+    /// `ensure`, counting the bytes it had to copy under `kind` (0 shaders, 1 textures, 2 targets, 3 uniforms, 4 indices, 5 vertices,
+    /// 6 arguments of other calls, 7 anything else).
+    fn ensure_kind(&mut self, g: &Guest, kind: usize, address: u32, len: u32) {
+        if pointer(address) {
+            let before = self.mirror.copied;
+            self.mirror.ensure(g, address, len.min(1 << 26), kind == 0);
+            self.by_kind[kind] += self.mirror.copied - before;
+        }
+    }
+
+    /// Everything a draw in `st` reads from the guest's memory goes into the copy.
+    fn capture_draw(&mut self, g: &Guest, st: &State, primitive: u32, indexed: Option<(u32, u32)>, count: u32, first: u32, instances: u32) {
+        let u = |a: u32| g.u32(a);
+        // the shaders: their structures, programs and loop constants
+        if pointer(st.vertex_shader) {
+            let vs = st.vertex_shader;
+            self.fresh_kind(g, 0, vs, 0x140);
+            self.ensure_kind(g, 0, u(vs + 0xd4), u(vs + 0xd0).min(1 << 20));
+            self.ensure_kind(g, 0, u(vs + 0xf8), 8 * u(vs + 0xf4).min(32));
+        }
+        if pointer(st.pixel_shader) {
+            let ps = st.pixel_shader;
+            self.fresh_kind(g, 0, ps, 0xe8);
+            self.ensure_kind(g, 0, u(ps + 0xa8), u(ps + 0xa4).min(1 << 20));
+            self.ensure_kind(g, 0, u(ps + 0xcc), 8 * u(ps + 0xc8).min(32));
+        }
+        if pointer(st.geometry_shader) {
+            let gs = st.geometry_shader;
+            self.fresh_kind(g, 0, gs, 0x140);
+            self.ensure_kind(g, 0, u(gs + 0x50), u(gs + 0x4c).min(1 << 20));
+            self.ensure_kind(g, 0, u(gs + 0x58), u(gs + 0x54).min(1 << 20));
+        }
+        // the textures (structure and image data), samplers and targets
+        for &cb in st.colour_buffers.iter().filter(|&&c| pointer(c)) {
+            self.targets.insert(u(cb + 0x24));
+        }
+        if pointer(st.depth_buffer) {
+            self.targets.insert(u(st.depth_buffer + 0x24));
+        }
+        for &t in st.pixel_textures.iter().filter(|&&t| pointer(t)) {
+            self.fresh_kind(g, 1, t, 0xa0);
+            self.ensure_kind(g, 1, u(t + 0x24), u(t + 0x20));
+            self.ensure_kind(g, 1, u(t + 0x2c), u(t + 0x28));
+        }
+        for &s in st.pixel_samplers.iter().filter(|&&s| pointer(s)) {
+            self.fresh_kind(g, 1, s, 0x10);
+        }
+        for &cb in st.colour_buffers.iter().filter(|&&c| pointer(c)) {
+            self.fresh_kind(g, 2, cb, 0x80);
+        }
+        self.fresh_kind(g, 2, st.depth_buffer, 0x80);
+        // the uniform blocks
+        for block in st.vertex_blocks.iter().chain(&st.pixel_blocks).chain(&st.geometry_blocks) {
+            self.fresh_kind(g, 3, block.address, block.size.min(1 << 20));
+        }
+        // the indices, and the vertices they reach (the way `index_list` works them out: little-endian for the types 0 and 1, base vertex
+        // added, a strip's restart index left out)
+        let (mut lowest, mut highest) = (first, first.wrapping_add(count).wrapping_sub(1));
+        if let Some((kind, address)) = indexed {
+            let (wide, big) = (matches!(kind, 1 | 9), matches!(kind, 4 | 9));
+            let bytes = count.saturating_mul(if wide { 4 } else { 2 });
+            if bytes <= SMALL {
+                self.fresh_kind(g, 4, address, bytes);
+            } else {
+                self.ensure_kind(g, 4, address, bytes);
+            }
+            if pointer(address) && count > 0 {
+                let restart = if matches!(primitive, 3 | 6) { st.restart_index } else { None };
+                let (mut lo, mut hi) = (u32::MAX, 0u32);
+                g.with_bytes(address, bytes as usize, |raw| {
+                    let mut seen = |v: u32| {
+                        if Some(v) != restart {
+                            let v = v.wrapping_add(first);
+                            lo = lo.min(v);
+                            hi = hi.max(v);
+                        }
+                    };
+                    match (wide, big) {
+                        (true, true) => raw.chunks_exact(4).for_each(|c| seen(u32::from_be_bytes([c[0], c[1], c[2], c[3]]))),
+                        (true, false) => raw.chunks_exact(4).for_each(|c| seen(u32::from_le_bytes([c[0], c[1], c[2], c[3]]))),
+                        (false, true) => raw.chunks_exact(2).for_each(|c| seen(u32::from(u16::from_be_bytes([c[0], c[1]])))),
+                        (false, false) => raw.chunks_exact(2).for_each(|c| seen(u32::from(u16::from_le_bytes([c[0], c[1]])))),
+                    }
+                });
+                if lo <= hi {
+                    (lowest, highest) = (lo, hi);
+                }
+            }
+        }
+        let vertices = highest.wrapping_sub(lowest).wrapping_add(1).clamp(1, 1 << 22);
+        // one span for each buffer and range of items, as `cached_streams` reads them: (buffer, first item, items, bytes past the last
+        // item's start)
+        let fetch = self.fetch.get(&st.fetch_shader).cloned();
+        let mut spans: Vec<(u32, u32, u32, u32)> = Vec::new();
+        for a in fetch.iter().flat_map(|f| f.iter()).take(16) {
+            let (from, items) = if a.per_instance {
+                (0, instances.max(1).div_ceil(a.divisor.max(1)))
+            } else {
+                (lowest, vertices)
+            };
+            let end = a.offset + attribute_size(a.format);
+            match spans.iter_mut().find(|s| (s.0, s.1, s.2) == (a.buffer, from, items)) {
+                Some(s) => s.3 = s.3.max(end),
+                None => spans.push((a.buffer, from, items, end)),
+            }
+        }
+        self.spans_seen += spans.len() as u64;
+        for (buffer, from, items, end) in spans {
+            let Some(b) = st.attrib_buffers.get((buffer as usize).min(15)) else {
+                continue;
+            };
+            if b.address == 0 || items == 0 {
+                continue;
+            }
+            let start = u64::from(from) * u64::from(b.stride);
+            let len = ((u64::from(items) - 1) * u64::from(b.stride) + u64::from(end)).min(u64::from(b.size).saturating_sub(start)).min(1 << 28);
+            if let Ok(at) = u32::try_from(u64::from(b.address) + start) {
+                if len <= u64::from(SMALL) {
+                    self.fresh_kind(g, 5, at, len as u32);
+                } else {
+                    self.ensure_kind(g, 5, at, len as u32);
+                }
+            }
+        }
+    }
+
+    /// The structures a call that reads surfaces refers to by its first arguments.
+    fn capture_arguments(&mut self, g: &Guest, rec: &Recorded) {
+        for &r in &rec.r[..4] {
+            self.fresh_kind(g, 6, r, 0x100);
+        }
+    }
+
+    /// Sends a call to be applied to the graphics (with the memory it reads), now or on the thread.
+    fn forward(&mut self, g: &Guest, rec: Recorded) {
+        let started = self.timing.then(Instant::now);
+        self.forward_inner(g, rec);
+        if let Some(s) = started {
+            self.tm.forward += s.elapsed();
+        }
+    }
+
+    fn forward_inner(&mut self, g: &Guest, rec: Recorded) {
+        let updates = self.mirror.take();
+        match &mut self.back {
+            Back::Thread { tx, batch, .. } => {
+                batch.push(Msg::Call { updates, rec });
+                if batch.len() >= self.batch_size {
+                    let _ = tx.send(Msg::Batch(std::mem::replace(batch, Vec::with_capacity(BATCH))));
+                }
+            }
+            Back::Inline { gx2, memory, ctx, check } => {
+                if let Some(u) = updates {
+                    memory.apply(&u);
+                    self.mirror.pool().give(u);
+                }
+                let Some(c) = ctx.as_mut() else { return };
+                rec.load(&mut c.0);
+                let copy = memory.guest();
+                if *check {
+                    mh3u_rt::log_reads(true);
+                    let _ = mh3u_rt::take_reads();
+                }
+                gx2.exec(rec.call, &mut c.0, &copy, Some(&rec.stack));
+                if *check {
+                    mh3u_rt::log_reads(false);
+                    let reads = mh3u_rt::take_reads();
+                    let st = self.contexts.entry(self.current).or_default().clone();
+                    self.mismatches += compare(g, &copy, rec.call, &reads, &st);
+                }
+            }
+        }
+    }
+
+    /// Sends what is waiting in the batch.
+    fn flush(&mut self) {
+        if let Back::Thread { tx, batch, .. } = &mut self.back {
+            if !batch.is_empty() {
+                let _ = tx.send(Msg::Batch(std::mem::replace(batch, Vec::with_capacity(BATCH))));
+            }
+        }
+    }
+
+    /// Every 120 frames: what the copy cost, by the kind of thing copied.
+    fn report(&mut self) {
+        self.frames_reported += 1;
+        if self.frames_reported < 120 || std::env::var_os("MH3U_GFX_TIMES").is_none() && std::env::var_os("MH3U_FPS").is_none() {
+            return;
+        }
+        let n = f64::from(self.frames_reported);
+        let names = ["shaders", "textures", "targets", "uniforms", "indices", "vertices", "other calls", "unsorted"];
+        let parts: Vec<String> = names
+            .iter()
+            .zip(self.by_kind)
+            .map(|(name, b)| format!("{name} {:.0} KB", b as f64 / n / 1024.0))
+            .collect();
+        eprintln!(
+            "[gfx mirror] a frame: capturing {:.2} ms, copied {}; mismatches so far {}",
+            self.capture.as_secs_f64() * 1000.0 / n,
+            parts.join(", "),
+            self.mismatches
+        );
+        if self.timing {
+            let ms = |d: Duration| d.as_secs_f64() * 1000.0 / n;
+            eprintln!(
+                "[gfx front] the game's thread a frame: in the graphics calls {:.2} ms (state {:.2}, sending {:.2}, recording lists {:.2}, capturing {:.2}; waiting {:.2}); {:.0} calls outside lists",
+                ms(self.tm.run),
+                ms(self.tm.state),
+                ms(self.tm.forward),
+                ms(self.tm.record),
+                ms(self.capture),
+                ms(self.tm.wait),
+                self.tm.calls as f64 / n
+            );
+            self.tm = Times::default();
+        }
+        eprintln!(
+            "[gfx mirror] draws captured a frame: {:.0}, vertex spans {:.0}",
+            self.draws as f64 / n,
+            self.spans_seen as f64 / n
+        );
+        self.draws = 0;
+        self.spans_seen = 0;
+        eprintln!(
+            "[gfx mirror] invalidations a frame: {:.0} calls, {:.0} KB; biggest {:#x} bytes at {:#x} (mode {:#x})",
+            self.inval_calls as f64 / n,
+            self.inval_bytes as f64 / n / 1024.0,
+            self.inval_biggest.1,
+            self.inval_biggest.0,
+            self.inval_biggest.2
+        );
+        self.inval_bytes = 0;
+        self.inval_calls = 0;
+        self.inval_biggest = (0, 0, 0);
+        self.by_kind = [0; 8];
+        self.capture = Duration::ZERO;
+        self.frames_reported = 0;
+    }
+
+    /// One call, from the game or from a display list.
+    fn exec_call(&mut self, rec: &Recorded, c: Option<&mut Ctx>, g: &Guest) {
+        let call = rec.call;
+        // registers for applying the call to this thread's copy of the state
+        let mut scratch = self.scratch.take();
+        if let Some(s) = scratch.as_mut() {
+            rec.load(&mut s.0);
+        }
+        let stack = rec.stack;
+        match call {
+            Call::DrawEx | Call::DrawIndexedEx => {
+                if let Some(s) = scratch.as_ref() {
+                    let a = |n: usize| arg(&s.0, g, Some(&stack), n);
+                    let (indexed, count, first, instances) = if call == Call::DrawEx {
+                        (None, a(1), a(2), a(3))
+                    } else {
+                        (Some((a(2), a(3))), a(1), a(4), a(5))
+                    };
+                    // the table is taken out for the call (the state is only read), so the state need not be copied for each draw
+                    let contexts = std::mem::take(&mut self.contexts);
+                    if let Some(st) = contexts.get(&self.current) {
+                        self.draws += 1;
+                        let started = self.timing.then(Instant::now);
+                        self.capture_draw(g, st, rec.r[0], indexed, count, first, instances);
+                        if let Some(s) = started {
+                            self.capture += s.elapsed();
+                        }
+                    }
+                    self.contexts = contexts;
+                }
+                self.forward(g, *rec);
+            }
+            Call::InitFetchShaderEx => {
+                let (shader, streams) = init_fetch_shader(g, rec.r[0], rec.r[1], rec.r[2], rec.r[3]);
+                self.fresh_kind(g, 6, rec.r[0], 0x20);
+                self.fetch.insert(shader, streams.clone());
+                let updates = self.mirror.take();
+                match &mut self.back {
+                    Back::Thread { batch, .. } => {
+                        batch.push(Msg::FetchShader {
+                            updates,
+                            shader,
+                            streams,
+                        });
+                    }
+                    Back::Inline { gx2, memory, .. } => {
+                        if let Some(u) = updates {
+                            memory.apply(&u);
+                            self.mirror.pool().give(u);
+                        }
+                        let streams = gx2.intern_fetch(streams);
+                        gx2.fetch_shaders.insert(shader, streams);
+                    }
+                }
+            }
+            // the size of the code the fetch shader would be
+            Call::CalcFetchShaderSizeEx => {
+                if let Some(c) = c {
+                    c.r[3] = (32 + 16 * c.r[3]).div_ceil(16) * 16;
+                }
+            }
+            Call::InitSampler
+            | Call::InitSamplerClamping
+            | Call::InitSamplerXYFilter
+            | Call::InitSamplerZMFilter
+            | Call::InitSamplerLOD
+            | Call::InitSamplerDepthCompare => {
+                if let Some(s) = scratch.as_ref() {
+                    init_sampler(g, call, &s.0);
+                }
+            }
+            Call::GetSwapStatus => {
+                if let Some(c) = c {
+                    for (p, v) in [(c.r[3], self.swaps), (c.r[4], self.swaps)] {
+                        if p != 0 {
+                            g.put_u32(p, v);
+                        }
+                    }
+                    c.r[3] = 0;
+                }
+            }
+            Call::SetSwapInterval => self.interval = rec.r[0],
+            Call::GetSwapInterval => {
+                if let Some(c) = c {
+                    c.r[3] = self.interval;
+                }
+            }
+            Call::WaitForVsync => {
+                let now = Instant::now();
+                if self.next_vsync > now {
+                    std::thread::sleep(self.next_vsync - now);
+                    self.tm.wait += now.elapsed();
+                }
+                // a game that fell behind does not owe the frames it missed
+                self.next_vsync = self.next_vsync.max(now) + FRAME;
+            }
+            Call::Invalidate => {
+                self.inval_bytes += u64::from(rec.r[2]);
+                self.inval_calls += 1;
+                if rec.r[2] > self.inval_biggest.1 && rec.r[2] < 0x8000_0000 {
+                    self.inval_biggest = (rec.r[1], rec.r[2], rec.r[0]);
+                }
+                let (mode, address, size) = (rec.r[0], rec.r[1], rec.r[2]);
+                if mode & !(0x10 | 0x20) == 0 {
+                    // the colour and depth buffers: the GPU wrote there, not the game
+                } else if size >= 0x8000_0000 && mode & !8 == 0 {
+                    // the whole address space, for the shaders: the game says nothing of where they changed
+                    self.mirror.invalidate_shaders();
+                } else {
+                    self.mirror.invalidate(address, size);
+                }
+                self.forward(g, *rec);
+            }
+            Call::SwapScanBuffers => {
+                if let Back::Thread { pending, .. } = &self.back {
+                    *pending.0.lock().unwrap() += 1;
+                }
+                self.forward(g, *rec);
+                self.flush();
+                self.swaps += 1;
+                self.report();
+                if let Back::Thread { pending, .. } = &self.back {
+                    let (n, done) = &**pending;
+                    let started = self.timing.then(Instant::now);
+                    let mut n = n.lock().unwrap();
+                    while *n > self.ahead {
+                        n = done.wait(n).unwrap();
+                    }
+                    if let Some(s) = started {
+                        self.tm.wait += s.elapsed();
+                    }
+                }
+            }
+            Call::ClearColor | Call::ClearDepthStencilEx | Call::CopySurface | Call::CopyColorBufferToScanBuffer => {
+                self.capture_arguments(g, rec);
+                self.forward(g, *rec);
+            }
+            _ => {
+                if let Some(s) = scratch.as_ref() {
+                    let a = |n: usize| arg(&s.0, g, Some(&stack), n);
+                    let started = self.timing.then(Instant::now);
+                    apply_state_call(&mut self.contexts, &mut self.current, call, &s.0, &a);
+                    if let Some(s) = started {
+                        self.tm.state += s.elapsed();
+                    }
+                }
+                self.forward(g, *rec);
+            }
+        }
+        self.scratch = scratch;
+    }
+
+    fn run(&mut self, call: Call, c: &mut Ctx, g: &Guest) {
+        if !self.timing {
+            return self.run_inner(call, c, g);
+        }
+        let started = Instant::now();
+        self.run_inner(call, c, g);
+        self.tm.run += started.elapsed();
+        self.tm.calls += 1;
+    }
+
+    fn run_inner(&mut self, call: Call, c: &mut Ctx, g: &Guest) {
+        // the game's code ran since the last call: what was copied then no longer stands for its memory
+        self.mirror.new_stretch();
+        if self.scratch.is_none() {
+            let copy = c.clone();
+            match &mut self.back {
+                Back::Thread { batch, .. } => {
+                    batch.push(Msg::Init(Box::new(AssertSend(copy.clone()))));
+                }
+                Back::Inline { ctx, .. } => *ctx = Some(AssertSend(copy.clone())),
+            }
+            self.scratch = Some(AssertSend(copy));
+        }
+        match call {
+            Call::BeginDisplayListEx => {
+                self.recording = Some(Recording {
+                    address: c.r[3],
+                    calls: std::mem::take(&mut self.scratch_calls),
+                    made: 0,
+                    seen: Seen::default(),
+                });
+            }
+            Call::EndDisplayList => {
+                if let Some(mut r) = self.recording.take() {
+                    c.r[3] = 0x20 + 0x10 * r.made;
+                    self.lists.insert(r.address, Arc::from(r.calls.as_slice()));
+                    r.calls.clear();
+                    self.scratch_calls = r.calls;
+                }
+            }
+            Call::DirectCallDisplayList => {
+                let Some(calls) = self.lists.get(&c.r[3]).cloned() else { return };
+                for rec in calls.iter() {
+                    self.exec_call(rec, None, g);
+                }
+                self.flush();
+            }
+            _ => {
+                if let Some(r) = self.recording.as_mut().filter(|_| !is_immediate(call)) {
+                    r.made += 1;
+                    if !r.seen.redundant(call, c.r[3], c.r[4]) {
+                        let started = self.timing.then(Instant::now);
+                        r.calls.push(Recorded::new(call, c, g));
+                        if let Some(s) = started {
+                            self.tm.record += s.elapsed();
+                        }
+                    }
+                } else {
+                    let rec = Recorded::new(call, c, g);
+                    self.exec_call(&rec, Some(c), g);
+                }
+            }
+        }
+    }
+}
+
+/// `GX2InitSampler` and its variants: they write the sampler's words in the guest's memory, at once.
+fn init_sampler(g: &Guest, call: Call, c: &Ctx) {
+    let a = |n: usize| c.r[3 + n];
+    match call {
+        Call::InitSampler => {
+            let (s, clamp, filter) = (a(0), a(1) & 15, a(2) & 15);
+            g.put_u32(s, clamp | clamp << 4 | clamp << 8 | filter << 12 | filter << 16);
+            g.put_u32(s + 4, 0xf | (13 * 16) << 18);
+            g.put_u32(s + 8, 0);
+        }
+        Call::InitSamplerClamping => {
+            let (s, x, y, z) = (a(0), a(1) & 15, a(2) & 15, a(3) & 15);
+            let w = g.u32(s) & !0xfff;
+            g.put_u32(s, w | x | y << 4 | z << 8);
+        }
+        Call::InitSamplerXYFilter => {
+            let (s, mag, min) = (a(0), a(1) & 15, a(2) & 15);
+            let w = g.u32(s) & !(0xff << 12);
+            g.put_u32(s, w | mag << 12 | min << 16);
+        }
+        Call::InitSamplerZMFilter => {
+            let (s, z, mip) = (a(0), a(1) & 15, a(2) & 15);
+            let w = g.u32(s) & !(0xff << 20);
+            g.put_u32(s, w | z << 20 | mip << 24);
+        }
+        Call::InitSamplerLOD => {
+            let s = a(0);
+            let q = |v: f32| (v.clamp(0.0, 63.0) * 16.0) as u32 & 0x3ff;
+            let w = g.u32(s + 4) & 0xff;
+            g.put_u32(s + 4, w | q(farg(c, 0)) << 8 | q(farg(c, 1)) << 18);
+            g.put_u32(s + 8, farg(c, 2).to_bits());
+        }
+        Call::InitSamplerDepthCompare => {
+            let (s, func) = (a(0), a(1) & 15);
+            let w = g.u32(s + 4) & !0xf;
+            g.put_u32(s + 4, w | func);
+        }
+        _ => {}
+    }
+}
+
+/// What the draw's state says is at `address`, for the reports of reads that differ.
+fn describe(g: &Guest, st: &State, address: u32) -> String {
+    let inside = |start: u32, len: u32| start != 0 && address >= start && address - start < len.max(1);
+    for (i, &t) in st.pixel_textures.iter().enumerate().filter(|&(_, &t)| t != 0) {
+        let (image, isize, mip, msize) = (g.u32(t + 0x24), g.u32(t + 0x20), g.u32(t + 0x2c), g.u32(t + 0x28));
+        if inside(t, 0xa0) {
+            return format!("in the structure of texture unit {i}");
+        }
+        if inside(image, isize) {
+            return format!("in the image of texture unit {i} ({image:#x}, {isize:#x} bytes, format {:#x})", g.u32(t + 0x14));
+        }
+        if inside(mip, msize) {
+            return format!("in the mip data of texture unit {i} ({mip:#x}, {msize:#x} bytes)");
+        }
+        if inside(image, 0x40_0000) {
+            return format!("past the image of texture unit {i} ({image:#x}, size field {isize:#x}, format {:#x}, mips {})", g.u32(t + 0x14), g.u32(t + 0x10));
+        }
+    }
+    for (i, b) in st.attrib_buffers.iter().enumerate() {
+        if inside(b.address, b.size) {
+            return format!("in vertex buffer {i} ({:#x}, {:#x} bytes, stride {})", b.address, b.size, b.stride);
+        }
+    }
+    for blocks in [&st.vertex_blocks, &st.pixel_blocks, &st.geometry_blocks] {
+        for (i, b) in blocks.iter().enumerate() {
+            if inside(b.address, b.size) {
+                return format!("in uniform block {i} ({:#x}, {:#x} bytes)", b.address, b.size);
+            }
+        }
+    }
+    "in nothing the state names".to_string()
+}
+
+/// How many of the `reads` a call made of the copy differ from the memory itself (they should be the same: the copy was made from it).
+fn compare(live: &Guest, copy: &Guest, call: Call, reads: &[(u32, u32)], st: &State) -> u64 {
+    static SHOWN: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+    let mut bad = 0;
+    for &(address, len) in reads {
+        let (mut a, mut b) = (vec![0u8; len as usize], vec![0u8; len as usize]);
+        live.read_unlogged(address, &mut a);
+        copy.read_unlogged(address, &mut b);
+        if a != b {
+            bad += 1;
+            if SHOWN.fetch_add(1, std::sync::atomic::Ordering::Relaxed) < 60 {
+                let first = a.iter().zip(&b).position(|(x, y)| x != y).unwrap_or(0);
+                eprintln!(
+                    "[gfx mirror] {}: {len} bytes read at {address:#x} differ from the game's memory (first at +{first:#x}); {}",
+                    call.name(),
+                    describe(live, st, address)
+                );
+            }
+        }
+    }
+    bad
+}
+
+impl Gx2Backend for Front {
+    fn implements(&self, name: &str) -> bool {
+        Call::from_name(name).is_some()
+    }
+
+    fn resolve(&self, name: &str) -> Option<u32> {
+        Call::from_name(name).map(|c| c as u32)
+    }
+
+    fn call_id(&mut self, id: Option<u32>, name: &str, c: &mut Ctx, g: &Guest) {
+        let call = id.and_then(|id| Call::ALL.get(id as usize)).copied().or_else(|| Call::from_name(name));
+        if let Some(call) = call {
+            self.run(call, c, g);
+        }
+    }
+
+    fn call(&mut self, name: &str, c: &mut Ctx, g: &Guest) {
+        if let Some(call) = Call::from_name(name) {
+            self.run(call, c, g);
+        }
+    }
+}
