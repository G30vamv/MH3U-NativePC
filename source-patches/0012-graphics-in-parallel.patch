         unsafe { std::ptr::copy_nonoverlapping(self.at(address), out.as_mut_ptr(), out.len()) }
     }
 
+    /// [`Guest::read`] that the read log does not see (for the log's own checks).
+    pub fn read_unlogged(&self, address: u32, out: &mut [u8]) {
