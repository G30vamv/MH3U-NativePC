 }
 
+/// Whether reads through [`Guest`] are being logged (a measuring aid for the graphics code; see `log_reads`).
+static LOGGING: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+thread_local! {
+    static READS: std::cell::RefCell<Vec<(u32, u32)>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// Starts (or stops) logging the reads made through [`Guest`] by any thread, as (address, bytes), in the thread that made them.
+pub fn log_reads(on: bool) {
+    LOGGING.store(on, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// The reads this thread made since the last call, oldest first.
+pub fn take_reads() -> Vec<(u32, u32)> {
+    READS.with(|r| std::mem::take(&mut *r.borrow_mut()))
+}
+
+#[inline]
+fn logged(address: u32, len: usize) {
+    if LOGGING.load(std::sync::atomic::Ordering::Relaxed) {
+        READS.with(|r| r.borrow_mut().push((address, len as u32)));
+    }
+}
+
 /// A view of the guest's address space (a reserved range of 4 GiB with guest address 0 at `base`).
 #[derive(Clone, Copy)]
 pub struct Guest {
@@ -40,15 +64,23 @@ impl Guest {
 
     /// Copies `out.len()` bytes from the guest. The caller keeps `address + len` below 4 GiB.
