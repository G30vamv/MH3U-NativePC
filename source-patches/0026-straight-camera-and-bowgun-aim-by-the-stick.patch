+/// An axis without what a push along the other one leaks into it: nothing under [`LEAK`] of the other, coming in from there on
+/// with no jump, and whole from [`BOTH`] of the other on (a diagonal stays a diagonal).
+fn apart(axis: f32, other: f32) -> f32 {
+    let (a, o) = (axis.abs(), other.abs());
+    if a >= BOTH * o {
+        return axis;
+    }
+    axis * ((a - LEAK * o) / ((BOTH - LEAK) * o)).max(0.0)
 }
 
