@@ -0,0 +1,324 @@
+//! The camera follows how far the right stick is pushed (`MH3U_ANALOG_CAMERA=off` gives the game's own camera back).
+//!
+//! The game does not take the right stick as a stick for the camera: past half way an axis becomes a button, the buttons become
+//! "orders" (the bits of `ctrl+0x1c8`: 9 = the camera may move, 1/3 = up/down pressed, 2/4 = up/down held, 6/8 = left/right held)
+//! and the camera's update applies them (read with Ghidra, `docs/ghidra.md`):
+//! - `camera_turn` is `f_02286f18(owner, camera, hunter)`: left and right turn the camera at a speed that grows with a counter
+//!   (`camera+0xe4`, up to 5 steps on foot and 10 in the water) while the order is held: speed = most * counter / steps.
+//! - `camera_pitch` is `f_02286890(owner, camera, hunter)`: in the water (`ctrl+0x3d` is 3) up and down tilt the camera the same way
+//!   (counter `camera+0xd8`, 12 steps); on foot each press moves the camera one of six heights (`camera+0xa8`, 0 to 5), whose
+//!   offsets are the rows of a table (`0x101fe460`, 0x30 bytes a height) the caller reads right after.
+//!
+//! Here, at the entry of both, the stick decides instead:
+//! - turning and tilting: the order is set from the stick's side however little it is pushed, and the counter is set so that the
+//!   speed the game works out is its most times how far the stick is pushed;
+//! - the heights: a height with a fraction is kept here and moves with the stick; the game gets the nearest whole height and that
+//!   height's row holds, while it is in use, the mix of the two rows the fraction lies between (the row is put back as it was
+//!   before anything else is done). The game's own presses of that stick are taken out, so it does not jump a whole height.
+//!
+//! Only the hunter that plays here, and never while aiming a ranged weapon (`ctrl+0x58` is 1: `cheats.rs` moves the aim).
+
+use crate::guest::Guest;
+use crate::hooks::{Callback, Hook, Registry};
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicU32, Ordering::Relaxed};
+use std::time::Instant;
+
+/// The stick counts as pushed past this length (a worn stick rests a little off its centre).
+const DEAD: f32 = 0.12;
+/// The camera's heights on foot, and where the table of their rows is.
+const HEIGHTS: u8 = 6;
+const TABLE: u32 = 0x101f_e460;
+const ROW_WORDS: usize = 12;
+const ROW: u32 = 4 * ROW_WORDS as u32;
+/// How many heights a second the stick held all the way moves the camera.
+const HEIGHTS_A_SECOND: f32 = 4.0;
+/// The orders (bits of `ctrl+0x1c8`).
+const MAY_MOVE: u32 = 1 << 9;
+const UP_PRESS: u32 = 1 << 1;
+const UP: u32 = 1 << 2;
+const DOWN_PRESS: u32 = 1 << 3;
+const DOWN: u32 = 1 << 4;
+const LEFT: u32 = 1 << 6;
+const RIGHT: u32 = 1 << 8;
+
+/// Whether the camera follows the stick (on unless `MH3U_ANALOG_CAMERA` is `off`/`0`).
+pub fn enabled() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| crate::input::switch_setting(std::env::var("MH3U_ANALOG_CAMERA").ok().as_deref(), true))
+}
+
+/// Registers the camera's callbacks (nothing when it is off or the build has no camera hooks).
+pub fn register(r: &mut Registry) {
+    if !enabled() {
+        eprintln!("[camera] the game's own camera (MH3U_ANALOG_CAMERA=off)");
+        return;
+    }
+    let turn = r.on("camera_turn", turn());
+    let pitch = r.on("camera_pitch", pitch());
+    if turn && pitch {
+        eprintln!("[camera] follows how far the right stick is pushed (MH3U_ANALOG_CAMERA=off turns it off)");
+    } else {
+        eprintln!("[camera] needs the hooks camera_turn and camera_pitch: build the game again with the launcher's current mods/hooks.txt");
+    }
+}
+
+/// How far the stick is pushed on each axis, -1 to 1: nothing inside the dead ring, then growing from 0, times the player's
+/// sensitivity.
+fn push(x: f32, y: f32, gain: f32) -> (f32, f32) {
+    let length = x.hypot(y);
+    if !length.is_finite() || length <= DEAD {
+        return (0.0, 0.0);
+    }
+    let far = ((length.min(1.0) - DEAD) / (1.0 - DEAD) * gain).min(1.0);
+    (x / length * far, y / length * far)
+}
+
+/// What the game's counter has to be on entry for its speed to be `push` of its most: the game adds `step` to a counter under
+/// `steps` before it uses it.
+fn counter(push: f32, steps: f32, step: f32) -> f32 {
+    let wanted = push.abs().min(1.0) * steps;
+    if wanted >= steps { steps } else { (wanted - step).max(0.0) }
+}
+
+/// The right stick as the camera takes it.
+fn stick() -> (f32, f32) {
+    let (x, y) = crate::input::right_stick_pushed();
+    push(x, y, crate::input::right_stick_gain())
+}
+
+fn f32_at(g: &Guest, address: u32) -> f32 {
+    f32::from_bits(g.u32(address))
+}
+
+/// The time step the game adds to a counter: the float a pointer of the camera leads to (1 at 30 frames a second).
+fn step(g: &Guest, pointer: u32) -> f32 {
+    let p = g.u32(pointer);
+    if !(0x1000_0000..0x5000_0000).contains(&p) {
+        return 0.0;
+    }
+    let v = f32_at(g, p);
+    if v.is_finite() && (0.0..=4.0).contains(&v) { v } else { 0.0 }
+}
+
+/// The controls of the hunter, when it is the one that plays here and the camera may be moved with the stick now.
+fn controls(g: &Guest, hunter: u32) -> Option<u32> {
+    if !crate::combat::is_local_hunter(g, hunter) {
+        return None;
+    }
+    let ctrl = g.u32(hunter.wrapping_add(0xe30));
+    (ctrl != 0 && g.u32(ctrl + 0x1c8) & MAY_MOVE != 0 && g.u8(ctrl + 0x58) != 1).then_some(ctrl)
+}
+
+fn said(n: &AtomicU32) -> bool {
+    let k = n.fetch_add(1, Relaxed);
+    k < 3 || k % 2000 == 0
+}
+
+fn turn() -> Callback {
+    let n = AtomicU32::new(0);
+    Box::new(move |h: &mut Hook| {
+        let g = Guest::new(h.ctx.mem);
+        let (camera, hunter) = (h.ctx.r[4], h.ctx.r[5]);
+        let Some(ctrl) = controls(&g, hunter) else { return };
+        let (x, _) = stick();
+        if x == 0.0 {
+            return;
+        }
+        let orders = g.u32(ctrl + 0x1c8);
+        let (on, off) = if x < 0.0 { (LEFT, RIGHT) } else { (RIGHT, LEFT) };
+        g.put_u32(ctrl + 0x1c8, orders & !off | on);
+        let steps = if g.u8(ctrl + 0x3d) == 3 { 10.0 } else { 5.0 };
+        let to = counter(x, steps, step(&g, camera + 0xec));
+        g.put_u32(camera + 0xe4, to.to_bits());
+        if said(&n) {
+            eprintln!("[camera] turn: stick {x:.2}, counter {to:.2} of {steps}");
+        }
+    })
+}
+
+/// The camera's height on foot, with its fraction.
+struct Height {
+    at: f32,
+    /// The whole height the game was left with (a different one at the next update is the game's own change).
+    given: Option<u8>,
+    /// The row that holds a mix: which, as the game had it, and as it was written.
+    mixed: Option<(u8, [u32; ROW_WORDS], [u32; ROW_WORDS])>,
+    last: Option<Instant>,
+}
+
+fn row(g: &Guest, height: u8) -> [u32; ROW_WORDS] {
+    std::array::from_fn(|k| g.u32(TABLE + ROW * u32::from(height) + 4 * k as u32))
+}
+
+fn put_row(g: &Guest, height: u8, words: &[u32; ROW_WORDS]) {
+    for (k, w) in words.iter().enumerate() {
+        g.put_u32(TABLE + ROW * u32::from(height) + 4 * k as u32, *w);
+    }
+}
+
+/// The row `part` of the way from `a` to `b` (a word that is not an ordinary number in both stays as in `a`).
+fn mix(a: &[u32; ROW_WORDS], b: &[u32; ROW_WORDS], part: f32) -> [u32; ROW_WORDS] {
+    std::array::from_fn(|k| {
+        let (x, y) = (f32::from_bits(a[k]), f32::from_bits(b[k]));
+        let plain = |v: f32| v == 0.0 || (v.is_normal() && v.abs() < 1.0e6 && v.abs() > 1.0e-6);
+        if plain(x) && plain(y) { (x + (y - x) * part).to_bits() } else { a[k] }
+    })
+}
+
+impl Height {
+    const fn new() -> Height {
+        Height {
+            at: 0.0,
+            given: None,
+            mixed: None,
+            last: None,
+        }
+    }
+
+    /// Puts the mixed row back as the game had it (unless the game wrote it since).
+    fn put_back(&mut self, g: &Guest) {
+        if let Some((height, was, written)) = self.mixed.take()
+            && row(g, height) == written
+        {
+            put_row(g, height, &was);
+        }
+    }
+
+    /// Moves the height `change` heights from where the game (`game`) or the stick left it; gives the whole height for the game
+    /// and, when the height has a fraction, the other height and how much of it to mix in.
+    fn moved(&mut self, game: u8, change: f32) -> (u8, Option<(u8, f32)>) {
+        let most = HEIGHTS - 1;
+        if self.given != Some(game) {
+            self.at = f32::from(game.min(most));
+        }
+        self.at = (self.at + change).clamp(0.0, f32::from(most));
+        let whole = self.at.round() as u8;
+        self.given = Some(whole);
+        let part = self.at - f32::from(whole);
+        let other = if part > 0.0 { whole + 1 } else { whole.wrapping_sub(1) };
+        (whole, (part.abs() > 0.002 && other <= most).then_some((other, part.abs())))
+    }
+}
+
+fn pitch() -> Callback {
+    let state = Mutex::new(Height::new());
+    let n = AtomicU32::new(0);
+    Box::new(move |h: &mut Hook| {
+        let g = Guest::new(h.ctx.mem);
+        let (camera, hunter) = (h.ctx.r[4], h.ctx.r[5]);
+        if !crate::combat::is_local_hunter(&g, hunter) {
+            return;
+        }
+        let mut s = state.lock().unwrap_or_else(|e| e.into_inner());
+        s.put_back(&g);
+        let now = Instant::now();
+        let dt = s.last.replace(now).map_or(0.0, |t| (now - t).as_secs_f32().min(0.05));
+        let Some(ctrl) = controls(&g, hunter) else { return };
+        let (_, y) = stick();
+        let orders = g.u32(ctrl + 0x1c8);
+        if g.u8(ctrl + 0x3d) == 3 {
+            // in the water the camera tilts freely: the game's own way, at the stick's speed
+            s.given = None;
+            if y != 0.0 {
+                let on = if y > 0.0 { UP } else { DOWN };
+                g.put_u32(ctrl + 0x1c8, orders & !(UP | DOWN | UP_PRESS | DOWN_PRESS) | on);
+                let to = counter(y, 12.0, step(&g, camera + 0xe0));
+                g.put_u32(camera + 0xd8, to.to_bits());
+            }
+            return;
+        }
+        let mut change = 0.0;
+        if y != 0.0 {
+            // the stick's own presses would move a whole height
+            g.put_u32(ctrl + 0x1c8, orders & !(UP_PRESS | DOWN_PRESS));
+            // as the game: up is the next height, unless the player turned the camera's up and down over in the game's options
+            let turned = g.u8(camera + 0x697) & 2 != 0;
+            change = if turned { -y } else { y } * HEIGHTS_A_SECOND * dt;
+        }
+        let game = g.u8(camera + 0xa8);
+        if game >= HEIGHTS {
+            return;
+        }
+        let (whole, part) = s.moved(game, change);
+        if whole != game {
+            g.put_u8(camera + 0xa8, whole);
+        }
+        if let Some((other, part)) = part {
+            let was = row(&g, whole);
+            let written = mix(&was, &row(&g, other), part);
+            put_row(&g, whole, &written);
+            s.mixed = Some((whole, was, written));
+        }
+        if y != 0.0 && said(&n) {
+            eprintln!("[camera] height: stick {y:.2}, at {:.2} (the game has {whole})", s.at);
+        }
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_push_starts_at_the_dead_ring_and_keeps_its_direction() {
+        assert_eq!(push(0.05, 0.05, 1.0), (0.0, 0.0));
+        let (x, y) = push(1.0, 0.0, 1.0);
+        assert!((x - 1.0).abs() < 1e-6 && y == 0.0);
+        let (x, y) = push(-0.3, 0.3, 1.0);
+        assert!(x < 0.0 && y > 0.0 && (x + y).abs() < 1e-6);
+        // a little past the ring is a little push, not half the way
+        assert!(push(0.2, 0.0, 1.0).0 < 0.12);
+        // the sensitivity makes it gentler or reach the most sooner, never more than the most
+        assert!((push(1.0, 0.0, 0.5).0 - 0.5).abs() < 1e-6);
+        assert!((push(0.8, 0.0, 1.5).0 - 1.0).abs() < 1e-6);
+        assert_eq!(push(f32::NAN, 0.0, 1.0), (0.0, 0.0));
+    }
+
+    #[test]
+    fn the_counter_gives_the_games_speed_times_the_push() {
+        // the game adds the step to a counter under the steps and takes counter / steps of its most
+        let speed = |push: f32, steps: f32, step: f32| {
+            let c = counter(push, steps, step);
+            (if c < steps { c + step } else { c }) / steps
+        };
+        for (push, steps, step) in [(0.5, 5.0, 1.0), (0.5, 5.0, 0.125), (0.9, 10.0, 0.5), (0.3, 12.0, 0.25)] {
+            assert!((speed(push, steps, step) - push).abs() < 1e-5, "{push} {steps} {step}");
+        }
+        assert_eq!(speed(1.0, 5.0, 1.0), 1.0);
+        assert_eq!(speed(-1.0, 5.0, 0.125), 1.0);
+        // never under one step: the game's slowest
+        assert_eq!(counter(0.01, 5.0, 1.0), 0.0);
+    }
+
+    #[test]
+    fn the_height_moves_by_fractions_and_follows_the_games_own_changes() {
+        let mut h = Height::new();
+        // starts where the game is
+        assert_eq!(h.moved(3, 0.0), (3, None));
+        let (whole, part) = h.moved(3, 0.25);
+        assert_eq!(whole, 3);
+        let (other, share) = part.unwrap();
+        assert!(other == 4 && (share - 0.25).abs() < 1e-6);
+        // past the middle the nearest height is the next one, mixed with the one below
+        let (whole, part) = h.moved(3, 0.5);
+        let (other, share) = part.unwrap();
+        assert!(whole == 4 && other == 3 && (share - 0.25).abs() < 1e-6);
+        // the ends
+        assert_eq!(h.moved(4, 9.0), (5, None));
+        assert_eq!(h.moved(5, -9.0), (0, None));
+        // the game put the camera somewhere else (its reset): from there on
+        assert_eq!(h.moved(2, 0.0), (2, None));
+    }
+
+    #[test]
+    fn a_mixed_row_lies_between_its_two_rows() {
+        let a: [u32; ROW_WORDS] = std::array::from_fn(|k| (k as f32 * 10.0).to_bits());
+        let mut b: [u32; ROW_WORDS] = std::array::from_fn(|k| (k as f32 * 10.0 + 8.0).to_bits());
+        b[3] = 0x1234; // not a number the camera uses: left alone
+        let m = mix(&a, &b, 0.25);
+        assert_eq!(f32::from_bits(m[0]), 2.0);
+        assert_eq!(f32::from_bits(m[5]), 52.0);
+        assert_eq!(m[3], a[3]);
+    }
+}
