+    /// shader does not write must read as zero, an empty triangle), then one compute pass with the vertex and geometry stage of each
+    /// draw in turn.
+    pub(crate) fn encode_geo_jobs(&mut self) {
+        if self.batch.geo_jobs.is_empty() {
+            return;
+        }
