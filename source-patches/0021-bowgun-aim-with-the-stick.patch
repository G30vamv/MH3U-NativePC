+/// The bowgun's vertical aim. `aim_pitch` is `f_028a19b8(hunter)`, the per-frame update of a ranged weapon's aim, which turns the hunter
+/// towards `ctrl+0x184` (the target pitch). While aiming (`+0x58` and `+0xe00` are 1) the game moves that target with orders 0x2b/0x2c
+/// that nothing sets on this port, so the aim never moved. Here the target follows the pad instead: X (0x2000, the stick pushed up) raises
+/// it, Y (0x1000, down) lowers it, within the game's own limits (-0x3e93..0x3e94).
+fn aim_pitch() -> Callback {
+    let n = AtomicU32::new(0);
+    Box::new(move |h: &mut Hook| {
+        let g = Guest::new(h.ctx.mem);
+        let ctrl = g.u32(h.ctx.r[3].wrapping_add(0xe30));
+        if ctrl == 0 || g.u8(ctrl + 0x58) != 1 {
+            return;
+        }
+        let pad = g.u16(ctrl + 0x19c);
+        let step: i32 = match (pad & 0x2000 != 0, pad & 0x1000 != 0) {
+            (true, false) => -AIM_STEP,
+            (false, true) => AIM_STEP,
+            _ => return,
+        };
+        let now = i32::from(g.u32(ctrl + 0x184) as u16 as i16);
+        let step = (step as f32 * crate::input::right_stick_gain()).round() as i32;
+        let to = (now + step).clamp(-0x3e93, 0x3e94);
+        g.put_u32(ctrl + 0x184, to as u32 & 0xffff);
+        let k = n.fetch_add(1, Relaxed);
+        if k < 3 || k % 300 == 0 {
+            eprintln!("[aim] pitch target {now:#x} -> {to:#x} (pad {pad:04x}, e00 {}, time {})", g.u8(ctrl + 0xe00), k + 1);
+        }
+    })
+}
+
+/// How far the aim's target pitch moves on each update of the aim while the stick is held.
+const AIM_STEP: i32 = 0x90;
+
