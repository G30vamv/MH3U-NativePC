diff --git a/crates/mh3u-rt/src/logstamp.rs b/crates/mh3u-rt/src/logstamp.rs
new file mode 100644
index 0000000..12ed2cb
--- /dev/null
+++ b/crates/mh3u-rt/src/logstamp.rs
@@ -0,0 +1,108 @@
+//! The time at the start of every line the game prints, so a log can be set beside the server's (`[14:03:22.481] [gfx frames] ...`).
+//!
+//! On Windows the process's standard output and error are pointed at a pipe of our own; a thread reads it line by line and writes each
+//! line, with the local time, to what they were before (the launcher's log file). `MH3U_LOG_TIME=off` leaves the log as it was; nothing is
+//! changed when the output is a console. Whoever ends the process on purpose calls [`drain`] first, so the last lines are not lost.
+
+#[cfg(windows)]
+mod imp {
+    use std::io::{BufRead, BufReader, IsTerminal, Write};
+    use std::os::windows::io::FromRawHandle;
+    use std::sync::atomic::{AtomicU32, Ordering};
+    use std::time::{Duration, Instant};
+
+    use windows_sys::Win32::Foundation::INVALID_HANDLE_VALUE;
+    use windows_sys::Win32::System::Console::{GetStdHandle, STD_ERROR_HANDLE, STD_OUTPUT_HANDLE, SetStdHandle};
+    use windows_sys::Win32::System::Pipes::CreatePipe;
+    use windows_sys::Win32::System::SystemInformation::GetLocalTime;
+
+    /// A line only the pump understands: when it has been read, every line before it is already written.
+    const MARK: &[u8] = b"\x01drain\n";
+    static ASKED: AtomicU32 = AtomicU32::new(0);
+    static ANSWERED: AtomicU32 = AtomicU32::new(0);
+    static ON: AtomicU32 = AtomicU32::new(0);
+
+    pub fn install() {
+        if std::env::var("MH3U_LOG_TIME").is_ok_and(|v| v.eq_ignore_ascii_case("off")) || std::io::stderr().is_terminal() {
+            return;
+        }
+        // SAFETY: plain Win32 calls; the handles made here are handed to the pump thread or leaked on purpose (they live as long as the process)
+        unsafe {
+            let before = GetStdHandle(STD_ERROR_HANDLE);
+            if before.is_null() || before == INVALID_HANDLE_VALUE {
+                return;
+            }
+            let (mut read, mut write) = (std::ptr::null_mut(), std::ptr::null_mut());
+            if CreatePipe(&mut read, &mut write, std::ptr::null(), 1 << 20) == 0 {
+                return;
+            }
+            let reader = std::fs::File::from_raw_handle(read as _);
+            let sink = std::fs::File::from_raw_handle(before as _);
+            if std::thread::Builder::new().name("log-time".into()).spawn(move || pump(reader, sink)).is_err() {
+                return;
+            }
+            SetStdHandle(STD_ERROR_HANDLE, write);
+            SetStdHandle(STD_OUTPUT_HANDLE, write);
+        }
+        ON.store(1, Ordering::SeqCst);
+        let hook = std::panic::take_hook();
+        std::panic::set_hook(Box::new(move |info| {
+            hook(info);
+            drain();
+        }));
+    }
+
+    fn pump(reader: std::fs::File, mut sink: std::fs::File) {
+        let mut reader = BufReader::with_capacity(1 << 16, reader);
+        let (mut line, mut out) = (Vec::with_capacity(512), Vec::with_capacity(600));
+        loop {
+            line.clear();
+            match reader.read_until(b'\n', &mut line) {
+                Ok(0) | Err(_) => return,
+                Ok(_) => {}
+            }
+            if line == MARK {
+                ANSWERED.fetch_add(1, Ordering::SeqCst);
+                continue;
+            }
+            out.clear();
+            stamp(&mut out);
+            out.extend_from_slice(&line);
+            let _ = sink.write_all(&out);
+        }
+    }
+
+    fn stamp(out: &mut Vec<u8>) {
+        // SAFETY: GetLocalTime only fills the struct it is given
+        let t = unsafe {
+            let mut t = std::mem::zeroed();
+            GetLocalTime(&mut t);
+            t
+        };
+        let _ = write!(out, "[{:02}:{:02}:{:02}.{:03}] ", t.wHour, t.wMinute, t.wSecond, t.wMilliseconds);
+    }
+
+    /// Waits (at most 300 ms) until everything printed so far is in the log.
+    pub fn drain() {
+        if ON.load(Ordering::SeqCst) == 0 {
+            return;
+        }
+        let me = ASKED.fetch_add(1, Ordering::SeqCst) + 1;
+        let _ = std::io::stderr().write_all(MARK);
+        let start = Instant::now();
+        while ANSWERED.load(Ordering::SeqCst) < me && start.elapsed() < Duration::from_millis(300) {
+            std::thread::sleep(Duration::from_millis(1));
+        }
+    }
+}
+
+#[cfg(windows)]
+pub use imp::{drain, install};
+
+/// Not done off Windows.
+#[cfg(not(windows))]
+pub fn install() {}
+
+/// Not needed off Windows.
+#[cfg(not(windows))]
+pub fn drain() {}
