-//! Game events from translation-time hooks (`docs/hooks.md`) for the overlay: the hooks' callbacks only queue an event (no memory
-//! reads besides their registers), and the overlay reads the live save again when events come, instead of every frame.
-
-use mh3u_rt::hooks::{Hook, Registry};
-use std::collections::VecDeque;
-use std::sync::Mutex;
-use std::sync::atomic::{AtomicBool, Ordering::Relaxed};
-use std::time::{Duration, Instant};
-
-#[derive(Debug, Clone, Copy, PartialEq, Eq)]
-pub enum Dest {
-    Pouch,
-    Box,
-    Unknown,
-}
-
-#[derive(Debug, Clone, Copy, PartialEq, Eq)]
-pub enum Event {
-    ItemGain {
-        item: u16,
-        to: Dest,
-    },
-    /// An item used from the pouch: `item_to_pouch` with a negative count (run 39: r4 = item, r5 = -1, from lr 0x285edac).
-    ItemUse {
-        item: u16,
-        count: u32,
-    },
-    PouchRemove,
-    /// `menu_open` with r5 = -1 (run 41): a menu opened (the item menu or the main one).
-    MenuOpen,
-    /// `menu_page` with r4 = 3 (run 41): the item menu opened.
-    ItemMenu,
-    Money(i32),
-    Craft {
-        jewel: bool,
-    },
-    QuestEnd,
-}
-
-/// Where `item_gain` puts the item, by its return address (runs 30, 31, 33).
-pub fn dest_of(lr: u32) -> Dest {
-    match lr {
-        0x0219_b080 => Dest::Pouch,
-        0x0219_950c | 0x0219_9574 => Dest::Box,
-        _ => Dest::Unknown,
-    }
-}
-
-const MOST_QUEUED: usize = 64;
-static QUEUE: Mutex<VecDeque<Event>> = Mutex::new(VecDeque::new());
-/// Whether any of the overlay's hooks is in the build (then the save is read on events and every 2 s; else every frame).
-static HOOKED: AtomicBool = AtomicBool::new(false);
-/// Set by an `item_to_pouch` that takes items out: the `item_gain` it calls next (lr 0x219b080) is that use, not a gain.
-static USING: AtomicBool = AtomicBool::new(false);
-
-pub fn push(e: Event) {
-    let mut q = QUEUE.lock().unwrap_or_else(|p| p.into_inner());
-    if q.len() == MOST_QUEUED {
-        q.pop_front();
-    }
-    q.push_back(e);
-}
-
-pub fn drain() -> Vec<Event> {
-    QUEUE.lock().unwrap_or_else(|p| p.into_inner()).drain(..).collect()
-}
-
-pub fn hooked() -> bool {
-    HOOKED.load(Relaxed)
-}
-
-/// Registers the overlay's callbacks on the hooks the build has; gives how many were registered.
-pub fn register(r: &mut Registry) -> usize {
-    let mut n = 0;
-    n += usize::from(r.on(
-        "item_gain",
-        Box::new(|h: &mut Hook| {
-            if let Some(e) = item_gain(h.ctx.r[5], h.ctx.lr) {
-                push(e);
-            }
-        }),
-    ));
-    n += usize::from(r.on(
-        "item_to_pouch",
-        Box::new(|h: &mut Hook| {
-            if let Some(e) = item_to_pouch(h.ctx.r[4], h.ctx.r[5]) {
-                push(e);
-            }
-        }),
-    ));
-    n += usize::from(r.on(
-        "menu_open",
-        Box::new(|h: &mut Hook| {
-            if let Some(e) = menu_open(h.ctx.r[5], h.ctx.lr) {
-                push(e);
-            }
-        }),
-    ));
-    n += usize::from(r.on(
-        "menu_page",
-        Box::new(|h: &mut Hook| {
-            if let Some(e) = menu_page(h.ctx.r[4]) {
-                push(e);
-            }
-        }),
-    ));
-    let mut on = |name: &str, f: fn(&Hook) -> Event| {
-        n += usize::from(r.on(name, Box::new(move |h: &mut Hook| push(f(h)))));
-    };
-    on("pouch_remove_slot", |_| Event::PouchRemove);
-    on("money_add", |h| Event::Money(h.ctx.r[4] as i32));
-    on("craft_equipment", |_| Event::Craft { jewel: false });
-    on("craft_jewel", |_| Event::Craft { jewel: true });
-    on("quest_end", |_| Event::QuestEnd);
-    HOOKED.store(n > 0, Relaxed);
-    n
-}
-
-/// `item_to_pouch(save, item, count)`: a negative count is an item used; a positive one is left to `item_gain`.
-fn item_to_pouch(item: u32, count: u32) -> Option<Event> {
-    let count = count as i32;
-    if count >= 0 {
-        return None;
-    }
-    USING.store(true, Relaxed);
-    Some(Event::ItemUse {
-        item: item as u16,
-        count: count.unsigned_abs(),
-    })
-}
-
-/// `item_gain(save, pouch, item)`: a gain, unless the `item_to_pouch` just before it was taking items out.
-fn item_gain(item: u32, lr: u32) -> Option<Event> {
-    let to = dest_of(lr);
-    if to == Dest::Pouch && USING.swap(false, Relaxed) {
-        return None;
-    }
-    Some(Event::ItemGain { item: item as u16, to })
-}
-
-/// `menu_open`: an open is r5 = -1 from lr 0x21546fc (run 41); its other calls (each frame of a change) are not.
-fn menu_open(r5: u32, lr: u32) -> Option<Event> {
-    (r5 == u32::MAX && lr == 0x0215_46fc).then_some(Event::MenuOpen)
-}
-
-/// `menu_page`: page 3 is the item menu (run 41).
-fn menu_page(r4: u32) -> Option<Event> {
-    (r4 == 3).then_some(Event::ItemMenu)
-}
-
-/// A line for the overlay's event feed.
-pub fn describe(e: &Event, item_name: &dyn Fn(u16) -> String) -> Option<String> {
-    Some(match *e {
-        Event::ItemGain { item, to } => format!(
-            "+ {} {}",
-            item_name(item),
-            match to {
-                Dest::Pouch => "-> pouch",
-                Dest::Box => "-> box",
-                Dest::Unknown => "",
-            }
-        )
-        .trim_end()
-        .to_string(),
-        Event::ItemUse { item, count } => {
-            if count == 1 {
-                format!("- {} used", item_name(item))
-            } else {
-                format!("- {} x{count} used", item_name(item))
-            }
-        }
-        Event::MenuOpen => "menu opened".into(),
-        Event::ItemMenu => "item menu opened".into(),
-        Event::PouchRemove => "a pouch item went to the box".into(),
-        Event::Money(d) => format!("{d:+}z"),
-        Event::Craft { jewel: true } => "crafted a jewel".into(),
-        Event::Craft { jewel: false } => "crafted equipment".into(),
-        Event::QuestEnd => "quest over".into(),
-    })
-}
