-/// The page after a left (`0x4`) or right (`0x8`) press, wrapping.
-pub fn turn_page(page: usize, pages: usize, turn: u32) -> usize {
-    let pages = pages.max(1);
-    if turn & 0x4 != 0 {
-        (page + pages - 1) % pages
-    } else if turn & 0x8 != 0 {
-        (page + 1) % pages
-    } else {
-        page % pages
-    }
-}
