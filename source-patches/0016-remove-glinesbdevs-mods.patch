-/// Says why the probe is off when it was asked for but the build has no hooks list (`hooks.txt` in the build folder).
-pub fn no_hooks() {
-    if enabled() {
-        eprintln!("[menu-probe] off: the build has no hooks (translate again: win-build.ps1 -Translate)");
-    }
-}
