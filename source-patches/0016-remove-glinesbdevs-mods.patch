-            .enumerate()
-            .filter(|&(_, &n)| n > 0)
-            .max_by_key(|&(i, &n)| (n, std::cmp::Reverse(i)))
-            .map(|(i, &n)| (WEAPON_USAGE_KINDS[i], n))
-    }
-
-    pub fn play_time(&self) -> String {
