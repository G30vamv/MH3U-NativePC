-/// Puts the game's label back if it was replaced.
-fn restore(g: &crate::guest::Guest, st: &mut State) {
-    if let Some((field, original)) = st.replaced.take() {
-        if g.u32(field) == LABEL_AT {
-            g.put_u32(field, original);
-        }
