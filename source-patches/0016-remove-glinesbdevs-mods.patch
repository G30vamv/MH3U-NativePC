-    g.put_u16(s + 0x234, 0);
-    g.put_u16(s + 0x236, 0);
-    g.put_u16(s + 0x238, 0xffff);
-    g.put_u16(s + 0x23a, 0xffff);
-    g.write(s + 0x245, &[0]);
-    g.write(s + 0x24b, &[0]);
