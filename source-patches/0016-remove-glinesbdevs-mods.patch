-//! The blacksmith wishlist: pieces of armour and weapons the player wants, what each needs against what the item box and pouch hold,
-//! a shopping list of everything together, and the pieces that just became craftable (for a notice). Each hunter has a list of their
-//! own, kept in `wishlists/<hunter>.json` (see `for_hunter`).
-
-use serde::{Deserialize, Serialize};
-use std::collections::{BTreeMap, HashSet};
-use std::path::{Path, PathBuf};
-
-/// A piece: the equipment kind (the save's kind byte) and its id.
-#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord, Serialize, Deserialize)]
-pub struct Piece {
-    pub kind: u8,
-    pub id: u16,
-}
-
-#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
-pub struct Wishlist {
-    pub pieces: Vec<Piece>,
-}
-
-/// One material of a piece, or of the shopping list.
-#[derive(Debug, Clone, Copy, PartialEq, Eq)]
-pub struct Need {
-    pub item: u16,
-    pub need: u32,
-    pub have: u32,
-}
-
-impl Need {
-    pub fn missing(&self) -> u32 {
-        self.need.saturating_sub(self.have)
-    }
-}
-
-#[derive(Debug, Clone, PartialEq, Eq)]
-pub struct Status {
-    pub piece: Piece,
-    pub materials: Vec<Need>,
-    /// Every material is there (each piece on its own: two pieces that share a material may not both be).
-    pub craftable: bool,
-}
-
-impl Wishlist {
-    /// Adds a piece (once).
-    pub fn add(&mut self, piece: Piece) -> bool {
-        let new = !self.pieces.contains(&piece);
-        if new {
-            self.pieces.push(piece);
-        }
-        new
-    }
-
-    pub fn remove(&mut self, piece: Piece) {
-        self.pieces.retain(|p| *p != piece);
-    }
-
-    /// Each piece's materials, from `materials(piece)` (item, count), against `have(item)`. Pieces with no recipe are left out.
-    pub fn status(&self, materials: impl Fn(Piece) -> Option<Vec<(u16, u16)>>, have: impl Fn(u16) -> u32) -> Vec<Status> {
-        self.pieces
-            .iter()
-            .filter_map(|&piece| {
-                let list: Vec<Need> = materials(piece)?
-                    .into_iter()
-                    .map(|(item, count)| Need {
-                        item,
-                        need: u32::from(count),
-                        have: have(item),
-                    })
-                    .collect();
-                let craftable = list.iter().all(|n| n.missing() == 0);
-                Some(Status {
-                    piece,
-                    materials: list,
-                    craftable,
-                })
-            })
-            .collect()
-    }
-
-    /// Everything the pieces need together, by item: what they need in all against what there is.
-    pub fn shopping(statuses: &[Status]) -> Vec<Need> {
-        let mut all: BTreeMap<u16, Need> = BTreeMap::new();
-        for n in statuses.iter().flat_map(|s| &s.materials) {
-            all.entry(n.item)
-                .or_insert(Need {
-                    item: n.item,
-                    need: 0,
-                    have: n.have,
-                })
-                .need += n.need;
-        }
-        all.into_values().collect()
-    }
-
-    pub fn load(path: &Path) -> Wishlist {
-        std::fs::read_to_string(path)
-            .ok()
-            .and_then(|t| serde_json::from_str(&t).ok())
-            .unwrap_or_default()
-    }
-
-    /// Writes the list (through a file beside it, so a crash never leaves half a file).
-    pub fn save(&self, path: &Path) -> std::io::Result<()> {
-        if let Some(dir) = path.parent() {
-            std::fs::create_dir_all(dir)?;
-        }
-        let tmp = path.with_extension("json.tmp");
-        std::fs::write(&tmp, serde_json::to_string_pretty(self).map_err(std::io::Error::other)?)?;
-        std::fs::rename(&tmp, path)
-    }
-}
-
-/// The file of a hunter's wishlist in `dir`: `wishlists/<name>.json`, the name with anything but ASCII letters, digits, `-` and `_`
-/// written as `~` and its UTF-8 bytes in hex (so two names never share a file, and any name is a file name on Windows).
-pub fn path_for(dir: &Path, hunter: &str) -> PathBuf {
-    let mut key = String::new();
-    for c in hunter.chars() {
-        if c.is_ascii_alphanumeric() || c == '-' || c == '_' {
-            key.push(c);
-        } else {
-            let mut buf = [0; 4];
-            for b in c.encode_utf8(&mut buf).bytes() {
-                key.push_str(&format!("~{b:02x}"));
-            }
-        }
-    }
-    if key.is_empty() {
-        key.push('~');
-    }
-    dir.join("wishlists").join(format!("{key}.json"))
-}
-
-/// The one list of before there was a list per hunter.
-pub fn legacy_path(dir: &Path) -> PathBuf {
-    dir.join("wishlist.json")
-}
-
-/// A hunter's wishlist and its file. A hunter with no file yet takes over the old shared `wishlist.json` (the first hunter loaded
-/// after the update gets it; it is renamed `wishlist.json.migrated` so no other hunter does).
-pub fn for_hunter(dir: &Path, hunter: &str) -> (Wishlist, PathBuf) {
-    let path = path_for(dir, hunter);
-    if path.exists() {
-        return (Wishlist::load(&path), path);
-    }
-    let legacy = legacy_path(dir);
-    if legacy.exists() {
-        let list = Wishlist::load(&legacy);
-        if list.save(&path).is_ok() {
-            let _ = std::fs::rename(&legacy, legacy.with_extension("json.migrated"));
-            return (list, path);
-        }
-    }
-    (Wishlist::default(), path)
-}
-
-/// Whether any hunter has a non-empty wishlist kept (or the old shared one is still there): then the live save is looked for even
-/// with the overlay closed, for the notices and the native pages.
-pub fn any_kept(dir: &Path) -> bool {
-    let legacy = legacy_path(dir);
-    if legacy.exists() && !Wishlist::load(&legacy).pieces.is_empty() {
-        return true;
-    }
-    std::fs::read_dir(dir.join("wishlists")).is_ok_and(|entries| {
-        entries
-            .flatten()
-            .any(|e| e.path().extension().is_some_and(|x| x == "json") && !Wishlist::load(&e.path()).pieces.is_empty())
-    })
-}
-
-/// Which pieces are craftable, to tell which just became so. The first look (and the first after the save went away) only takes note.
-#[derive(Default)]
-pub struct Craftable {
-    seen: Option<HashSet<Piece>>,
-}
-
-impl Craftable {
-    /// The pieces craftable now that were not at the last look.
-    pub fn update(&mut self, statuses: &[Status]) -> Vec<Piece> {
-        let now: HashSet<Piece> = statuses.iter().filter(|s| s.craftable).map(|s| s.piece).collect();
-        let new = match &self.seen {
-            Some(before) => statuses
-                .iter()
-                .map(|s| s.piece)
-                .filter(|p| now.contains(p) && !before.contains(p))
-                .collect(),
-            None => Vec::new(),
-        };
-        self.seen = Some(now);
-        new
-    }
-
-    /// The save is gone (no hunter loaded): the next look starts afresh.
-    pub fn forget(&mut self) {
-        self.seen = None;
-    }
-}
