-    let row = (g.u16(s + 0x1ea) as usize).min(PAGE_LINES - 1);
-    let hovered = entries.as_ref().and_then(|e| e.get(page.page * PAGE_LINES + row)).cloned();
-    page.hovered = hovered;
-}
