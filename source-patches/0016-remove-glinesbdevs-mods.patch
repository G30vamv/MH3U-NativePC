-            let room = DESC_WIDTH.saturating_sub(count.len() + 1).max(1);
-            let name: String = m.name.chars().take(room).collect();
-            format!("{name}{}{count}", " ".repeat(DESC_WIDTH - name.chars().count() - count.len()))
-        })
