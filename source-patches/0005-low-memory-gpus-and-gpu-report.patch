 /// The bytes of the vertex streams that have buffers of their own.
+/// Set for an integrated GPU (it shares memory with the system), so the buffer caches stay small there.
+pub(crate) static SMALL_GPU: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+/// Set when the device ran out of memory: the next `prune` drops the buffer caches (their buffers may be invalid).
+pub(crate) static OUT_OF_MEMORY: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+fn stream_cap() -> u64 {
+    if SMALL_GPU.load(std::sync::atomic::Ordering::Relaxed) { 128 << 20 } else { 1 << 30 }
+}
+
+fn index_cap() -> u64 {
+    if SMALL_GPU.load(std::sync::atomic::Ordering::Relaxed) { 32 << 20 } else { 256 << 20 }
+}
+
 fn own_stream_bytes(streams: &HashMap<(u64, u64), StreamEntry>) -> u64 {
     streams.values().filter(|e| e.own.is_some()).map(|e| e.size).sum()
 }
