diff --git a/crates/mh3u-rt/src/itembox.rs b/crates/mh3u-rt/src/itembox.rs
new file mode 100644
index 0000000..4e447c9
--- /dev/null
+++ b/crates/mh3u-rt/src/itembox.rs
@@ -0,0 +1,310 @@
+//! Adds an item the player picks to the item box (the overlay's item list asks, `request`).
+//!
+//! The box is `sUserData` (the singleton whose pointer is at `USER`) + 0x1c0: 1000 slots of two big-endian u16, the item and how many
+//! (at most 99). What the game does to put an item in it is `f_02199474(save, box, slots, item, count, &slot)`: it fills the stacks of
+//! that item first and then the first empty slots, and answers what did not fit (read with Ghidra, `docs/ghidra.md`). The same is done
+//! here on the memory, by the game's thread, from a hook that runs every frame in the scenes with a hunter (`bloom_draw`): nothing
+//! else touches the box at that moment. Which items there are comes from the game's own text (`GUI\font\Item00_<lang>`, the item
+//! number is the line number; read from the player's files when the list is first opened, nothing of it is kept in the program).
+//!
+//! The game's own check of an item number (`f_02199408`) lets through 2..=0x4da and 0x4df..=0x5fc except 0x5f3. This does not
+//! mark the item as seen in the Hunter's Notes (that is `itemGain_`, not called here).
+
+use crate::guest::Guest;
+use crate::hooks::{Hook, Registry};
+use std::path::PathBuf;
+use std::sync::{Mutex, OnceLock};
+
+/// `sUserData::mpInstance`.
+pub const USER: u32 = 0x1031_5f50;
+/// The box inside it.
+const BOX: u32 = 0x1c0;
+const SLOTS: usize = 1000;
+/// The most of one item in a slot.
+pub const STACK: u16 = 99;
+/// The last item number the game has.
+pub const LAST_ITEM: u32 = 0x5fc;
+
+/// Whether the game accepts `item` as an item to put in the box.
+pub fn valid(item: u32) -> bool {
+    item > 1 && item <= LAST_ITEM && (item < 0x4db || (item > 0x4de && item != 0x5f3))
+}
+
+/// What came of a request.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Outcome {
+    Added {
+        item: u16,
+        count: u16,
+    },
+    /// Some went in; `left` did not fit.
+    Partial {
+        item: u16,
+        added: u16,
+        left: u16,
+    },
+    Full {
+        item: u16,
+    },
+    Invalid {
+        item: u16,
+    },
+    /// No hunter is playing, or the game's data is not there yet.
+    NotReady {
+        item: u16,
+    },
+}
+
+static REQUESTS: Mutex<Vec<(u16, u16)>> = Mutex::new(Vec::new());
+static RESULTS: Mutex<Vec<Outcome>> = Mutex::new(Vec::new());
+static CONTENT: Mutex<Vec<PathBuf>> = Mutex::new(Vec::new());
+static NAMES: [OnceLock<Vec<(u16, String)>>; 2] = [OnceLock::new(), OnceLock::new()];
+
+fn lock<T>(m: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
+    m.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// The folders the game's files are in (set when the game starts).
+pub fn set_content(roots: Vec<PathBuf>) {
+    *lock(&CONTENT) = roots;
+}
+
+/// Every item with a name, as (number, name), in number order: English or Spanish (`spanish`). Empty when the game's text cannot be read.
+pub fn names(spanish: bool) -> &'static [(u16, String)] {
+    NAMES[usize::from(spanish)]
+        .get_or_init(|| load_names(if spanish { "spa" } else { "eng" }))
+        .as_slice()
+}
+
+fn load_names(lang: &str) -> Vec<(u16, String)> {
+    let roots = lock(&CONTENT).clone();
+    for root in roots {
+        let path = ["nativeCafe", "nativecafe"]
+            .iter()
+            .map(|d| root.join(d).join("arc").join("ID").join(format!("ID_cock_{lang}.arc")))
+            .find(|p| p.is_file());
+        let Some(path) = path else { continue };
+        match read_names(&path, lang) {
+            Ok(list) => {
+                eprintln!("[itembox] {} item names read ({lang})", list.len());
+                return list;
+            }
+            Err(e) => eprintln!("[itembox] the item names could not be read from {}: {e:#}", path.display()),
+        }
+    }
+    eprintln!("[itembox] the game's item names were not found ({lang})");
+    Vec::new()
+}
+
+fn read_names(path: &std::path::Path, lang: &str) -> anyhow::Result<Vec<(u16, String)>> {
+    use anyhow::Context;
+    let data = std::fs::read(path)?;
+    let arc = mh3u_formats::arc::Arc::parse(&data)?;
+    let want = format!("item00_{lang}");
+    let entry = arc
+        .entries
+        .iter()
+        .find(|e| e.name.to_ascii_lowercase().ends_with(&want))
+        .context("no item text in the archive")?;
+    let strings = mh3u_formats::gmd::parse(&arc.read(entry)?)?;
+    Ok(list_from(&strings))
+}
+
+/// The usable items of a text table: those the game accepts and that have a name (not "DUMMY", not the placeholder lines).
+pub fn list_from(strings: &[String]) -> Vec<(u16, String)> {
+    strings
+        .iter()
+        .enumerate()
+        .filter(|(i, s)| {
+            let s = s.trim();
+            valid(*i as u32) && !s.is_empty() && !s.starts_with("DUMMY") && s != "(None)" && !s.starts_with('－') && !s.starts_with("---")
+        })
+        .map(|(i, s)| (i as u16, s.trim().to_string()))
+        .collect()
+}
+
+static AVAILABLE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+
+/// Whether the mod is there (the launcher's Mods section turns it off with `MH3U_ITEMBOX=off`: then the menu's row is greyed out).
+pub fn available() -> bool {
+    AVAILABLE.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// Asks for `count` (1 to 99) of `item` in the box; the game's thread does it within a frame. The answer comes from `take_results`.
+pub fn request(item: u16, count: u16) {
+    if !available() {
+        return;
+    }
+    lock(&REQUESTS).push((item, count.clamp(1, STACK)));
+}
+
+/// Answers a request at once as "not ready" (the picker knows no hunter is in game, so the game's thread would never see it).
+pub fn reject_not_ready(item: u16) {
+    lock(&RESULTS).push(Outcome::NotReady { item });
+}
+
+pub fn pending() -> bool {
+    !lock(&REQUESTS).is_empty()
+}
+
+pub fn take_results() -> Vec<Outcome> {
+    std::mem::take(&mut *lock(&RESULTS))
+}
+
+/// Puts `count` of `item` in `slots` the way the game does and answers what did not fit.
+pub fn add_to_slots(slots: &mut [(u16, i16)], item: u16, count: u32) -> u32 {
+    let mut left = count;
+    for s in slots.iter_mut() {
+        if s.0 == item && s.1 < i16::from(STACK as u8) {
+            let room = (STACK as i32 - i32::from(s.1)) as u32;
+            if left <= room {
+                s.1 += left as i16;
+                return 0;
+            }
+            s.1 = STACK as i16;
+            left -= room;
+        }
+    }
+    for s in slots.iter_mut() {
+        if s.0 == 0 {
+            s.0 = item;
+            if left < 100 {
+                s.1 = left as i16;
+                return 0;
+            }
+            s.1 = STACK as i16;
+            left -= STACK as u32;
+        }
+    }
+    left
+}
+
+/// Does the pending requests on the guest's memory (the game's thread calls this).
+pub fn apply(g: &Guest) {
+    let requests = std::mem::take(&mut *lock(&REQUESTS));
+    if requests.is_empty() {
+        return;
+    }
+    let user = g.u32(USER);
+    let ready = user != 0 && crate::scene::scene() == crate::scene::Scene::InGame;
+    let mut results = lock(&RESULTS);
+    for (item, count) in requests {
+        if !valid(u32::from(item)) {
+            results.push(Outcome::Invalid { item });
+            continue;
+        }
+        if !ready {
+            results.push(Outcome::NotReady { item });
+            continue;
+        }
+        let base = user.wrapping_add(BOX);
+        let mut slots: Vec<(u16, i16)> = (0..SLOTS as u32)
+            .map(|i| (g.u16(base + 4 * i), g.u16(base + 4 * i + 2) as i16))
+            .collect();
+        let before = slots.clone();
+        let left = add_to_slots(&mut slots, item, u32::from(count));
+        for (i, (new, old)) in slots.iter().zip(&before).enumerate() {
+            if new != old {
+                g.put_u16(base + 4 * i as u32, new.0);
+                g.put_u16(base + 4 * i as u32 + 2, new.1 as u16);
+            }
+        }
+        let added = count - left as u16;
+        let touched: Vec<String> = slots
+            .iter()
+            .zip(&before)
+            .enumerate()
+            .filter(|(_, (n, o))| n != o)
+            .take(3)
+            .map(|(i, (n, o))| format!("slot {i}: {}x{} -> {}x{}", o.0, o.1, n.0, n.1))
+            .collect();
+        eprintln!(
+            "[itembox] item {item}: {added} of {count} put in the box ({left} did not fit) {}",
+            touched.join(", ")
+        );
+        results.push(match (added, left) {
+            (_, 0) => Outcome::Added { item, count },
+            (0, _) => Outcome::Full { item },
+            _ => Outcome::Partial {
+                item,
+                added,
+                left: left as u16,
+            },
+        });
+    }
+}
+
+/// Registers the callback (on the hook that runs every frame in the scenes with a hunter).
+pub fn register(r: &mut Registry) {
+    AVAILABLE.store(crate::input::switch_setting(std::env::var("MH3U_ITEMBOX").ok().as_deref(), true), std::sync::atomic::Ordering::Relaxed);
+    let ok = r.on(
+        "bloom_draw",
+        Box::new(|h: &mut Hook| {
+            if pending() {
+                apply(&Guest::new(h.ctx.mem));
+            }
+        }),
+    );
+    if !ok {
+        eprintln!("[itembox] adding items needs the hook bloom_draw: build the game again with the launcher's current mods/hooks.txt");
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_games_own_item_check() {
+        assert!(!valid(0) && !valid(1));
+        assert!(valid(2) && valid(9) && valid(0x4da));
+        assert!(!valid(0x4db) && !valid(0x4de));
+        assert!(valid(0x4df) && valid(0x5f2) && !valid(0x5f3) && valid(0x5f4) && valid(0x5fc) && !valid(0x5fd));
+    }
+
+    #[test]
+    fn stacks_fill_before_empty_slots_and_cap_at_99() {
+        let mut slots = vec![(0u16, 0i16); 5];
+        slots[1] = (9, 90);
+        slots[3] = (9, 98);
+        // 20 more: 9 into the first stack, 1 into the next, 10 into the first empty slot
+        assert_eq!(add_to_slots(&mut slots, 9, 20), 0);
+        assert_eq!(slots, vec![(9, 10), (9, 99), (0, 0), (9, 99), (0, 0)]);
+    }
+
+    #[test]
+    fn a_full_box_answers_what_did_not_fit() {
+        let mut slots = vec![(5u16, 99i16); 3];
+        assert_eq!(add_to_slots(&mut slots, 9, 7), 7);
+        let mut slots = vec![(5u16, 99i16), (0, 0)];
+        assert_eq!(add_to_slots(&mut slots, 9, 99), 0);
+        assert_eq!(add_to_slots(&mut slots, 9, 1), 1);
+    }
+
+    #[test]
+    fn the_list_leaves_out_what_the_game_does_not_offer() {
+        let mut strings: Vec<String> = vec![
+            "－－－－－－".into(),
+            "(None)".into(),
+            "Book".into(),
+            "DUMMY 1".into(),
+            "Potion".into(),
+        ];
+        strings.resize(0x5fd, String::new());
+        let list = list_from(&strings);
+        assert_eq!(list, vec![(2, "Book".to_string()), (4, "Potion".to_string())]);
+    }
+
+    /// Reads the real names from the player's dump (`cargo test -p mh3u-rt itembox -- --ignored` with `MH3U_TEST_CONTENT` set).
+    #[test]
+    #[ignore]
+    fn the_real_names_are_read() {
+        let content = std::env::var("MH3U_TEST_CONTENT").expect("MH3U_TEST_CONTENT");
+        set_content(vec![content.into()]);
+        let en = names(false);
+        let es = names(true);
+        assert!(en.len() > 1000 && es.len() > 1000, "{} {}", en.len(), es.len());
+        assert!(en.iter().any(|(i, n)| *i == 9 && n == "Potion"));
+        eprintln!("{:?} {:?}", &en[..3], &es[..3]);
+    }
+}
