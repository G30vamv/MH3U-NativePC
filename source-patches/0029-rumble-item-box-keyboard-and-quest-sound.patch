+fn ps_step(now: (f32, f32), target: (f32, f32), dt: f32) -> (f32, f32) {
+    let fall = dt / PS_RELEASE_SECS;
+    (target.0.max(now.0 - fall).max(0.0), target.1.max(now.1 - fall).max(0.0))
