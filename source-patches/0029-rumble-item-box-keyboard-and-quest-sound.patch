+/// What the PlayStation pad's motors are asked now (0 to 1 each) for the levels of the pattern (0 to 65535) and the pad's percent.
+fn ps_target(low: u16, high: u16, percent: u32) -> (f32, f32) {
+    let gain = percent as f32 / 100.0;
+    ((f32::from(low) / 65535.0 * gain).min(1.0), (f32::from(high) / 65535.0 * gain * PS_SMALL_MOTOR).min(1.0))
+}
