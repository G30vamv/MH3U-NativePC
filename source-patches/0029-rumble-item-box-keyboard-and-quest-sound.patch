+// ---- the on-screen keyboard ----
+
+/// What the mouse did on the keyboard.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OskAct {
+    /// The pointer moved onto a key (row, column).
+    Hover(usize, usize),
+    Click(usize, usize),
+}
+
+/// Where the keyboard's parts are: the panel (low on the screen, so the game's own field stays in sight above it), the text field and the keys.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct OskLayout {
+    pub panel: Rect,
+    pub u: f32,
+    pub title: Rect,
+    pub field: Rect,
+    pub keys: Rect,
+    pub hints: Rect,
+}
+
+/// The height of the panel in units, from the top edge to the bottom one.
+const OSK_UNITS: f32 = 600.0;
+const OSK_KEY_ROWS: usize = 5;
+
+pub fn osk_layout(screen: Rect) -> OskLayout {
+    // a fifth smaller than the menu's size: the keyboard leaves most of the game in view
+    let u = (screen.width() * 0.74 * 0.8 / 1000.0).min(screen.height() * 0.93 * 0.8 / OSK_UNITS).max(0.2);
+    let panel_w = 1000.0 * u;
+    let panel_h = OSK_UNITS * u;
+    let bottom = screen.bottom() - (screen.height() * 0.03).min(40.0 * u);
+    let panel = Rect::from_min_max(
+        Pos2::new(screen.center().x - panel_w / 2.0, (bottom - panel_h).max(screen.top())),
+        Pos2::new(screen.center().x + panel_w / 2.0, bottom),
+    );
+    let inner = panel.shrink2(vec2(34.0 * u, 26.0 * u));
+    let title = Rect::from_min_size(inner.min, vec2(inner.width(), 46.0 * u));
+    let field = Rect::from_min_size(title.left_bottom() + vec2(0.0, 12.0 * u), vec2(inner.width(), 80.0 * u));
+    let hints = Rect::from_min_max(Pos2::new(inner.left(), inner.bottom() - 30.0 * u), inner.right_bottom());
+    let keys = Rect::from_min_max(Pos2::new(inner.left(), field.bottom() + 20.0 * u), Pos2::new(inner.right(), hints.top() - 14.0 * u));
+    OskLayout { panel, u, title, field, keys, hints }
+}
+
+/// The rectangle of each key of the keyboard, by row and column.
+pub fn osk_key_rects(l: &OskLayout, rows: &[Vec<crate::osk::Key>]) -> Vec<Vec<Rect>> {
+    let gap = 8.0 * l.u;
+    let key_h = (l.keys.height() - gap * (OSK_KEY_ROWS as f32 - 1.0)) / OSK_KEY_ROWS as f32;
+    rows.iter()
+        .enumerate()
+        .map(|(r, row)| {
+            let units: f32 = row.iter().map(|k| k.width()).sum();
+            let unit_w = (l.keys.width() - gap * (row.len() as f32 - 1.0)) / units;
+            let mut x = l.keys.left();
+            row.iter()
+                .map(|k| {
+                    let w = unit_w * k.width();
+                    let rect = Rect::from_min_size(Pos2::new(x, l.keys.top() + r as f32 * (key_h + gap)), vec2(w, key_h));
+                    x += w + gap;
+                    rect
+                })
+                .collect()
+        })
+        .collect()
+}
+
+/// Draws the keyboard over the dimmed game and reports what the mouse did. `caret` is whether the text's blinking bar is on;
+/// `moved` whether the pointer moved this frame (the marked key follows it only then, so a still pointer does not hold the pad's mark).
+pub fn keyboard(ctx: &egui::Context, osk: &crate::osk::Osk, lang: Lang, fade: f32, caret: bool, moved: bool) -> Vec<OskAct> {
+    use crate::osk::{Key, Page};
+    let screen = ctx.content_rect();
+    let l = osk_layout(screen);
+    let u = l.u;
+    let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Tooltip, egui::Id::new("mh3u_keyboard")));
+    let (pointer, pressed) = ctx.input(|i| (i.pointer.hover_pos(), i.pointer.primary_pressed()));
+    let mut acts = Vec::new();
+
+    painter.rect_filled(screen, 0.0, Color32::from_black_alpha((120.0 * fade) as u8));
+    backdrop(&painter, &Layout { panel: l.panel, u, header: l.title, tabs: l.title, rows: l.keys, row_h: 0.0, help: l.hints, keys: l.hints }, fade);
+
+    // the title and how much of the text is used
+    painter.text(l.title.left_center(), Align2::LEFT_CENTER, lang.p("TYPE THE TEXT", "ESCRIBE EL TEXTO"), font(27.0 * u), alpha(GOLD, fade));
+    let used = osk.text.chars().count();
+    let count_colour = if used >= osk.limit() { GOLD } else { CREAM };
+    painter.text(l.title.right_center(), Align2::RIGHT_CENTER, format!("{used} / {}", osk.limit()), font(21.0 * u), alpha(count_colour, 0.85 * fade));
+    rule(&painter, l.title.bottom() - 1.0 * u, l.title.left(), l.title.right(), u, fade);
+
+    // the text field: a dark inset with a fine gold edge, the text in the menu's letters and a bar that blinks
+    let field = l.field;
+    gradient_v(&painter, field, alpha(Color32::from_rgb(0x07, 0x12, 0x18), 0.96 * fade), alpha(Color32::from_rgb(0x0c, 0x1e, 0x27), 0.96 * fade));
+    painter.rect_stroke(field, 8.0 * u, Stroke::new(1.8 * u, alpha(GOLD, fade)), egui::StrokeKind::Inside);
+    painter.rect_stroke(field.shrink(5.0 * u), 5.0 * u, Stroke::new(1.0, alpha(BLUE_DEEP, 0.8 * fade)), egui::StrokeKind::Inside);
+    for x in [field.left() + 12.0 * u, field.right() - 12.0 * u] {
+        diamond(&painter, Pos2::new(x, field.center().y), 4.0 * u, alpha(GOLD_DIM, fade), Stroke::NONE);
+    }
+    let inner = field.shrink2(vec2(30.0 * u, 10.0 * u));
+    let clip = painter.with_clip_rect(inner);
+    let bar = |x: f32| {
+        clip.line_segment(
+            [Pos2::new(x, inner.center().y - 18.0 * u), Pos2::new(x, inner.center().y + 18.0 * u)],
+            Stroke::new(2.4 * u, alpha(GOLD, fade)),
+        );
+    };
+    if osk.text.is_empty() {
+        clip.text(
+            inner.left_center() + vec2(8.0 * u, 0.0),
+            Align2::LEFT_CENTER,
+            lang.p("Use the keys, or the keyboard", "Usa las teclas, o el teclado"),
+            font(24.0 * u),
+            alpha(CREAM, 0.30 * fade),
+        );
+        if caret {
+            bar(inner.left());
+        }
+    } else {
+        let galley = painter.layout_no_wrap(osk.text.clone(), FontId::proportional(40.0 * u), alpha(CREAM, fade));
+        // a text longer than the field shows its end
+        let x = if galley.size().x > inner.width() - 8.0 * u { inner.right() - 8.0 * u - galley.size().x } else { inner.left() };
+        let top = Pos2::new(x, inner.center().y - galley.size().y / 2.0);
+        let end = top.x + galley.size().x;
+        clip.galley(top, galley, alpha(CREAM, fade));
+        if caret {
+            bar(end + 3.0 * u);
+        }
+    }
+
+    // the keys
+    let rows = osk.rows();
+    let rects = osk_key_rects(&l, &rows);
+    for (r, row) in rows.iter().enumerate() {
+        for (c, key) in row.iter().enumerate() {
+            let rect = rects[r][c];
+            let hover = pointer.is_some_and(|p| rect.contains(p));
+            if hover && moved {
+                acts.push(OskAct::Hover(r, c));
+            }
+            if hover && pressed {
+                acts.push(OskAct::Click(r, c));
+            }
+            let marked = r == osk.row.min(rows.len() - 1) && c == osk.col.min(row.len() - 1);
+            let lit = match key {
+                Key::Shift => osk.page == Page::Upper,
+                Key::Symbols => osk.page == Page::Symbols,
+                _ => false,
+            };
+            if marked {
+                gradient_v(&painter, rect, alpha(GOLD, fade), alpha(Color32::from_rgb(0xa8, 0x82, 0x3c), fade));
+                painter.rect_stroke(rect, 8.0 * u, Stroke::new(1.2 * u, alpha(INK, fade)), egui::StrokeKind::Inside);
+            } else {
+                let base = match key {
+                    Key::Accept => Color32::from_rgb(0x1c, 0x4a, 0x58),
+                    Key::Cancel | Key::Backspace => Color32::from_rgb(0x26, 0x2a, 0x33),
+                    _ if lit => Color32::from_rgb(0x3a, 0x38, 0x24),
+                    _ => Color32::from_rgb(0x15, 0x2e, 0x3a),
+                };
+                let fill = if hover { Color32::from_rgb(0x24, 0x44, 0x52) } else { base };
+                painter.rect_filled(rect, 8.0 * u, alpha(fill, 0.98 * fade));
+                let edge = if lit || matches!(key, Key::Accept) { GOLD } else { GOLD_DIM };
+                painter.rect_stroke(rect, 8.0 * u, Stroke::new(if lit { 1.8 * u } else { 1.0 }, alpha(edge, fade)), egui::StrokeKind::Inside);
+            }
+            let colour = if marked { INK } else if lit || matches!(key, Key::Accept) { GOLD } else { CREAM };
+            let size = if matches!(key, Key::Char(_)) { 31.0 * u } else { 19.0 * u };
+            // the menu's typeface draws a lower case letter as a small capital: the lower case keys use the plain font so they read as lower case
+            let face = match key {
+                Key::Char(c) if c.is_alphabetic() && c.is_lowercase() => FontId::proportional(size * 1.08),
+                _ => font(size),
+            };
+            painter.text(rect.center(), Align2::CENTER_CENTER, key.label(lang), face, alpha(colour, fade));
+        }
+    }
+
+    // what each button does
+    let y = l.hints.center().y;
+    let mut x = l.hints.left();
+    for (cap, en, es) in [
+        ("A", "Press", "Pulsar"),
+        ("B", "Delete", "Borrar"),
+        ("X", "Space", "Espacio"),
+        ("Y", "Shift", "Mayús"),
+        ("L/R", "Symbols", "Símbolos"),
+        ("START", "OK", "Aceptar"),
+        ("SELECT", "Cancel", "Cancelar"),
+    ] {
+        x += key_hint(&painter, Pos2::new(x, y), cap, lang.p(en, es), u * 0.86, fade);
+    }
+    acts
+}
+
