+/// Starts the pulses of a pattern (scaled by the strength the player chose); what plays already goes on.
+pub fn pulses(steps: &[Step]) {
+    if !enabled() {
+        return;
+    }
+    let scale = strength() as f32 / 100.0;
+    let now = Instant::now();
+    {
+        let mut list = PULSES.lock().unwrap_or_else(|e| e.into_inner());
+        list.retain(|p| p.until > now);
+        for s in steps {
+            let level = (s.power.clamp(0.0, 1.0) * scale * 65535.0) as u16;
+            let from = now + Duration::from_millis(u64::from(s.delay_ms));
+            let (low, high) = match s.motor {
+                Motor::Low => (level, 0),
+                Motor::High => (0, level),
+                Motor::Both => (level, level),
+            };
+            list.push(Pulse {
+                from,
+                until: from + Duration::from_millis(u64::from(s.ms)),
+                low,
+                high,
+                envelope: false,
+            });
+        }
+    }
+    start();
+}
