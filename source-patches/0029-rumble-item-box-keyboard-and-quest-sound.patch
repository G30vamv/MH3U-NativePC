diff --git a/crates/mh3u-gfx/src/item_picker.rs b/crates/mh3u-gfx/src/item_picker.rs
new file mode 100644
index 0000000..2c0aa5e
--- /dev/null
+++ b/crates/mh3u-gfx/src/item_picker.rs
@@ -0,0 +1,454 @@
+//! The window to pick an item and put it in the item box (`mh3u_rt::itembox` does the putting). A search line, the list of the game's
+//! items (named from the game's own text, in the language of the menu), a quantity and an Add button. It works with the mouse, the
+//! keyboard (type to search; Up and Down; Enter adds; Shift + Up or Down changes the quantity; Esc closes) and the gamepad (the cross or
+//! the left stick move and change the quantity, A adds, B closes, L and R jump to the previous or the next initial letter, Y toggles 1
+//! and 99).
+
+use crate::menu::{Nav, Repeater};
+use crate::settings::Lang;
+use egui::{Color32, RichText};
+use mh3u_rt::itembox::{self, Outcome};
+use std::time::Instant;
+
+const GOLD: Color32 = Color32::from_rgb(0xd9, 0xb2, 0x5f);
+const CREAM: Color32 = Color32::from_rgb(0xe9, 0xdf, 0xc4);
+const BLUE: Color32 = Color32::from_rgb(0x4f, 0xc3, 0xd6);
+const RED: Color32 = Color32::from_rgb(0xe0, 0x6a, 0x5a);
+
+/// The search line's identity (so the keyboard can be taken from it when the window closes).
+pub const SEARCH_ID: &str = "item_picker_search";
+
+pub struct Picker {
+    query: String,
+    /// The indexes into the name list of the items that match the search.
+    shown: Vec<usize>,
+    sel: usize,
+    qty: u16,
+    status: Option<(String, bool)>,
+    scroll_to_sel: bool,
+    waiting: Option<Instant>,
+    first: bool,
+    spanish: bool,
+}
+
+impl Picker {
+    pub fn new(spanish: bool) -> Picker {
+        let mut p = Picker {
+            query: String::new(),
+            shown: Vec::new(),
+            sel: 0,
+            qty: 1,
+            status: None,
+            scroll_to_sel: true,
+            waiting: None,
+            first: true,
+            spanish,
+        };
+        p.refilter();
+        p
+    }
+
+    /// The search line's text.
+    pub fn query(&self) -> &str {
+        &self.query
+    }
+
+    /// Puts a text in the search line (the on-screen keyboard's) and filters by it.
+    pub fn set_query(&mut self, text: &str) {
+        self.query = text.to_string();
+        self.refilter();
+    }
+
+    fn names(&self) -> &'static [(u16, String)] {
+        itembox::names(self.spanish)
+    }
+
+    fn refilter(&mut self) {
+        let names = self.names();
+        let q = self.query.trim().to_lowercase();
+        self.shown = names
+            .iter()
+            .enumerate()
+            .filter(|(_, (id, n))| {
+                q.is_empty() || n.to_lowercase().contains(&q) || (q.chars().all(|c| c.is_ascii_digit()) && id.to_string() == q)
+            })
+            .map(|(i, _)| i)
+            .collect();
+        self.sel = 0;
+        self.scroll_to_sel = true;
+    }
+
+    /// The initial letter of the shown item `i`.
+    fn initial(&self, i: usize) -> Option<char> {
+        self.shown
+            .get(i)
+            .and_then(|k| self.names()[*k].1.chars().next())
+            .map(|c| c.to_ascii_uppercase())
+    }
+
+    /// Does what a press asks. True when the window should close.
+    pub fn handle(&mut self, nav: Nav) -> bool {
+        let last = self.shown.len().saturating_sub(1);
+        match nav {
+            Nav::Up => {
+                self.sel = self.sel.saturating_sub(1);
+                self.scroll_to_sel = true;
+            }
+            Nav::Down => {
+                self.sel = (self.sel + 1).min(last);
+                self.scroll_to_sel = true;
+            }
+            Nav::Left => self.qty = self.qty.saturating_sub(1).max(1),
+            Nav::Right => self.qty = (self.qty + 1).min(itembox::STACK),
+            Nav::Default => self.qty = if self.qty == itembox::STACK { 1 } else { itembox::STACK },
+            Nav::TabNext => {
+                let here = self.initial(self.sel);
+                if let Some(i) = (self.sel + 1..self.shown.len()).find(|i| self.initial(*i) != here) {
+                    self.sel = i;
+                    self.scroll_to_sel = true;
+                }
+            }
+            Nav::TabPrev => {
+                // the start of this letter's run, or, if already there, the start of the previous letter's
+                let here = self.initial(self.sel);
+                let mut i = self.sel;
+                while i > 0 && self.initial(i - 1) == here {
+                    i -= 1;
+                }
+                if i == self.sel && i > 0 {
+                    let before = self.initial(i - 1);
+                    while i > 0 && self.initial(i - 1) == before {
+                        i -= 1;
+                    }
+                }
+                self.sel = i;
+                self.scroll_to_sel = true;
+            }
+            Nav::Accept => self.add(),
+            Nav::Back => return true,
+        }
+        false
+    }
+
+    fn add(&mut self) {
+        let Some(k) = self.shown.get(self.sel) else { return };
+        let (id, _) = self.names()[*k];
+        // with no hunter in game (the title) nothing would answer: say so at once
+        if mh3u_rt::scene::scene() != mh3u_rt::scene::Scene::InGame && std::env::var("MH3U_SCENE_CHECK").is_err() {
+            itembox::reject_not_ready(id);
+            return;
+        }
+        itembox::request(id, self.qty);
+        self.waiting = Some(Instant::now());
+        self.status = None;
+    }
+
+    fn name_of(&self, item: u16) -> String {
+        self.names()
+            .iter()
+            .find(|(id, _)| *id == item)
+            .map_or_else(|| format!("#{item}"), |(_, n)| n.clone())
+    }
+
+    fn take_results(&mut self) {
+        for outcome in itembox::take_results() {
+            let es = self.spanish;
+            let pick = |en: String, sp: String| if es { sp } else { en };
+            let (text, ok) = match outcome {
+                Outcome::Added { item, count } => {
+                    let n = self.name_of(item);
+                    (
+                        pick(format!("{n} x{count} added to the box"), format!("{n} x{count} añadido al baúl")),
+                        true,
+                    )
+                }
+                Outcome::Partial { item, added, left } => {
+                    let n = self.name_of(item);
+                    (
+                        pick(
+                            format!("{n}: {added} added, {left} did not fit"),
+                            format!("{n}: {added} añadidos, {left} no caben"),
+                        ),
+                        true,
+                    )
+                }
+                Outcome::Full { .. } => (pick("The box is full".into(), "El baúl está lleno".into()), false),
+                Outcome::Invalid { .. } => (
+                    pick("The game does not take that item".into(), "El juego no acepta ese objeto".into()),
+                    false,
+                ),
+                Outcome::NotReady { .. } => (
+                    pick(
+                        "Enter the village or the harbour with your hunter first".into(),
+                        "Entra primero en la aldea o el puerto con tu cazador".into(),
+                    ),
+                    false,
+                ),
+            };
+            self.status = Some((text, ok));
+            self.waiting = None;
+        }
+    }
+
+    /// The presses this frame: the keyboard's (typing goes to the search line, so only these keys count), the gamepad's and its cross or stick.
+    pub fn collect(ctx: &egui::Context, presses: Vec<u32>, repeater: &mut Repeater, now: f64, stick: (f32, f32), buttons: u32) -> Vec<Nav> {
+        use mh3u_rt::input::button;
+        let mut navs = Vec::new();
+        ctx.input(|i| {
+            for event in &i.events {
+                if let egui::Event::Key {
+                    key,
+                    pressed: true,
+                    modifiers,
+                    repeat,
+                    ..
+                } = event
+                {
+                    use egui::Key;
+                    let nav = match (key, modifiers.shift) {
+                        (Key::ArrowUp, true) => Some(Nav::Right),
+                        (Key::ArrowDown, true) => Some(Nav::Left),
+                        (Key::ArrowUp, false) => Some(Nav::Up),
+                        (Key::ArrowDown, false) => Some(Nav::Down),
+                        (Key::PageUp, _) => Some(Nav::TabPrev),
+                        (Key::PageDown, _) => Some(Nav::TabNext),
+                        (Key::Enter, _) if !*repeat => Some(Nav::Accept),
+                        (Key::Escape, _) if !*repeat => Some(Nav::Back),
+                        _ => None,
+                    };
+                    navs.extend(nav);
+                }
+            }
+        });
+        for b in presses {
+            match b {
+                button::A => navs.push(Nav::Accept),
+                button::B => navs.push(Nav::Back),
+                button::Y => navs.push(Nav::Default),
+                button::L | button::ZL => navs.push(Nav::TabPrev),
+                button::R | button::ZR => navs.push(Nav::TabNext),
+                _ => {}
+            }
+        }
+        navs.extend(repeater.update(crate::menu::direction(buttons, stick), now));
+        navs
+    }
+
+    /// Draws the window. True when it should close.
+    pub fn ui(&mut self, ctx: &egui::Context, lang: Lang, navs: Vec<Nav>) -> bool {
+        let mut close = false;
+        for nav in navs {
+            close |= self.handle(nav);
+        }
+        self.take_results();
+        let es = lang == Lang::Es;
+        let l = |en: &'static str, sp: &'static str| lang.p(en, sp);
+        let screen = ctx.content_rect();
+        ctx.layer_painter(egui::LayerId::new(egui::Order::Middle, egui::Id::new("picker_dim")))
+            .rect_filled(screen, 0.0, Color32::from_black_alpha(150));
+        let text_size = (screen.height() / 42.0).clamp(14.0, 26.0);
+        let width = (screen.width() * 0.62).clamp(360.0, 900.0);
+        let list_h = (screen.height() * 0.5).clamp(160.0, 560.0);
+        let row_h = text_size * 1.5;
+        let mut clicked: Option<(usize, bool)> = None;
+        let mut typed = false;
+        let mut qty_delta: i32 = 0;
+        let mut add_now = false;
+        let mut close_now = false;
+        egui::Area::new(egui::Id::new("item_picker"))
+            .anchor(egui::Align2::CENTER_CENTER, egui::vec2(0.0, 0.0))
+            .order(egui::Order::Foreground)
+            .show(ctx, |ui| {
+                egui::Frame::popup(ui.style())
+                    .fill(Color32::from_rgba_unmultiplied(0x0a, 0x1a, 0x22, 245))
+                    .stroke(egui::Stroke::new(2.0, GOLD))
+                    .corner_radius(8.0)
+                    .inner_margin(14.0)
+                    .show(ui, |ui| {
+                        ui.set_width(width);
+                        ui.label(
+                            RichText::new(l("Add items to the item box", "Añadir objetos al baúl"))
+                                .font(egui::FontId::new(text_size * 1.5, crate::menu_draw::title_family()))
+                                .color(GOLD),
+                        );
+                        ui.label(
+                            RichText::new(l(
+                                "Changes your save: make a copy of it first if you want to be safe.",
+                                "Cambia tu partida: haz antes una copia si quieres ir seguro.",
+                            ))
+                            .size(text_size * 0.8)
+                            .color(CREAM),
+                        );
+                        ui.add_space(6.0);
+                        let search = ui.add(
+                            egui::TextEdit::singleline(&mut self.query)
+                                .id(egui::Id::new(SEARCH_ID))
+                                .hint_text(l("Search by name or number…", "Buscar por nombre o número…"))
+                                .font(egui::FontId::proportional(text_size))
+                                .desired_width(f32::INFINITY),
+                        );
+                        if self.first {
+                            search.request_focus();
+                            self.first = false;
+                        }
+                        typed = search.changed();
+                        ui.add_space(6.0);
+                        let total = self.shown.len();
+                        let mut area = egui::ScrollArea::vertical().max_height(list_h).auto_shrink([false, false]);
+                        if self.scroll_to_sel {
+                            // each row takes its height and the spacing between rows: counting only the height made the marked row drift out of view
+                            let step = row_h + ui.spacing().item_spacing.y;
+                            area = area.vertical_scroll_offset((self.sel as f32 * step - list_h / 2.0 + step / 2.0).max(0.0));
+                            self.scroll_to_sel = false;
+                        }
+                        area.show_rows(ui, row_h, total, |ui, range| {
+                            for pos in range {
+                                let (id, name) = &self.names()[self.shown[pos]];
+                                let selected = pos == self.sel;
+                                let (rect, response) = ui.allocate_exact_size(egui::vec2(width - 24.0, row_h), egui::Sense::click());
+                                let painter = ui.painter();
+                                if selected {
+                                    painter.rect_filled(rect, 4.0, GOLD);
+                                } else if response.hovered() {
+                                    painter.rect_filled(rect, 4.0, Color32::from_rgba_unmultiplied(0xd9, 0xb2, 0x5f, 40));
+                                }
+                                painter.text(
+                                    rect.left_center() + egui::vec2(10.0, 0.0),
+                                    egui::Align2::LEFT_CENTER,
+                                    name,
+                                    egui::FontId::proportional(text_size),
+                                    if selected { Color32::BLACK } else { CREAM },
+                                );
+                                painter.text(
+                                    rect.right_center() - egui::vec2(10.0, 0.0),
+                                    egui::Align2::RIGHT_CENTER,
+                                    id.to_string(),
+                                    egui::FontId::proportional(text_size * 0.75),
+                                    if selected { Color32::BLACK } else { BLUE },
+                                );
+                                if response.clicked() {
+                                    clicked = Some((pos, response.double_clicked()));
+                                }
+                                if response.double_clicked() {
+                                    clicked = Some((pos, true));
+                                }
+                            }
+                        });
+                        if total == 0 {
+                            ui.label(RichText::new(l("Nothing matches", "Nada coincide")).size(text_size).color(RED));
+                        }
+                        ui.add_space(8.0);
+                        ui.horizontal(|ui| {
+                            ui.label(RichText::new(l("Quantity", "Cantidad")).size(text_size).color(CREAM));
+                            if ui.add(egui::Button::new(RichText::new("−").size(text_size))).clicked() {
+                                qty_delta = -1;
+                            }
+                            ui.label(RichText::new(format!("{}", self.qty)).size(text_size * 1.2).color(GOLD));
+                            if ui.add(egui::Button::new(RichText::new("+").size(text_size))).clicked() {
+                                qty_delta = 1;
+                            }
+                            if ui.add(egui::Button::new(RichText::new("99").size(text_size))).clicked() {
+                                qty_delta = 99;
+                            }
+                            ui.add_space(12.0);
+                            if ui.add(egui::Button::new(RichText::new(l("Add", "Añadir")).size(text_size * 1.1).color(Color32::BLACK)).fill(GOLD)).clicked() {
+                                add_now = true;
+                            }
+                            if ui.add(egui::Button::new(RichText::new(l("Close", "Cerrar")).size(text_size))).clicked() {
+                                close_now = true;
+                            }
+                        });
+                        ui.add_space(4.0);
+                        if let Some((text, ok)) = &self.status {
+                            ui.label(RichText::new(text).size(text_size).color(if *ok { BLUE } else { RED }));
+                        } else if self.waiting.is_some() {
+                            if self.waiting.is_some_and(|t| t.elapsed().as_secs_f32() > 2.5) {
+                                ui.label(
+                                    RichText::new(l(
+                                        "The game does not answer (a menu or a loading screen?). If it keeps on, press PLAY in the launcher so the game is built again.",
+                                        "El juego no responde (¿un menú o una carga?). Si sigue igual, pulsa JUGAR en el launcher para reconstruir el juego.",
+                                    ))
+                                    .size(text_size * 0.9)
+                                    .color(RED),
+                                );
+                            } else {
+                                ui.label(RichText::new("…").size(text_size).color(CREAM));
+                            }
+                        }
+                        ui.label(
+                            RichText::new(if es {
+                                "Mando: cruceta o stick mueven y cambian la cantidad · A añade · X teclado en pantalla para buscar · L/R letra anterior/siguiente · Y 1/99 · B cierra\nTeclado: escribe para buscar · flechas arriba/abajo · Mayús + flechas cantidad · Intro añade · Esc cierra"
+                            } else {
+                                "Gamepad: cross or stick move and change the quantity · A adds · X on-screen keyboard to search · L/R previous/next letter · Y 1/99 · B closes\nKeyboard: type to search · up/down arrows · Shift + arrows quantity · Enter adds · Esc closes"
+                            })
+                            .size(text_size * 0.7)
+                            .color(GOLD),
+                        );
+                    });
+            });
+        if typed {
+            self.refilter();
+        }
+        if let Some((pos, double)) = clicked {
+            self.sel = pos;
+            if double {
+                self.add();
+            }
+        }
+        match qty_delta {
+            0 => {}
+            99 => self.qty = itembox::STACK,
+            d if d > 0 => self.qty = (self.qty + 1).min(itembox::STACK),
+            _ => self.qty = self.qty.saturating_sub(1).max(1),
+        }
+        if add_now {
+            self.add();
+        }
+        close || close_now
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn picker_with(names: &[(u16, &str)]) -> Picker {
+        let _ = names;
+        Picker {
+            query: String::new(),
+            shown: Vec::new(),
+            sel: 0,
+            qty: 1,
+            status: None,
+            scroll_to_sel: false,
+            waiting: None,
+            first: false,
+            spanish: false,
+        }
+    }
+
+    #[test]
+    fn the_quantity_stays_between_1_and_99_and_y_toggles() {
+        let mut p = picker_with(&[]);
+        p.handle(Nav::Left);
+        assert_eq!(p.qty, 1);
+        for _ in 0..200 {
+            p.handle(Nav::Right);
+        }
+        assert_eq!(p.qty, 99);
+        p.handle(Nav::Default);
+        assert_eq!(p.qty, 1);
+        p.handle(Nav::Default);
+        assert_eq!(p.qty, 99);
+    }
+
+    #[test]
+    fn back_closes_and_moving_in_an_empty_list_is_harmless() {
+        let mut p = picker_with(&[]);
+        assert!(!p.handle(Nav::Down));
+        assert!(!p.handle(Nav::TabNext));
+        assert!(!p.handle(Nav::TabPrev));
+        assert!(!p.handle(Nav::Accept));
+        assert!(p.handle(Nav::Back));
+    }
+}
