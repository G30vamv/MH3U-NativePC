diff --git a/crates/mh3u-rt/src/uisound.rs b/crates/mh3u-rt/src/uisound.rs
new file mode 100644
index 0000000..92ffced
--- /dev/null
+++ b/crates/mh3u-rt/src/uisound.rs
@@ -0,0 +1,109 @@
+//! The soft ticks of the on-screen keyboard: a very short tone when the mark moves from key to key and a slightly longer, higher one when a
+//! key is pressed. Each is a tiny wave made once in memory and played by the system (`PlaySound`, asynchronous, from memory): no file, no
+//! audio thread of ours and no mixing in the game's own sound, so it costs a call that returns at once. `MH3U_UI_SOUND=off` leaves them out.
+
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicBool, Ordering::Relaxed};
+
+static ON: AtomicBool = AtomicBool::new(true);
+static MOVE: OnceLock<Vec<u8>> = OnceLock::new();
+static PRESS: OnceLock<Vec<u8>> = OnceLock::new();
+
+/// The sample rate of the ticks.
+const RATE: u32 = 22_050;
+
+/// Reads `MH3U_UI_SOUND` (once, when the game starts).
+pub fn init_from_env() {
+    if std::env::var("MH3U_UI_SOUND").is_ok_and(|v| matches!(v.to_ascii_lowercase().as_str(), "off" | "0" | "no" | "false")) {
+        ON.store(false, Relaxed);
+    }
+}
+
+pub fn set_enabled(on: bool) {
+    ON.store(on, Relaxed);
+}
+
+pub fn enabled() -> bool {
+    ON.load(Relaxed)
+}
+
+/// A WAV (16-bit, mono) of a tone that glides from `from` to `to` Hz in `ms` milliseconds, fading in over 2 ms and out like a struck key.
+fn wav(from: f32, to: f32, ms: u32, amplitude: f32) -> Vec<u8> {
+    let n = (RATE * ms / 1000) as usize;
+    let mut samples = Vec::with_capacity(n);
+    let mut phase = 0.0f32;
+    for i in 0..n {
+        let t = i as f32 / n as f32;
+        let hz = from + (to - from) * t;
+        phase += std::f32::consts::TAU * hz / RATE as f32;
+        let fade_in = (i as f32 / (RATE as f32 * 0.002)).min(1.0);
+        let envelope = fade_in * (-5.0 * t).exp();
+        // a little of the octave above makes it a tick and not a beep
+        let tone = phase.sin() + 0.25 * (phase * 2.0).sin();
+        samples.push((tone * envelope * amplitude * 32767.0 / 1.25) as i16);
+    }
+    let data_len = (samples.len() * 2) as u32;
+    let mut out = Vec::with_capacity(44 + data_len as usize);
+    out.extend_from_slice(b"RIFF");
+    out.extend_from_slice(&(36 + data_len).to_le_bytes());
+    out.extend_from_slice(b"WAVEfmt ");
+    out.extend_from_slice(&16u32.to_le_bytes());
+    out.extend_from_slice(&1u16.to_le_bytes()); // PCM
+    out.extend_from_slice(&1u16.to_le_bytes()); // mono
+    out.extend_from_slice(&RATE.to_le_bytes());
+    out.extend_from_slice(&(RATE * 2).to_le_bytes());
+    out.extend_from_slice(&2u16.to_le_bytes());
+    out.extend_from_slice(&16u16.to_le_bytes());
+    out.extend_from_slice(b"data");
+    out.extend_from_slice(&data_len.to_le_bytes());
+    for s in samples {
+        out.extend_from_slice(&s.to_le_bytes());
+    }
+    out
+}
+
+#[cfg(windows)]
+fn play(wave: &'static [u8]) {
+    use windows_sys::Win32::Media::Audio::{PlaySoundW, SND_ASYNC, SND_MEMORY, SND_NODEFAULT};
+    // SAFETY: `wave` is a complete WAV that lives for the whole run (a static), as SND_MEMORY with SND_ASYNC needs
+    unsafe {
+        PlaySoundW(wave.as_ptr().cast(), std::ptr::null_mut(), SND_MEMORY | SND_ASYNC | SND_NODEFAULT);
+    }
+}
+
+#[cfg(not(windows))]
+fn play(_wave: &'static [u8]) {}
+
+/// The mark moved from a key to another.
+pub fn tick_move() {
+    if enabled() {
+        play(MOVE.get_or_init(|| wav(2000.0, 1500.0, 22, 0.16)));
+    }
+}
+
+/// A key was pressed.
+pub fn tick_press() {
+    if enabled() {
+        play(PRESS.get_or_init(|| wav(1500.0, 2400.0, 48, 0.20)));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_ticks_are_whole_short_waves_and_soft() {
+        for w in [wav(2000.0, 1500.0, 22, 0.16), wav(1500.0, 2400.0, 48, 0.20)] {
+            assert_eq!(&w[..4], b"RIFF");
+            assert_eq!(&w[8..16], b"WAVEfmt ");
+            let data = u32::from_le_bytes(w[40..44].try_into().unwrap()) as usize;
+            assert_eq!(w.len(), 44 + data);
+            assert_eq!(u32::from_le_bytes(w[4..8].try_into().unwrap()) as usize, 36 + data);
+            // under 60 ms and well under the full scale
+            assert!(data / 2 < (RATE as usize * 60) / 1000);
+            let peak = w[44..].chunks(2).map(|b| i16::from_le_bytes([b[0], b[1]]).unsigned_abs()).max().unwrap();
+            assert!(peak > 2000 && peak < 9000, "{peak}");
+        }
+    }
+}
