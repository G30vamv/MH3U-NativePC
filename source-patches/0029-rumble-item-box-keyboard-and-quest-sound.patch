index e6449de..50b3045 100644
--- a/crates/mh3u-gfx/src/menu_draw.rs
+++ b/crates/mh3u-gfx/src/menu_draw.rs
@@ -393,6 +393,193 @@ pub fn draw(ctx: &egui::Context, state: &MenuState, rows: &[Row], lang: Lang, fa
