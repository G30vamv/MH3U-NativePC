+/// The two motors' levels now (0 to 65535): what the bit pattern asks of both, and the strongest pulse of each.
+fn levels(now: Instant) -> (u16, u16) {
+    let mut low = 0u16;
+    let mut high = 0u16;
+    {
+        let mut playing = PLAYING.lock().unwrap_or_else(|e| e.into_inner());
+        match playing.as_ref().map(|p| p.at(now)) {
+            Some(Some(true)) => {
+                let level = (strength().min(100) * 65535 / 100) as u16;
+                low = level;
+                high = level;
+            }
+            Some(None) => *playing = None,
+            _ => {}
+        }
+    }
+    let mut pulses = PULSES.lock().unwrap_or_else(|e| e.into_inner());
+    pulses.retain(|p| p.until > now);
+    for p in pulses.iter().filter(|p| p.from <= now) {
+        low = low.max(p.low);
+        high = high.max(p.high);
+    }
