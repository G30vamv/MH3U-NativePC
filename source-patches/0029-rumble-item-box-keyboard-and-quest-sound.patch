+        }
+        Shape::Pulses(steps) => {
+            if !claim(f.prio, steps.iter().map(|s| s.delay_ms + s.ms).max().unwrap_or(0)) {
+                return;
+            }
+            let scaled: Vec<Step> = steps
+                .iter()
+                .map(|s| Step {
+                    power: (s.power * f.scale).clamp(0.0, 1.0),
+                    ..*s
+                })
+                .collect();
+            pulses(&scaled);
+        }
+    }
+    if f.ticks {
+        pulses(&[step(0.45, 55, Motor::High, 80), step(0.45, 55, Motor::High, 190)]);
+    }
+}
+
+/// Plays a few pulses of a pattern with its importance (a lesser pattern is dropped while a greater one plays).
+pub fn play_pulses(steps: &'static [Step], scale: f32, prio: u8) {
+    feel(Feel {
+        shape: Shape::Pulses(steps),
+        scale,
+        time_scale: 1.0,
+        ticks: false,
+        prio,
+    });
+}
+
+/// What plays now has this importance until the instant.
+static BUSY: Mutex<Option<(Instant, u8)>> = Mutex::new(None);
+
+/// Whether something of importance `prio` may play for `ms` from now (and if so, marks it as what plays).
+fn claim(prio: u8, ms: u32) -> bool {
+    claim_in(&mut BUSY.lock().unwrap_or_else(|e| e.into_inner()), Instant::now(), prio, ms)
+}
+
+fn claim_in(busy: &mut Option<(Instant, u8)>, now: Instant, prio: u8, ms: u32) -> bool {
+    if busy.is_some_and(|(until, p)| until > now && p > prio) {
+        return false;
+    }
+    let until = now + Duration::from_millis(u64::from(ms));
+    if !busy.is_some_and(|(u, p)| u > until && p >= prio) {
+        *busy = Some((until, prio));
+    }
+    true
+}
+
+/// Starts an envelope now, replacing the one that was playing.
+pub fn envelope(segs: &[Seg], scale: f32, time_scale: f32) {
+    envelope_prio(segs, scale, time_scale, PRIO_WORLD);
+}
+
+/// [`envelope`] with its importance; false when something more important is playing (then nothing starts).
+fn envelope_prio(segs: &[Seg], scale: f32, time_scale: f32, prio: u8) -> bool {
+    if !enabled() {
+        return false;
+    }
+    let total = (segs.last().map_or(0, |s| s.end_ms) as f32 * time_scale) as u32;
+    if !claim(prio, total) {
+        return false;
+    }
+    let gain = (scale.clamp(0.0, 1.0) * (strength() as f32 / 100.0) * 1.25).min(1.0);
+    let now = Instant::now();
+    let mut start_ms = 0u32;
+    {
+        let mut list = PULSES.lock().unwrap_or_else(|e| e.into_inner());
+        list.retain(|p| p.until > now && !p.envelope);
+        for s in segs {
+            let from = now + Duration::from_millis((f64::from(start_ms) * f64::from(time_scale)) as u64);
+            let until = now + Duration::from_millis((f64::from(s.end_ms) * f64::from(time_scale)) as u64);
+            let level = |v: f32| (v.clamp(0.0, 1.0) * gain * 65535.0) as u16;
+            list.push(Pulse {
+                from,
+                until,
+                low: level(s.low),
+                high: level(s.high),
+                envelope: true,
+            });
+            start_ms = s.end_ms;
+        }
+    }
+    start();
+    true
+}
+
+/// The quest is done (the results screen began).
+pub fn quest_done() {
+    eprintln!("[rumble] quest done");
+    play_pulses(&QUEST_DONE, 1.0, PRIO_WORLD);
+}
+
+// ---- what happens in play ----
+
+/// Own hits keep this long apart, and stay silent this long after the hunter was hit.
+const OWN_HIT_GAP: Duration = Duration::from_millis(60);
+const AFTER_HIT_SILENCE: Duration = Duration::from_millis(450);
+/// Hits closer than this count as a streak.
+const STREAK_GAP: Duration = Duration::from_millis(900);
+/// A hit taken waits this long for the end of its resolver to say whether a guard held it; after that it plays as it is.
+const PENDING_MAX: Duration = Duration::from_millis(60);
+/// Game units in a metre (the world seems to be in centimetres).
+const UNIT: f32 = 100.0;
+/// A monster this big (its most life) lands with a thud; the small ones do not.
+const BIG_MONSTER: i32 = 1500;
+/// The most monsters followed.
+const MOST_MONSTERS: usize = 24;
+
+/// A hit taken, waiting for the end of its resolver.
+#[derive(Clone, Copy)]
+struct Pending {
+    at: Instant,
+    info: HitInfo,
+}
+
+static PENDING: Mutex<Option<Pending>> = Mutex::new(None);
+static TAKEN_UNTIL: Mutex<Option<Instant>> = Mutex::new(None);
+static MONSTERS: Mutex<Vec<u32>> = Mutex::new(Vec::new());
+static OWN: Mutex<Vec<(Instant, f32)>> = Mutex::new(Vec::new());
+
+fn lock<T>(m: &'static Mutex<T>) -> std::sync::MutexGuard<'static, T> {
+    m.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// A position read from an object (`+0x40`), when it is one.
+fn object_pos(g: &Guest, object: u32) -> Option<[f32; 3]> {
+    if !(0x1000_0000..0x5000_0000).contains(&object) || !object.is_multiple_of(4) {
+        return None;
+    }
+    let p = [
+        f32::from_bits(g.u32(object + 0x40)),
+        f32::from_bits(g.u32(object + 0x44)),
+        f32::from_bits(g.u32(object + 0x48)),
+    ];
+    p.iter().all(|v| v.is_finite() && v.abs() < 1.0e6).then_some(p)
+}
+
+fn metres_between(a: [f32; 3], b: [f32; 3]) -> f32 {
+    ((a[0] - b[0]).powi(2) + (a[1] - b[1]).powi(2) + (a[2] - b[2]).powi(2)).sqrt() / UNIT
+}
+
+/// Finishes a hit taken: plays what it feels like and keeps the hunter's own hits quiet while it plays.
+fn play_taken(info: HitInfo) {
+    let Some(f) = hit_feel(&info) else { return };
+    let long = match f.shape {
+        Shape::Envelope(e) => e.last().map_or(0, |s| (s.end_ms as f32 * f.time_scale) as u64),
+        Shape::Pulses(p) => p.iter().map(|s| u64::from(s.delay_ms + s.ms)).max().unwrap_or(0),
+    };
+    *lock(&TAKEN_UNTIL) = Some(Instant::now() + Duration::from_millis(long).max(AFTER_HIT_SILENCE));
+    feel(f);
+}
+
+/// The hooks: `hunter_hit` is `f_021283ec(hit check, hunter r4, hit record r5, ..)`, the hit resolver of a hunter that is hit (the
+/// record's float `+0x44` is the base damage, `+0x54` the amount of status), and `hunter_hit_end` is `f_021281c4(.., hunter r4, owner r5,
+/// record r6, .., damage r8, guard r9)`, its last step (r9 = 1 when a guard held the hit, r8 the damage that went through);
+/// `hit_resolve` is `f_02129ef4`, the resolver of a hit of the hunter on a monster; `monster_init` follows the monsters; `item_to_pouch`
+/// and `sharp_change` tell an item used and a stroke of the whetstone.
+pub fn register(r: &mut Registry) {
+    r.on(
+        "hunter_hit",
+        Box::new(move |h: &mut Hook| {
+            if !enabled() {
+                return;
+            }
+            let (hunter, record) = (h.ctx.r[4], h.ctx.r[5]);
+            if record == 0 {
+                return;
+            }
+            let g = Guest::new(h.ctx.mem);
+            if !crate::combat::is_local_hunter(&g, hunter) {
+                return;
+            }
+            let damage = f32::from_bits(g.u32(record + 0x44));
+            let status = f32::from_bits(g.u32(record + 0x54));
+            let kind = g.u8(record + 0x48);
+            // how far the attacker is (a roar fades with the distance); the attacker of a monster's hit is at +0x10
+            let metres = match (object_pos(&g, hunter), object_pos(&g, g.u32(record + 0x10))) {
+                (Some(a), Some(b)) if g.u8(record + 6) == 1 => Some(metres_between(a, b)),
+                _ => None,
+            };
+            static LOGGED: AtomicU32 = AtomicU32::new(0);
+            if LOGGED.fetch_add(1, Relaxed) < 400 {
+                // (what the hit is, to tell the kinds of hit apart later: attacker class +6, type +0x48, flags +0x50)
+                eprintln!(
+                    "[rumble] the hunter is hit: base damage {damage}, status {status}, attacker class {}, type {:#x}, flags {:#x}, distance {}",
+                    g.u8(record + 6),
+                    kind,
+                    g.u32(record + 0x50),
+                    metres.map_or("?".to_string(), |m| format!("{m:.1} m"))
+                );
+            }
+            if is_air_sound(kind) && damage < 1.0 && lock(&ROAR_AT).is_some_and(|t| t.elapsed() < ROAR_GAP) {
+                return;
+            }
+            let state = g.u32(hunter + 0xe30);
+            let max_life = (state != 0).then(|| f32::from(g.u16(state + 0x642) as i16)).filter(|m| *m >= 20.0);
+            let mut info = HitInfo::plain(kind, damage, status);
+            info.max_life = max_life;
+            info.metres = metres;
+            *lock(&PENDING) = Some(Pending { at: Instant::now(), info });
+        }),
+    );
+    // `hit_check_hunter` is `f_02129300(hit check, attack record r4, hunter r5)`: the test of one active attack against one hunter, made every
+    // frame for every attack and hunter before the shapes are compared (`f_0212d3d4`). A roar is an attack with a big shape; it is seen
+    // here from the moment the monster starts it, wherever the hunter is, which is how a roar that does not reach the hunter is felt.
+    r.on(
+        "hit_check_hunter",
+        Box::new(move |h: &mut Hook| {
+            let record = h.ctx.r[4];
+            if record == 0 || !enabled() {
+                return;
+            }
+            let g = Guest::new(h.ctx.mem);
+            // the cheap tests first (this runs for every attack of every frame): an attack of a monster or an object, without damage
+            let class = g.u8(record + 6);
+            if !(class == 1 || class == 2) || f32::from_bits(g.u32(record + 0x44)) >= 1.0 {
+                return;
+            }
+            let hunter = h.ctx.r[5];
+            if !crate::combat::is_local_hunter(&g, hunter) {
+                return;
+            }
+            let kind = g.u8(record + 0x48);
+            if class != 1 || !is_air_sound(kind) {
+                return;
+            }
+            let now = Instant::now();
+            {
+                let mut at = lock(&ROAR_AT);
+                if at.is_some_and(|t| now.duration_since(t) < ROAR_GAP) {
+                    return;
+                }
+                *at = Some(now);
+            }
+            let metres = match (object_pos(&g, hunter), object_pos(&g, g.u32(record + 0x10))) {
+                (Some(a), Some(b)) => Some(metres_between(a, b)),
+                _ => None,
+            };
+            static LOGGED: AtomicU32 = AtomicU32::new(0);
+            if LOGGED.fetch_add(1, Relaxed) < 200 {
+                eprintln!("[rumble] a roar starts (type {kind:#x}), {} from the hunter", metres.map_or("?".to_string(), |m| format!("{m:.1} m")));
+            }
+            let mut info = HitInfo::plain(kind, 0.0, 0.0);
+            info.metres = metres;
+            if let Some(f) = hit_feel(&info) {
+                feel(f);
+            }
+        }),
+    );
+    r.on(
+        "hunter_hit_end",
+        Box::new(move |h: &mut Hook| {
+            let Some(p) = lock(&PENDING).take() else { return };
+            if p.at.elapsed() > PENDING_MAX * 4 {
+                return;
+            }
+            let mut info = p.info;
+            let damage = h.ctx.r[8] as i32;
+            info.final_damage = (0..=10_000).contains(&damage).then_some(damage as f32);
+            info.guard = h.ctx.r[9] == 1;
+            static LOGGED: AtomicU32 = AtomicU32::new(0);
+            if LOGGED.fetch_add(1, Relaxed) < 400 {
+                eprintln!(
+                    "[rumble] the hit ends: damage {damage} of {:?}, guard {}",
+                    info.max_life, info.guard
+                );
+            }
+            play_taken(info);
+        }),
+    );
+    let last_own: Mutex<(Option<Instant>, u32)> = Mutex::new((None, 0));
+    r.on(
+        "hit_resolve",
+        Box::new(move |h: &mut Hook| {
+            if !enabled() || !own_hits() {
+                return;
+            }
+            let record = h.ctx.r[5];
+            if record == 0 {
+                return;
+            }
+            let g = Guest::new(h.ctx.mem);
+            let local = crate::combat::local_slot(&g);
+            if local.is_none() || crate::combat::attacker_slot(&g, record) != local {
+                return;
+            }
+            let now = Instant::now();
+            let base = f32::from_bits(g.u32(record + 0x44));
+            {
+                let mut own = lock(&OWN);
+                own.retain(|(t, _)| now.duration_since(*t) < Duration::from_secs(2));
+                if own.len() < 32 {
+                    own.push((now, if base.is_finite() { base.max(0.0) } else { 0.0 }));
+                }
+            }
+            if lock(&TAKEN_UNTIL).is_some_and(|until| now < until) {
+                return;
+            }
+            let mut last = last_own.lock().unwrap_or_else(|e| e.into_inner());
+            if last.0.is_some_and(|t| now.duration_since(t) < OWN_HIT_GAP) {
+                return;
+            }
+            // hits close together are a streak, which feels a little stronger
+            last.1 = if last.0.is_some_and(|t| now.duration_since(t) < STREAK_GAP) {
+                last.1 + 1
+            } else {
+                0
+            };
+            last.0 = Some(now);
+            *lock(&STREAK) = last.1;
+            feel(own_hit(base, last.1));
+        }),
+    );
+    r.on(
+        "monster_init",
+        Box::new(move |h: &mut Hook| {
+            let monster = h.ctx.r[3];
+            let mut list = lock(&MONSTERS);
+            if monster != 0 && !list.contains(&monster) {
+                if list.len() >= MOST_MONSTERS {
+                    list.remove(0);
+                }
+                list.push(monster);
+            }
+        }),
+    );
+    r.on(
+        "item_to_pouch",
+        Box::new(move |h: &mut Hook| {
+            // an item used in a quest (with the infinite items cheat the count was already zeroed, which is still "used")
+            if enabled() && crate::cheats::item_used_at(h.ctx.lr, h.ctx.r[5]) {
+                play_pulses(&ITEM_USED, 1.0, PRIO_LIGHT);
+            }
+        }),
+    );
+    let last_sharpen: Mutex<Option<Instant>> = Mutex::new(None);
+    r.on(
+        "sharp_change",
+        Box::new(move |h: &mut Hook| {
+            if !enabled() || (h.ctx.r[4] as i32) <= 0 {
+                return;
+            }
+            let now = Instant::now();
+            let mut last = last_sharpen.lock().unwrap_or_else(|e| e.into_inner());
+            if last.is_none_or(|t| now.duration_since(t) >= Duration::from_millis(130)) {
+                *last = Some(now);
+                play_pulses(&SHARPEN, 1.0, PRIO_LIGHT);
+            }
+        }),
+    );
+}
+
+static STREAK: Mutex<u32> = Mutex::new(0);
+
+// ---- what the frames show ----
+
+/// Follows the height of something that moves and tells when a fall ends: the speed it hit the ground at (game units a second) and
+/// how far it dropped.
+#[derive(Default)]
+struct Faller {
+    y: f32,
+    seen: bool,
+    last_change: Option<Instant>,
+    from: Option<f32>,
+    started: Option<Instant>,
+    speed: f32,
+}
+
+/// Gravity in metres a second squared.
+const GRAVITY: f32 = 9.8;
+/// A fall longer than this is no landing (an area change or a respawn), in metres.
+const FALL_MOST: f32 = 40.0;
+
+impl Faller {
+    fn feed(&mut self, y: f32, now: Instant) -> Option<(f32, f32)> {
+        if !y.is_finite() {
+            return None;
+        }
+        if !self.seen {
+            *self = Faller {
+                y,
+                seen: true,
+                last_change: Some(now),
+                ..Faller::default()
+            };
+            return None;
+        }
+        let dy = y - self.y;
+        // a jump of the place (an area change, a respawn) is no fall
+        if dy.abs() > 3000.0 {
+            *self = Faller {
+                y,
+                seen: true,
+                last_change: Some(now),
+                ..Faller::default()
+            };
+            return None;
+        }
+        if dy.abs() > 0.01 {
+            let dt = now.duration_since(self.last_change.unwrap_or(now)).as_secs_f32().max(0.004);
+            self.last_change = Some(now);
+            let before = self.y;
+            self.y = y;
+            if dy < -0.5 {
+                if self.from.is_none() {
+                    self.from = Some(before);
+                    self.started = Some(now);
+                }
+                self.speed = -dy / dt;
+                return None;
+            }
+            return self.end(now);
+        }
+        // nothing moved: a fall that has been still for a moment is over
+        if self.from.is_some() && self.last_change.is_some_and(|t| now.duration_since(t) > Duration::from_millis(80)) {
+            return self.end(now);
+        }
+        None
+    }
+
+    /// The fall is over: (the speed it hit the ground at in game units a second, how far it dropped). The speed is the one a fall of that
+    /// height ends with, `sqrt(2 g h)`: measuring it from the positions between two frames gave nonsense (the positions change in
+    /// steps), and a fall that took far longer than a free fall would (walking down a slope, a knock back) or fell from too high (a
+    /// jump of the place) is none.
+    fn end(&mut self, now: Instant) -> Option<(f32, f32)> {
+        let from = self.from.take()?;
+        let started = self.started.take();
+        self.speed = 0.0;
+        let drop = from - self.y;
+        let metres = drop / UNIT;
+        if !(0.3..=FALL_MOST).contains(&metres) {
+            return None;
+        }
+        let secs = started.map_or(0.0, |t| now.duration_since(t).as_secs_f32());
+        if secs > 2.0 * (2.0 * metres / GRAVITY).sqrt() + 0.25 {
+            return None;
+        }
+        Some(((2.0 * GRAVITY * metres).sqrt() * UNIT, drop))
+    }
+}
+
+struct Tracked {
+    address: u32,
+    faller: Faller,
+    life: i32,
+    seen: bool,
+    landed: Option<Instant>,
+}
+
+#[derive(Default)]
+struct World {
+    hunter: Faller,
+    hunter_landed: Option<Instant>,
+    life: Option<i16>,
+    monsters: Vec<Tracked>,
+    /// How much of an own hit's base damage the monsters' life takes, on average (to tell a weak point from a normal hit).
+    ratio: f32,
+    ratios: u32,
+    last_fall: Option<Instant>,
+    last_bounce: Option<Instant>,
+}
+
+static WORLD: Mutex<Option<World>> = Mutex::new(None);
+
+/// A hit taken that waited too long for the end of its resolver plays as it is (the end never came).
+fn flush_pending() {
+    let mut p = lock(&PENDING);
+    if p.is_some_and(|x| x.at.elapsed() > PENDING_MAX) {
+        let info = p.take().map(|x| x.info);
+        drop(p);
+        if let Some(info) = info {
+            play_taken(info);
+        }
+    }
+}
+
+/// Called at each frame swap: the hunter's life (faint, recover), the falls of the hunter and of the big monsters, and how much the
+/// own hits took from the monsters' life (a weak point, a blow that glances off).
+pub(crate) fn on_frame(g: &Guest) {
+    if !enabled() {
+        return;
+    }
+    flush_pending();
+    let now = Instant::now();
+    let mut guard = lock(&WORLD);
+    let w = guard.get_or_insert_with(World::default);
+    let Some(hunter) = crate::combat::local_hunter(g).filter(|h| *h != 0) else {
+        *w = World::default();
+        return;
+    };
+    let state = g.u32(hunter + 0xe30);
+    if state == 0 {
+        return;
+    }
+    // life: a faint and a recovery
+    let life = g.u16(state + 0x640) as i16;
+    let most = g.u16(state + 0x642) as i16;
+    if (20..=1000).contains(&most) {
+        if let Some(before) = w.life {
+            if before > 0 && life <= 0 {
+                eprintln!("[rumble] the hunter faints");
+                feel(Feel {
+                    shape: Shape::Envelope(&FAINT),
+                    scale: 1.0,
+                    time_scale: 1.0,
+                    ticks: false,
+                    prio: PRIO_FAINT,
+                });
+            } else if before > 0 && life > before && i32::from(life - before) * 12 >= i32::from(most) {
+                feel(Feel {
+                    shape: Shape::Envelope(&RECOVER),
+                    scale: 0.8,
+                    time_scale: 1.0,
+                    ticks: false,
+                    prio: PRIO_LIGHT,
+                });
+            }
+        }
+        w.life = Some(life);
+    }
+    // where the hunter is (the object keeps its place at +0x40, its state at +0xe0, which the game's air physics moves)
+    let here = object_pos(g, hunter);
+    if let Some((speed, drop)) = w.hunter.feed(f32::from_bits(g.u32(state + 0xe4)), now) {
+        let (speed, drop) = (speed / UNIT, drop / UNIT);
+        static LOGGED: AtomicU32 = AtomicU32::new(0);
+        if LOGGED.fetch_add(1, Relaxed) < 60 {
+            eprintln!("[rumble] the hunter lands: {speed:.1} m/s after {drop:.1} m");
+        }
+        if w.hunter_landed.is_none_or(|t| now.duration_since(t) > Duration::from_millis(300)) {
+            if let Some(f) = hunter_land(speed, drop) {
+                w.hunter_landed = Some(now);
+                feel(f);
+            }
+        }
+    }
+    // the monsters: the big ones' landings, and the fall of their life
+    let addresses: Vec<u32> = lock(&MONSTERS).clone();
+    for a in &addresses {
+        if !w.monsters.iter().any(|t| t.address == *a) {
+            w.monsters.push(Tracked {
+                address: *a,
+                faller: Faller::default(),
+                life: -1,
+                seen: false,
+                landed: None,
+            });
+        }
+    }
+    let mut fall = 0i32;
+    let mut gone = Vec::new();
+    for t in &mut w.monsters {
+        let Some((_, hp, max)) = crate::combat::read_monster(g, t.address) else {
+            if t.seen {
+                gone.push(t.address);
+            }
+            continue;
+        };
+        t.seen = true;
+        if t.life >= 0 && hp < t.life {
+            fall += t.life - hp;
+        }
+        t.life = hp;
+        if max < BIG_MONSTER {
+            continue;
+        }
