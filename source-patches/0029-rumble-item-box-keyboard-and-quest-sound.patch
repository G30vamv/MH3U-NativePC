+/// What the game's traffic with each other player looked like in the last seconds, written as one line for each of them every
+/// `P2P_WINDOW` (`[net p2p]`): how many packets and bytes went each way, how many gaps over 100 ms and over 500 ms there were between
+/// the packets that came, and the longest one. It is what the stability of a room (monsters that jump, players that stutter) needs
+/// and costs a counter for each packet, not a line for each (`MH3U_NET_TRACE=1` still writes every packet).
+const P2P_WINDOW: Duration = Duration::from_secs(10);
+
+#[derive(Default)]
+struct PeerStats {
+    sent: u32,
+    sent_bytes: u64,
+    recv: u32,
+    recv_bytes: u64,
+    last_recv: Option<Instant>,
+    longest_ms: u32,
+    over_100: u32,
+    over_500: u32,
+}
+
+static P2P: Mutex<(Option<Instant>, BTreeMap<Ipv4Addr, PeerStats>)> = Mutex::new((None, BTreeMap::new()));
+
+/// Counts a packet of the game's play traffic (not the server's ports) with `peer`.
+fn p2p_note(port: u16, peer: Ipv4Addr, bytes: usize, sent: bool) {
+    if matches!(port, 1223 | 1224 | 10025 | 33335) {
+        return;
+    }
+    let now = Instant::now();
+    let mut guard = P2P.lock().unwrap_or_else(|e| e.into_inner());
+    let st = guard.1.entry(peer).or_default();
+    if sent {
+        st.sent += 1;
+        st.sent_bytes += bytes as u64;
+    } else {
+        if let Some(last) = st.last_recv {
+            let gap = now.duration_since(last).as_millis().min(u128::from(u32::MAX)) as u32;
+            st.longest_ms = st.longest_ms.max(gap);
+            st.over_100 += u32::from(gap > 100);
+            st.over_500 += u32::from(gap > 500);
+        }
+        st.last_recv = Some(now);
+        st.recv += 1;
+        st.recv_bytes += bytes as u64;
+    }
+}
+
+/// Writes the lines of the window that ended, when it has (called often, from the game's polling of its sockets).
+fn p2p_report() {
+    let now = Instant::now();
+    let mut guard = P2P.lock().unwrap_or_else(|e| e.into_inner());
+    match guard.0 {
+        None => {
+            guard.0 = Some(now);
+            return;
+        }
+        Some(start) if now.duration_since(start) < P2P_WINDOW => return,
+        _ => {}
+    }
+    let secs = guard.0.map_or(10.0, |s| now.duration_since(s).as_secs_f32());
+    guard.0 = Some(now);
+    guard.1.retain(|_, st| st.last_recv.is_some_and(|t| now.duration_since(t) < Duration::from_secs(300)) || st.sent > 0);
+    for (peer, st) in guard.1.iter_mut() {
+        // a silence that goes on counts as a gap too
+        let silent = st.last_recv.map_or(0, |t| now.duration_since(t).as_millis().min(u128::from(u32::MAX)) as u32);
+        let longest = st.longest_ms.max(silent);
+        if st.sent + st.recv > 0 {
+            eprintln!(
+                "[net p2p] {peer}: {secs:.0} s: sent {} ({} B), received {} ({} B), gaps over 100 ms {}, over 500 ms {}, longest {longest} ms",
+                st.sent, st.sent_bytes, st.recv, st.recv_bytes, st.over_100, st.over_500
+            );
+        }
+        *st = PeerStats { last_recv: st.last_recv, ..PeerStats::default() };
+    }
+}
