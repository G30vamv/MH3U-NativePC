diff --git a/crates/mh3u-gfx/src/osk.rs b/crates/mh3u-gfx/src/osk.rs
new file mode 100644
index 0000000..a2ac6e7
--- /dev/null
+++ b/crates/mh3u-gfx/src/osk.rs
@@ -0,0 +1,323 @@
+//! The on-screen keyboard for the text the game asks for (a hunter's name, a room's name, a chat line). It is what the player types on
+//! with a gamepad: the cross or the left stick moves over the keys, A presses one. The real keyboard goes on typing too (the text field
+//! takes it), and the mouse clicks the keys. `menu_draw::keyboard` draws it in the look of the menu; this is what it holds and what the
+//! buttons do.
+
+use crate::menu::Nav;
+use crate::settings::Lang;
+use mh3u_rt::input::button;
+
+/// The pages of keys.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Page {
+    Lower,
+    Upper,
+    Symbols,
+}
+
+/// One key.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Key {
+    Char(char),
+    /// Lower case to upper and back (from the symbols, back to the letters).
+    Shift,
+    /// The page of symbols and accents (from there, back to the letters).
+    Symbols,
+    Space,
+    Backspace,
+    Cancel,
+    Accept,
+}
+
+impl Key {
+    /// The words on a key that is not a character.
+    pub fn label(self, lang: Lang) -> String {
+        match self {
+            Key::Char(c) => c.to_string(),
+            Key::Shift => lang.p("SHIFT", "MAYÚS").to_string(),
+            Key::Symbols => lang.p("#+=", "#+=").to_string(),
+            Key::Space => lang.p("SPACE", "ESPACIO").to_string(),
+            Key::Backspace => lang.p("DELETE", "BORRAR").to_string(),
+            Key::Cancel => lang.p("CANCEL", "CANCELAR").to_string(),
+            Key::Accept => lang.p("OK", "ACEPTAR").to_string(),
+        }
+    }
+
+    /// How wide the key is next to a character's one.
+    pub fn width(self) -> f32 {
+        match self {
+            Key::Char(_) => 1.0,
+            Key::Shift | Key::Symbols => 1.5,
+            Key::Space => 3.4,
+            Key::Backspace => 1.6,
+            Key::Cancel => 1.9,
+            Key::Accept => 1.6,
+        }
+    }
+}
+
+/// What a press ended in.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Done {
+    /// Not ended.
+    No,
+    /// The text is final.
+    Accept,
+    Cancel,
+}
+
+const LOWER: [&str; 4] = ["1234567890", "qwertyuiop", "asdfghjklñ", "zxcvbnm,.-"];
+const UPPER: [&str; 4] = ["1234567890", "QWERTYUIOP", "ASDFGHJKLÑ", "ZXCVBNM,.-"];
+const SYMBOLS: [&str; 4] = ["!?¡¿.,:;'\"", "áéíóúüàèçê", "ÁÉÍÓÚÜÀÈÇÊ", "()[]+-=*/_"];
+
+#[derive(Clone, Debug)]
+pub struct Osk {
+    pub text: String,
+    pub page: Page,
+    /// The marked key.
+    pub row: usize,
+    pub col: usize,
+    limit: usize,
+    /// An empty text can be accepted (a search line that is cleared); the game's prompts need something typed.
+    pub allow_empty: bool,
+}
+
+impl Osk {
+    pub fn new(limit: usize) -> Osk {
+        // the cursor starts on the first letter row's middle, where a name begins
+        Osk { text: String::new(), page: Page::Lower, row: 1, col: 4, limit, allow_empty: false }
+    }
+
+    pub fn limit(&self) -> usize {
+        self.limit
+    }
+
+    /// The keys of the page in force: four rows of characters and the row of the others.
+    pub fn rows(&self) -> Vec<Vec<Key>> {
+        let chars = match self.page {
+            Page::Lower => &LOWER,
+            Page::Upper => &UPPER,
+            Page::Symbols => &SYMBOLS,
+        };
+        let mut rows: Vec<Vec<Key>> = chars.iter().map(|r| r.chars().map(Key::Char).collect()).collect();
+        rows.push(vec![Key::Shift, Key::Symbols, Key::Space, Key::Backspace, Key::Cancel, Key::Accept]);
+        rows
+    }
+
+    pub fn key(&self) -> Key {
+        let rows = self.rows();
+        let row = &rows[self.row.min(rows.len() - 1)];
+        row[self.col.min(row.len() - 1)]
+    }
+
+    /// The horizontal middle of the key `col` of `row`, in widths of a character key.
+    fn centre(row: &[Key], col: usize) -> f32 {
+        let before: f32 = row[..col].iter().map(|k| k.width()).sum();
+        before + row[col].width() / 2.0
+    }
+
+    /// Moves the mark one key. Up and down keep to the same place on the screen, wrapping around.
+    pub fn go(&mut self, nav: Nav) {
+        let rows = self.rows();
+        let (r, c) = (self.row.min(rows.len() - 1), self.col.min(rows[self.row.min(rows.len() - 1)].len() - 1));
+        match nav {
+            Nav::Left => {
+                self.row = r;
+                self.col = (c + rows[r].len() - 1) % rows[r].len();
+            }
+            Nav::Right => {
+                self.row = r;
+                self.col = (c + 1) % rows[r].len();
+            }
+            Nav::Up | Nav::Down => {
+                let to = if nav == Nav::Up { (r + rows.len() - 1) % rows.len() } else { (r + 1) % rows.len() };
+                let x = Self::centre(&rows[r], c);
+                let nearest = (0..rows[to].len())
+                    .min_by(|&a, &b| (Self::centre(&rows[to], a) - x).abs().total_cmp(&(Self::centre(&rows[to], b) - x).abs()))
+                    .unwrap_or(0);
+                self.row = to;
+                self.col = nearest;
+            }
+            _ => {}
+        }
+    }
+
+    /// Puts the mark on a key (the mouse).
+    pub fn mark(&mut self, row: usize, col: usize) {
+        let rows = self.rows();
+        if let Some(r) = rows.get(row)
+            && col < r.len()
+        {
+            self.row = row;
+            self.col = col;
+        }
+    }
+
+    /// Adds text at the end, as the game takes it (no control characters, no more than the limit). True if anything went in.
+    pub fn push_str(&mut self, s: &str) -> bool {
+        let before = self.text.chars().count();
+        let room = self.limit.saturating_sub(before);
+        let add: String = s.chars().filter(|c| !c.is_control()).take(room).collect();
+        self.text.push_str(&add);
+        !add.is_empty()
+    }
+
+    pub fn backspace(&mut self) {
+        self.text.pop();
+    }
+
+    /// Presses the marked key.
+    pub fn press(&mut self) -> Done {
+        match self.key() {
+            Key::Char(c) => {
+                self.push_str(&c.to_string());
+                // after a capital the letters go back to lower case, as a name is typed
+                if self.page == Page::Upper && c.is_alphabetic() {
+                    self.page = Page::Lower;
+                }
+            }
+            Key::Shift => self.page = if self.page == Page::Lower { Page::Upper } else { Page::Lower },
+            Key::Symbols => self.page = if self.page == Page::Symbols { Page::Lower } else { Page::Symbols },
+            Key::Space => {
+                if !self.text.is_empty() {
+                    self.push_str(" ");
+                }
+            }
+            Key::Backspace => self.backspace(),
+            Key::Cancel => return Done::Cancel,
+            Key::Accept => return self.accept(),
+        }
+        Done::No
+    }
+
+    /// The text is taken when it holds something besides blanks.
+    pub fn accept(&self) -> Done {
+        if self.text.trim().is_empty() && !self.allow_empty { Done::No } else { Done::Accept }
+    }
+
+    /// What a button of the pad does besides the cross and the stick: A presses the key, B deletes, X is a space, Y is shift, L and R
+    /// go to the other pages, Start accepts and Select cancels.
+    pub fn button(&mut self, b: u32) -> Done {
+        match b {
+            button::A => return self.press(),
+            button::B => self.backspace(),
+            button::X => {
+                if !self.text.is_empty() {
+                    self.push_str(" ");
+                }
+            }
+            button::Y => self.page = if self.page == Page::Lower { Page::Upper } else { Page::Lower },
+            button::L | button::ZL => self.page = if self.page == Page::Symbols { Page::Lower } else { Page::Symbols },
+            button::R | button::ZR => self.page = if self.page == Page::Symbols { Page::Lower } else { Page::Symbols },
+            button::PLUS => return self.accept(),
+            button::MINUS => return Done::Cancel,
+            _ => {}
+        }
+        Done::No
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn press_char(o: &mut Osk, c: char) {
+        let rows = o.rows();
+        for (r, row) in rows.iter().enumerate() {
+            if let Some(k) = row.iter().position(|k| *k == Key::Char(c)) {
+                o.mark(r, k);
+                o.press();
+                return;
+            }
+        }
+        panic!("no key {c}");
+    }
+
+    #[test]
+    fn keys_type_the_text_up_to_the_limit_and_a_capital_is_followed_by_lower_case() {
+        let mut o = Osk::new(5);
+        o.button(button::Y);
+        assert_eq!(o.page, Page::Upper);
+        press_char(&mut o, 'W');
+        assert_eq!(o.page, Page::Lower, "back to lower case after a capital");
+        press_char(&mut o, 'o');
+        press_char(&mut o, 'l');
+        press_char(&mut o, 'f');
+        press_char(&mut o, 'f');
+        press_char(&mut o, 'x');
+        assert_eq!(o.text, "Wolff", "nothing past the limit");
+        o.button(button::B);
+        assert_eq!(o.text, "Wolf");
+        o.button(button::X);
+        assert_eq!(o.text, "Wolf ");
+        assert_eq!(o.button(button::PLUS), Done::Accept);
+        assert_eq!(o.button(button::MINUS), Done::Cancel);
+    }
+
+    #[test]
+    fn the_mark_wraps_and_up_and_down_keep_to_the_same_place() {
+        let mut o = Osk::new(10);
+        o.mark(0, 0);
+        o.go(Nav::Left);
+        assert_eq!(o.col, 9, "left of the first key wraps to the last");
+        o.go(Nav::Right);
+        assert_eq!(o.col, 0);
+        // from the far right of the digits down to the last row: the key nearest in place (Accept, at the right)
+        o.mark(0, 9);
+        for _ in 0..4 {
+            o.go(Nav::Down);
+        }
+        assert!(matches!(o.key(), Key::Accept | Key::Cancel), "{:?}", o.key());
+        // up from there is back to the right of the letters
+        o.go(Nav::Up);
+        assert_eq!(o.row, 3);
+        assert!(o.col >= 8);
+        // the first row up wraps to the last row
+        o.mark(0, 4);
+        o.go(Nav::Up);
+        assert_eq!(o.row, 4);
+        // the middle of the keyboard goes down to the space bar
+        o.mark(3, 4);
+        o.go(Nav::Down);
+        assert_eq!(o.key(), Key::Space);
+    }
+
+    #[test]
+    fn an_empty_or_blank_text_is_not_taken_and_the_pages_switch() {
+        let mut o = Osk::new(10);
+        assert_eq!(o.accept(), Done::No);
+        o.push_str("   ");
+        assert_eq!(o.accept(), Done::No);
+        o.push_str("a\nb\t");
+        assert_eq!(o.text, "   ab", "control characters stay out");
+        o.mark(4, 1);
+        o.press();
+        assert_eq!(o.page, Page::Symbols);
+        assert!(matches!(o.rows()[1][0], Key::Char('á')));
+        o.press();
+        assert_eq!(o.page, Page::Lower);
+        o.button(button::L);
+        assert_eq!(o.page, Page::Symbols);
+        o.button(button::R);
+        assert_eq!(o.page, Page::Lower);
+        // a space is never the first thing typed
+        let mut p = Osk::new(10);
+        p.button(button::X);
+        assert_eq!(p.text, "");
+    }
+
+    #[test]
+    fn a_search_line_may_be_cleared_with_an_empty_text() {
+        let mut o = Osk::new(30);
+        o.allow_empty = true;
+        assert_eq!(o.accept(), Done::Accept);
+        assert_eq!(Osk::new(30).accept(), Done::No);
+    }
+
+    #[test]
+    fn every_key_has_a_label_in_both_languages() {
+        for k in [Key::Shift, Key::Symbols, Key::Space, Key::Backspace, Key::Cancel, Key::Accept] {
+            assert!(!k.label(Lang::En).is_empty() && !k.label(Lang::Es).is_empty());
+        }
+    }
+}
