+/// The CRC-32 (the zlib one) that Sony's Bluetooth output reports end with, over a seed byte 0xA2 and the report without its last 4 bytes.
+fn sony_crc(report: &[u8]) -> u32 {
+    let mut crc = !0u32;
+    for &b in std::iter::once(&0xa2u8).chain(&report[..report.len() - 4]) {
+        crc ^= u32::from(b);
+        for _ in 0..8 {
+            crc = (crc >> 1) ^ (0xedb8_8320 & 0u32.wrapping_sub(crc & 1));
+        }
+    }
+    !crc
+}
+
+/// The output report that sets a Sony pad's two motors (`strong` the big one on the left, `weak` the small one), `len` bytes long as the
+/// device's descriptor says (63 or 78 for a DualSense, 32 or 78 for a DualShock 4); `seq` numbers the Bluetooth ones. `None` for a pad
+/// that is neither.
+pub fn sony_rumble_report(product: u16, bluetooth: bool, len: usize, seq: u8, strong: u8, weak: u8, v2: bool) -> Option<Vec<u8>> {
+    let mut r = vec![0u8; len];
+    if DUALSENSE.contains(&product) {
+        // USB: 0x02, then the common block (flags, right motor, left motor...); Bluetooth: 0x31, sequence, tag 0x10, the block, CRC
+        let at = if bluetooth {
+            if len < 78 {
+                return None;
+            }
+            r[0] = 0x31;
+            r[1] = (seq & 0x0f) << 4;
+            r[2] = 0x10;
+            3
+        } else {
+            if len < 5 {
+                return None;
+            }
+            r[0] = 0x02;
+            1
+        };
+        // the lights are left as they are (their flags stay 0). Compatible vibration + haptics select is the pad's first rumble emulation, which
+        // feels dry and short; from firmware 2.24 on, haptics select + "compatible vibration 2" (a bit of the second flag byte, 38 bytes on)
+        // is the improved one (what Linux's driver uses for those pads)
+        if v2 && r.len() > at + 38 {
+            r[at] = 0x02;
+            r[at + 38] = 0x04;
+        } else {
+            r[at] = 0x03;
+        }
+        r[at + 2] = weak;
+        r[at + 3] = strong;
+    } else if DUALSHOCK4.contains(&product) {
+        let at = if bluetooth {
+            if len < 78 {
+                return None;
+            }
+            r[0] = 0x11;
+            // the HID and CRC flags and a poll rate
+            r[1] = 0xc4;
+            3
+        } else {
+            if len < 6 {
+                return None;
+            }
+            r[0] = 0x05;
+            1
+        };
+        r[at] = 0x01;
+        r[at + 3] = weak;
+        r[at + 4] = strong;
+    } else {
+        return None;
+    }
+    if bluetooth {
+        let n = r.len();
+        let crc = sony_crc(&r);
+        r[n - 4..].copy_from_slice(&crc.to_le_bytes());
+    }
+    Some(r)
+}
