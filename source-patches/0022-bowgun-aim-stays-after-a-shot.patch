             (true, false) => -AIM_STEP,
             (false, true) => AIM_STEP,
-            _ => return,
+            _ => 0,
         };
-        let now = i32::from(g.u32(ctrl + 0x184) as u16 as i16);
-        let step = (step as f32 * crate::input::right_stick_gain()).round() as i32;
-        let to = (now + step).clamp(-0x3e93, 0x3e94);
+        let to = if step == 0 {
+            if kept == NONE || kept == now {
+                return;
+            }
+            kept
+        } else {
+            let step = (step as f32 * crate::input::right_stick_gain()).round() as i32;
+            (if kept == NONE { now } else { kept } + step).clamp(-0x3e93, 0x3e94)
+        };
+        target.store(to, Relaxed);
