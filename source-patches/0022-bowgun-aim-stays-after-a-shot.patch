         }
+        let ctrl = g.u32(hunter.wrapping_add(0xe30));
+        if ctrl == 0 {
+            return;
+        }
+        if g.u8(ctrl + 0x58) != 1 {
+            // a short drop (the shot's own action) keeps the aim; a long one ends it
+            if off.fetch_add(1, Relaxed) >= 30 {
