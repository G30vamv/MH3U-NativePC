+/// towards `ctrl+0x184` (the target pitch). While aiming (`+0x58` is 1) the game moves that target with orders 0x2b/0x2c that nothing sets
+/// on this port, so the aim never moved. Here the target follows the pad instead: X (0x2000, the stick pushed up) raises it, Y (0x1000,
+/// down) lowers it, within the game's own limits (-0x3e93..0x3e94). The game zeroes the target when a shot starts, so the aimed pitch is
+/// kept here and put back on every update until the hunter stops aiming. Only the hunter that plays here is touched.
 fn aim_pitch() -> Callback {
+    const NONE: i32 = i32::MIN;
     let n = AtomicU32::new(0);
+    let target = AtomicI32::new(NONE);
