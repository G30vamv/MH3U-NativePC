+
+    #[test]
+    fn the_screen_filters_are_switches_that_start_on_and_come_back_with_y() {
+        let (mut v, e) = (values(), env());
+        assert_eq!(FxPrefs::default(), FxPrefs { bloom: true, blur: true, camera: true, gather: true, rumble: true, map: false });
+        let mut m = MenuState::default();
+        let at = |item: Item, v: &Values| rows(Tab::Graphics, v, &e).iter().position(|r| r.item == item).unwrap();
+        m.sel = at(Item::Bloom, &v);
+        assert_eq!(m.handle(Nav::Accept, &mut v, &e), Outcome::Changed);
+        assert_eq!(v.fx, FxPrefs { bloom: false, ..FxPrefs::default() });
+        m.sel = at(Item::Blur, &v);
+        assert_eq!(m.handle(Nav::Left, &mut v, &e), Outcome::Changed);
+        assert_eq!(v.fx, FxPrefs { bloom: false, blur: false, ..FxPrefs::default() });
+        for item in [Item::Bloom, Item::Blur] {
+            m.sel = at(item, &v);
+            assert_eq!(m.handle(Nav::Default, &mut v, &e), Outcome::Changed);
+        }
+        assert_eq!(v.fx, FxPrefs::default());
+    }
+
+    #[test]
+    fn the_screen_filter_choices_are_kept_in_a_file_and_read_back() {
+        let off = FxPrefs { bloom: false, blur: true, camera: false, gather: true, rumble: false, map: true };
+        assert_eq!(FxPrefs::parse(&off.to_text()), off);
+        assert_eq!(FxPrefs::parse(""), FxPrefs::default());
+        assert_eq!(FxPrefs::parse("bloom=1\nblur=0\ngather=0\nnonsense\n"), FxPrefs { bloom: true, blur: false, camera: true, gather: false, rumble: true, map: false });
+        assert_eq!(FxPrefs::load(std::path::Path::new("no/such/file.txt")), None, "no file: the launcher's settings stand");
+    }
+
+    #[test]
+    fn the_panel_choices_are_kept_in_a_file_and_read_back() {
+        assert_eq!(PanelPrefs::default(), PanelPrefs { small: false, scope: Scope::Hit, parts: true }, "small monsters are hidden at first");
+        let prefs = PanelPrefs { small: true, scope: Scope::All, parts: false };
+        assert_eq!(PanelPrefs::parse(&prefs.to_text()), prefs);
+        assert_eq!(PanelPrefs::parse(""), PanelPrefs::default());
+        assert_eq!(PanelPrefs::parse("nonsense\nscope=weird\nsmall=1\n"), PanelPrefs { small: true, ..PanelPrefs::default() });
+    }
+
+    #[test]
+    fn the_panel_rows_change_their_choices_and_y_brings_them_back() {
+        let (mut v, e) = (values(), env());
+        let mut m = MenuState::default();
+        m.go_to_tab(2, &v, &e);
+        let at = |item: Item, v: &Values| rows(Tab::Panels, v, &e).iter().position(|r| r.item == item).unwrap();
+        m.sel = at(Item::SmallMonsters, &v);
+        assert_eq!(m.handle(Nav::Accept, &mut v, &e), Outcome::Changed);
+        assert!(v.panels.small);
+        m.sel = at(Item::MonsterScope, &v);
+        assert_eq!(m.handle(Nav::Right, &mut v, &e), Outcome::Changed);
+        assert_eq!(v.panels.scope, Scope::All);
+        assert_eq!(m.handle(Nav::Accept, &mut v, &e), Outcome::Changed, "after the last choice it goes back to the first");
+        assert_eq!(v.panels.scope, Scope::Hit);
+        m.sel = at(Item::PartsShown, &v);
+        m.handle(Nav::Left, &mut v, &e);
+        assert!(!v.panels.parts);
+        for item in [Item::SmallMonsters, Item::PartsShown] {
+            m.sel = at(item, &v);
+            m.handle(Nav::Default, &mut v, &e);
+        }
+        assert_eq!(v.panels, PanelPrefs::default());
+        // with the life panel off these rows are greyed out
+        let off = Env { life_on: false, ..env() };
+        assert!(rows(Tab::Panels, &v, &off).iter().filter(|r| matches!(r.item, Item::SmallMonsters | Item::MonsterScope | Item::PartsShown)).all(|r| !r.enabled));
+    }
+
+    #[test]
+    fn keys_are_written_as_a_player_reads_them() {
+        assert_eq!(pretty_keys("KeyW KeyA KeyS KeyD (walk: ControlLeft)", Lang::En), "W A S D (walk: Ctrl)");
+        assert_eq!(pretty_keys("KeyW KeyA KeyS KeyD (walk: ControlLeft)", Lang::Es), "W A S D (caminar: Ctrl)");
+        assert_eq!(pretty_keys("MouseRight, KeyF", Lang::Es), "Clic der., F");
+        assert_eq!(pretty_keys("Space", Lang::Es), "Espacio");
+        assert_eq!(pretty_keys("Digit1", Lang::En), "1");
+        assert_eq!(pretty_keys("mouse (up and down inverted)", Lang::Es), "ratón (arriba y abajo invertidos)");
+    }
+
+    #[test]
+    fn left_and_right_change_a_choice_and_stop_at_its_ends() {
+        let (mut v, e) = (values(), env());
+        let mut m = MenuState::default();
+        assert_eq!(v.live.scale, 4, "1x to start");
+        assert_eq!(m.handle(Nav::Left, &mut v, &e), Outcome::Changed);
+        assert_eq!(v.live.scale, 3, "0.75x");
+        assert_eq!(m.handle(Nav::Left, &mut v, &e), Outcome::Changed);
+        assert_eq!(m.handle(Nav::Left, &mut v, &e), Outcome::Nothing, "0.5x is the first choice");
+        assert_eq!(v.live.scale, 2);
+        assert_eq!(m.handle(Nav::Right, &mut v, &e), Outcome::Changed);
+        assert_eq!(v.live.scale, 3);
+        for _ in 0..10 {
+            m.handle(Nav::Right, &mut v, &e);
+        }
+        assert_eq!(v.live.scale, 16, "and the last is the most");
+        let list = rows(Tab::Graphics, &v, &e);
+        assert!(matches!(&list[0].kind, Kind::Choice { left: true, right: false, .. }));
+    }
+
+    #[test]
+    fn accept_goes_to_the_next_choice_and_back_to_the_first_after_the_last() {
+        let (mut v, e) = (values(), env());
+        let mut m = MenuState { tab: 0, sel: 0 };
+        for _ in 0..settings::SCALES.len() {
+            assert_eq!(m.handle(Nav::Accept, &mut v, &e), Outcome::Changed);
+        }
+        assert_eq!(v.live.scale, 4, "seven presses of A on seven sizes come back to where it began");
+        // a toggle flips
+        let mut m = MenuState { tab: 0, sel: 5 };
+        assert!(!v.live.fps_counter);
+        m.handle(Nav::Accept, &mut v, &e);
+        assert!(v.live.fps_counter);
+        m.handle(Nav::Left, &mut v, &e);
+        assert!(!v.live.fps_counter);
+    }
+
+    #[test]
+    fn sliders_move_by_steps_inside_their_range() {
+        let (mut v, e) = (values(), env());
+        let mut m = MenuState { tab: 0, sel: 2 };
+        assert_eq!(v.sharp_pct, 75);
+        m.handle(Nav::Right, &mut v, &e);
+        assert_eq!(v.sharp_pct, 80);
+        for _ in 0..20 {
+            m.handle(Nav::Right, &mut v, &e);
+        }
+        assert_eq!(v.sharp_pct, 100);
+        for _ in 0..40 {
+            m.handle(Nav::Left, &mut v, &e);
+        }
+        assert_eq!(v.sharp_pct, 20);
+        // the camera: the same, and the live value follows
+        let mut m = MenuState { tab: 1, sel: 0 };
+        for _ in 0..40 {
+            m.handle(Nav::Right, &mut v, &e);
+        }
+        assert_eq!((v.stick_pct, v.live.right_stick), (150, 150));
+        assert!(set_slider(Item::CameraSens, 0.0, &mut v));
+        assert_eq!(v.stick_pct, 25);
+        assert!(set_slider(Item::CameraSens, 0.5, &mut v));
+        assert_eq!(v.stick_pct, 90, "the middle of 25 to 150 rounded to a step of 5");
+    }
+
+    #[test]
+    fn y_brings_a_value_back_to_its_usual_one() {
+        let (mut v, e) = (values(), env());
+        v.live.scale = 16;
+        v.live.fps_limit = 90;
+        let mut m = MenuState { tab: 0, sel: 0 };
+        assert_eq!(m.handle(Nav::Default, &mut v, &e), Outcome::Changed);
+        assert_eq!(v.live.scale, 4);
+        m.sel = 4;
+        m.handle(Nav::Default, &mut v, &e);
+        assert_eq!(v.live.fps_limit, 0);
+        assert_eq!(m.handle(Nav::Default, &mut v, &e), Outcome::Nothing, "already the usual one");
+    }
+
+    #[test]
+    fn the_tabs_wrap_and_the_buttons_ask_for_their_actions() {
+        let (mut v, e) = (values(), env());
+        let mut m = MenuState::default();
+        m.handle(Nav::TabPrev, &mut v, &e);
+        assert_eq!(m.tab(), Tab::Cheats);
+        m.handle(Nav::TabNext, &mut v, &e);
+        assert_eq!(m.tab(), Tab::Graphics);
+        m.go_to_tab(2, &v, &e);
+        m.sel = rows(Tab::Panels, &v, &e).iter().position(|r| r.item == Item::PartsShown).unwrap();
+        m.handle(Nav::Down, &mut v, &e);
+        assert_eq!(m.handle(Nav::Accept, &mut v, &e), Outcome::Action(Action::ResetCounter));
+        m.handle(Nav::Down, &mut v, &e);
+        assert_eq!(m.handle(Nav::Accept, &mut v, &e), Outcome::Action(Action::MovePanels));
+        assert_eq!(m.handle(Nav::Back, &mut v, &e), Outcome::Close);
+    }
+
+    #[test]
+    fn every_tab_lists_something_in_both_languages() {
+        let e = env();
+        for lang in [Lang::En, Lang::Es] {
+            let mut v = values();
+            v.live.lang = lang;
+            for tab in TABS {
+                let list = rows(tab, &v, &e);
+                assert!(!list.is_empty(), "{tab:?}");
+                assert!(list.iter().all(|r| !r.label.is_empty()), "{tab:?} has a row without a label");
+                // every row that can be changed says what it does (the lines of the information pages do not need to)
+                let changeable = |r: &&Row| r.selectable() && !matches!(r.kind, Kind::Info { .. });
+                assert!(list.iter().filter(changeable).all(|r| !r.help.is_empty()), "{tab:?} has a row without help");
+            }
+        }
+    }
+
+    #[test]
+    fn a_held_direction_repeats_after_a_wait_and_stops_when_let_go() {
+        let mut r = Repeater::default();
+        assert_eq!(r.update(Some(Nav::Right), 1.0), Some(Nav::Right), "the first press is at once");
+        assert_eq!(r.update(Some(Nav::Right), 1.2), None, "then it waits");
+        assert_eq!(r.update(Some(Nav::Right), 1.43), Some(Nav::Right));
+        assert_eq!(r.update(Some(Nav::Right), 1.45), None);
+        assert_eq!(r.update(Some(Nav::Right), 1.52), Some(Nav::Right), "and goes on at a steady beat");
+        assert_eq!(r.update(None, 1.6), None);
+        assert_eq!(r.update(Some(Nav::Right), 1.61), Some(Nav::Right), "let go and pushed again: at once");
+        assert_eq!(r.update(Some(Nav::Left), 1.62), Some(Nav::Left), "another direction counts as a new press");
+    }
+
+    #[test]
+    fn the_cross_and_the_left_stick_both_give_a_direction() {
+        use mh3u_rt::input::button;
+        assert_eq!(direction(button::UP, (0.0, 0.0)), Some(Nav::Up));
+        assert_eq!(direction(0, (0.2, 0.3)), None, "a stick that is barely pushed is nothing");
+        assert_eq!(direction(0, (0.0, 0.9)), Some(Nav::Up));
+        assert_eq!(direction(0, (0.0, -0.9)), Some(Nav::Down));
+        assert_eq!(direction(0, (-0.8, 0.5)), Some(Nav::Left));
+        assert_eq!(direction(button::LEFT, (0.9, 0.0)), Some(Nav::Left), "the cross wins");
+    }
+}
diff --git a/crates/mh3u-gfx/src/menu_draw.rs b/crates/mh3u-gfx/src/menu_draw.rs
new file mode 100644
index 0000000..e6449de
--- /dev/null
+++ b/crates/mh3u-gfx/src/menu_draw.rs
@@ -0,0 +1,430 @@
+//! How the in-game menu looks (`menu.rs` is what it holds). It is drawn in the middle of the screen over a dimmed game: a dark teal
+//! panel with a fine gold lattice, gold double borders with corner studs, the tabs as a row of names with a gold pill under the
+//! one in force, the rows in the font of the project (Cinzel, an engraved-capitals typeface under the SIL Open Font License; see
+//! `assets/OFL.txt`) with a bar sliding to the marked one, the help of the marked row and the keys at the bottom.
+//!
+//! Everything is sized from the panel's height, so the letters are big on a large screen and still fit on a small one.
+
+use crate::menu::{Item, Kind, MenuState, Row, TABS};
+use crate::settings::Lang;
+use egui::{Align2, Color32, FontFamily, FontId, Pos2, Rect, Shape, Stroke, vec2};
+use std::sync::Arc;
+
+/// The font family of the menu's big letters.
+pub fn title_family() -> FontFamily {
+    FontFamily::Name("mh".into())
+}
+
+/// Puts the project's font in egui (once). The default fonts stay behind it for any character it lacks.
+pub fn install_fonts(ctx: &egui::Context) {
+    let mut fonts = egui::FontDefinitions::default();
+    fonts.font_data.insert("cinzel".to_owned(), Arc::new(egui::FontData::from_static(include_bytes!("../assets/Cinzel.ttf"))));
+    let mut family = vec!["cinzel".to_owned()];
+    family.extend(fonts.families.get(&FontFamily::Proportional).cloned().unwrap_or_default());
+    fonts.families.insert(title_family(), family);
+    ctx.set_fonts(fonts);
+}
+
+// The palette: the launcher's deep teal and bright blue, and its gold.
+const GOLD: Color32 = Color32::from_rgb(0xd9, 0xb2, 0x5f);
+const GOLD_DIM: Color32 = Color32::from_rgb(0x8f, 0x76, 0x42);
+const CREAM: Color32 = Color32::from_rgb(0xe9, 0xdf, 0xc4);
+const BLUE: Color32 = Color32::from_rgb(0x4f, 0xc3, 0xd6);
+const BLUE_DEEP: Color32 = Color32::from_rgb(0x2a, 0x7f, 0x92);
+const INK: Color32 = Color32::from_rgb(0x10, 0x1a, 0x20);
+
+/// Where each part of the menu goes for a screen, in points.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Layout {
+    pub panel: Rect,
+    /// One unit: a 640th of the panel's height.
+    pub u: f32,
+    pub header: Rect,
+    pub tabs: Rect,
+    pub rows: Rect,
+    pub row_h: f32,
+    pub help: Rect,
+    pub keys: Rect,
+}
+
+pub fn layout(screen: Rect) -> Layout {
+    let h = (screen.height() * 0.86).max(300.0);
+    let w = (screen.width() * 0.78).min(h * 1.5).max(420.0).min(screen.width());
+    let h = h.min(screen.height());
+    let panel = Rect::from_center_size(screen.center(), vec2(w, h));
+    let u = h / 640.0;
+    let pad = 34.0 * u;
+    let inner = panel.shrink2(vec2(pad, 22.0 * u));
+    let header = Rect::from_min_size(inner.min, vec2(inner.width(), 58.0 * u));
+    let tabs = Rect::from_min_size(header.left_bottom() + vec2(0.0, 6.0 * u), vec2(inner.width(), 46.0 * u));
+    let keys = Rect::from_min_max(Pos2::new(inner.left(), inner.bottom() - 34.0 * u), inner.right_bottom());
+    let help = Rect::from_min_max(Pos2::new(inner.left(), keys.top() - 66.0 * u), Pos2::new(inner.right(), keys.top() - 8.0 * u));
+    let rows = Rect::from_min_max(Pos2::new(inner.left(), tabs.bottom() + 14.0 * u), Pos2::new(inner.right(), help.top() - 8.0 * u));
+    Layout { panel, u, header, tabs, rows, row_h: 55.0 * u, help, keys }
+}
+
+/// How many rows fit, and the first one shown so that the marked row is in view.
+pub fn window(rows_rect: Rect, row_h: f32, total: usize, sel: usize) -> (usize, usize) {
+    let fit = ((rows_rect.height() / row_h).floor() as usize).max(1);
+    let first = if sel < fit { 0 } else { sel + 1 - fit };
+    (first.min(total.saturating_sub(fit)), fit)
+}
+
+/// What the mouse did over the menu this frame.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum MouseAct {
+    Tab(usize),
+    /// The pointer is over this row.
+    Hover(usize),
+    /// A click on a row's body.
+    Click(usize),
+    /// A click on a row's left (-1) or right (1) arrow.
+    Arrow(usize, i32),
+    /// The pointer is on a slider's bar (press or drag): the fraction of the bar.
+    Slider(usize, f32),
+}
+
+fn alpha(c: Color32, a: f32) -> Color32 {
+    c.gamma_multiply(a.clamp(0.0, 1.0))
+}
+
+fn font(size: f32) -> FontId {
+    FontId::new(size, title_family())
+}
+
+fn triangle(p: &egui::Painter, centre: Pos2, size: f32, dir: i32, colour: Color32) {
+    let (dx, dy) = match dir {
+        -1 => (-1.0, 0.0),
+        1 => (1.0, 0.0),
+        _ => (0.0, if dir < -1 { -1.0 } else { 1.0 }),
+    };
+    let tip = centre + vec2(dx, dy) * size;
+    let (nx, ny) = (-dy, dx);
+    let base = centre - vec2(dx, dy) * size * 0.6;
+    p.add(Shape::convex_polygon(vec![tip, base + vec2(nx, ny) * size * 0.85, base - vec2(nx, ny) * size * 0.85], colour, Stroke::NONE));
+}
+
+fn diamond(p: &egui::Painter, centre: Pos2, r: f32, fill: Color32, stroke: Stroke) {
+    p.add(Shape::convex_polygon(
+        vec![centre + vec2(0.0, -r), centre + vec2(r, 0.0), centre + vec2(0.0, r), centre + vec2(-r, 0.0)],
+        fill,
+        stroke,
+    ));
+}
+
+/// A rectangle filled with a vertical gradient.
+fn gradient_v(p: &egui::Painter, rect: Rect, top: Color32, bottom: Color32) {
+    let mut mesh = egui::Mesh::default();
+    mesh.colored_vertex(rect.left_top(), top);
+    mesh.colored_vertex(rect.right_top(), top);
+    mesh.colored_vertex(rect.right_bottom(), bottom);
+    mesh.colored_vertex(rect.left_bottom(), bottom);
+    mesh.add_triangle(0, 1, 2);
+    mesh.add_triangle(0, 2, 3);
+    p.add(Shape::mesh(mesh));
+}
+
+/// A rectangle filled with a horizontal gradient.
+fn gradient_h(p: &egui::Painter, rect: Rect, left: Color32, right: Color32) {
+    let mut mesh = egui::Mesh::default();
+    mesh.colored_vertex(rect.left_top(), left);
+    mesh.colored_vertex(rect.right_top(), right);
+    mesh.colored_vertex(rect.right_bottom(), right);
+    mesh.colored_vertex(rect.left_bottom(), left);
+    mesh.add_triangle(0, 1, 2);
+    mesh.add_triangle(0, 2, 3);
+    p.add(Shape::mesh(mesh));
+}
+
+/// The panel behind everything: gradient, fine gold lattice, borders and studs.
+fn backdrop(p: &egui::Painter, l: &Layout, fade: f32) {
+    let u = l.u;
+    let panel = l.panel;
+    gradient_v(p, panel, alpha(Color32::from_rgb(0x0f, 0x28, 0x32), 0.97 * fade), alpha(Color32::from_rgb(0x05, 0x0d, 0x12), 0.98 * fade));
+    // a warm glow from the top, as light from a hall's window
+    gradient_v(
+        p,
+        Rect::from_min_size(panel.min, vec2(panel.width(), panel.height() * 0.38)),
+        alpha(Color32::from_rgb(0x6b, 0x55, 0x2a), 0.20 * fade),
+        Color32::TRANSPARENT,
+    );
+    // the lattice: two sets of diagonals, a net of diamonds
+    let clip = p.with_clip_rect(panel.shrink(2.0 * u));
+    let step = 44.0 * u;
+    let line = Stroke::new(1.0, alpha(GOLD, 0.055 * fade));
+    let mut x = panel.left() - panel.height();
+    while x < panel.right() {
+        clip.line_segment([Pos2::new(x, panel.bottom()), Pos2::new(x + panel.height(), panel.top())], line);
+        clip.line_segment([Pos2::new(x, panel.top()), Pos2::new(x + panel.height(), panel.bottom())], line);
+        x += step;
+    }
+    // a rosette of rings and rays, big and faint, behind the lower right
+    let c = panel.right_bottom() - vec2(panel.width() * 0.16, panel.height() * 0.22);
+    for (k, r) in [0.26f32, 0.34, 0.46, 0.50].iter().enumerate() {
+        clip.circle_stroke(c, panel.height() * r, Stroke::new(if k % 2 == 0 { 1.4 * u } else { 0.8 * u }, alpha(GOLD, 0.07 * fade)));
+    }
+    for i in 0..36 {
+        let a = i as f32 / 36.0 * std::f32::consts::TAU;
+        let (s0, s1) = (panel.height() * 0.34, panel.height() * if i % 3 == 0 { 0.52 } else { 0.46 });
+        clip.line_segment([c + vec2(a.cos(), a.sin()) * s0, c + vec2(a.cos(), a.sin()) * s1], Stroke::new(1.0, alpha(GOLD, 0.06 * fade)));
+    }
+    // the borders: a heavy gold one and a fine teal one inside
+    p.rect_stroke(panel, 3.0 * u, Stroke::new(2.2 * u, alpha(GOLD, fade)), egui::StrokeKind::Inside);
+    p.rect_stroke(panel.shrink(9.0 * u), 2.0 * u, Stroke::new(1.0, alpha(BLUE_DEEP, 0.9 * fade)), egui::StrokeKind::Inside);
+    // corner studs and the middle ones
+    for c in [panel.left_top(), panel.right_top(), panel.left_bottom(), panel.right_bottom()] {
+        let sx = if c.x < panel.center().x { 1.0 } else { -1.0 };
+        let sy = if c.y < panel.center().y { 1.0 } else { -1.0 };
+        let at = c + vec2(sx * 9.0 * u, sy * 9.0 * u);
+        diamond(p, at, 6.5 * u, alpha(GOLD, fade), Stroke::new(1.0, alpha(INK, fade)));
+        p.line_segment([at, at + vec2(sx * 40.0 * u, 0.0)], Stroke::new(1.6 * u, alpha(GOLD, fade)));
+        p.line_segment([at, at + vec2(0.0, sy * 40.0 * u)], Stroke::new(1.6 * u, alpha(GOLD, fade)));
+    }
+    for at in [panel.center_top(), panel.center_bottom()] {
+        diamond(p, at, 7.0 * u, alpha(GOLD, fade), Stroke::new(1.0, alpha(INK, fade)));
+    }
+}
+
+/// The word under the title: a gold line with a diamond in the middle.
+fn rule(p: &egui::Painter, y: f32, left: f32, right: f32, u: f32, fade: f32) {
+    let mid = (left + right) / 2.0;
+    gradient_h(p, Rect::from_min_max(Pos2::new(left, y), Pos2::new(mid, y + 1.6 * u)), Color32::TRANSPARENT, alpha(GOLD, fade));
+    gradient_h(p, Rect::from_min_max(Pos2::new(mid, y), Pos2::new(right, y + 1.6 * u)), alpha(GOLD, fade), Color32::TRANSPARENT);
+    diamond(p, Pos2::new(mid, y + 0.8 * u), 5.0 * u, alpha(GOLD, fade), Stroke::NONE);
+}
+
+/// One key of the bottom line: a small rounded cap with its name, then what it does.
+fn key_hint(p: &egui::Painter, at: Pos2, cap: &str, text: &str, u: f32, fade: f32) -> f32 {
+    let size = 15.0 * u;
+    let galley = p.layout_no_wrap(cap.to_string(), font(size), alpha(CREAM, fade));
+    let cap_w = (galley.size().x + 14.0 * u).max(26.0 * u);
+    let cap_rect = Rect::from_min_size(Pos2::new(at.x, at.y - 13.0 * u), vec2(cap_w, 26.0 * u));
+    p.rect_filled(cap_rect, 6.0 * u, alpha(Color32::from_rgb(0x1b, 0x34, 0x41), fade));
+    p.rect_stroke(cap_rect, 6.0 * u, Stroke::new(1.0, alpha(GOLD_DIM, fade)), egui::StrokeKind::Inside);
+    p.text(cap_rect.center(), Align2::CENTER_CENTER, cap, font(size), alpha(GOLD, fade));
+    let t = p.text(Pos2::new(cap_rect.right() + 7.0 * u, at.y), Align2::LEFT_CENTER, text, FontId::proportional(15.0 * u), alpha(CREAM, 0.8 * fade));
+    t.right() + 22.0 * u - at.x
+}
+
+/// Draws the menu and reports what the mouse did. `rows` are those of the page in force; `time` is the clock in seconds (for the
+/// fade-in); `fade` 0 to 1 is how much of the menu is shown.
+pub fn draw(ctx: &egui::Context, state: &MenuState, rows: &[Row], lang: Lang, fade: f32) -> Vec<MouseAct> {
+    let screen = ctx.content_rect();
+    let l = layout(screen);
+    let u = l.u;
+    let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Tooltip, egui::Id::new("mh3u_menu")));
+    let (pointer, pressed, down) = ctx.input(|i| (i.pointer.hover_pos(), i.pointer.primary_pressed(), i.pointer.primary_down()));
+    let mut acts = Vec::new();
+
+    // the game dims behind the panel
+    painter.rect_filled(screen, 0.0, Color32::from_black_alpha((170.0 * fade) as u8));
+    backdrop(&painter, &l, fade);
+
+    // header: the brand and the page's name
+    let brand = painter.text(l.header.left_center() + vec2(0.0, -2.0 * u), Align2::LEFT_CENTER, "MH3U NativePC", font(32.0 * u), alpha(GOLD, fade));
+    painter.text(
+        Pos2::new(brand.right() + 18.0 * u, l.header.center().y + 6.0 * u),
+        Align2::LEFT_CENTER,
+        lang.p("SETTINGS", "AJUSTES"),
+        font(17.0 * u),
+        alpha(CREAM, 0.55 * fade),
+    );
+    let hint_y = l.header.center().y;
+    let rb = painter.text(Pos2::new(l.header.right(), hint_y), Align2::RIGHT_CENTER, "RB", font(16.0 * u), alpha(GOLD_DIM, fade));
+    triangle(&painter, Pos2::new(rb.left() - 14.0 * u, hint_y), 6.0 * u, 1, alpha(GOLD_DIM, fade));
+    let lb = painter.text(Pos2::new(rb.left() - 74.0 * u, hint_y), Align2::RIGHT_CENTER, "LB", font(16.0 * u), alpha(GOLD_DIM, fade));
+    triangle(&painter, Pos2::new(lb.right() + 14.0 * u, hint_y), 6.0 * u, -1, alpha(GOLD_DIM, fade));
+    rule(&painter, l.header.bottom() - 2.0 * u, l.header.left(), l.header.right(), u, fade);
+
+    // tabs
+    let tab_w = l.tabs.width() / TABS.len() as f32;
+    for (i, tab) in TABS.iter().enumerate() {
+        let rect = Rect::from_min_size(l.tabs.min + vec2(tab_w * i as f32, 0.0), vec2(tab_w, l.tabs.height()));
+        let hover = pointer.is_some_and(|p| rect.contains(p));
+        if hover && pressed {
+            acts.push(MouseAct::Tab(i));
+        }
+        let on = i == state.tab;
+        if on {
+            let pill = rect.shrink2(vec2(10.0 * u, 5.0 * u));
+            gradient_v(&painter, pill, alpha(GOLD, fade), alpha(Color32::from_rgb(0xa8, 0x82, 0x3c), fade));
+            painter.rect_stroke(pill, 8.0 * u, Stroke::new(1.0, alpha(INK, fade)), egui::StrokeKind::Inside);
+        }
+        let colour = if on { INK } else if hover { CREAM } else { alpha(CREAM, 0.62) };
+        painter.text(rect.center(), Align2::CENTER_CENTER, tab.label(lang), font(23.0 * u), alpha(colour, fade));
+    }
+
+    // rows
+    let (first, fit) = window(l.rows, l.row_h, rows.len(), state.sel);
+    let label_x = l.rows.left() + 26.0 * u;
+    let value_left = l.rows.left() + l.rows.width() * 0.50;
+    let value_right = l.rows.right() - 18.0 * u;
+    for (slot, index) in (first..rows.len().min(first + fit)).enumerate() {
+        let row = &rows[index];
+        let rect = Rect::from_min_size(l.rows.min + vec2(0.0, l.row_h * slot as f32), vec2(l.rows.width(), l.row_h));
+        let marked = index == state.sel && row.selectable();
+        let hover = pointer.is_some_and(|p| rect.contains(p));
+        if hover && row.selectable() {
+            acts.push(MouseAct::Hover(index));
+        }
+        if marked {
+            // the bar under the marked row, with a gold tick and a marker
+            gradient_h(&painter, rect.shrink2(vec2(0.0, 3.0 * u)), alpha(BLUE_DEEP, 0.85 * fade), Color32::TRANSPARENT);
+            painter.rect_filled(
+                Rect::from_min_size(rect.left_top() + vec2(0.0, 3.0 * u), vec2(4.0 * u, rect.height() - 6.0 * u)),
+                0.0,
+                alpha(GOLD, fade),
+            );
+            triangle(&painter, Pos2::new(rect.left() + 17.0 * u, rect.center().y), 7.0 * u, 1, alpha(GOLD, fade));
+        }
+        let live = row.enabled;
+        let label_colour = if !live { alpha(CREAM, 0.30) } else if marked { GOLD } else { alpha(CREAM, 0.92) };
+        painter.text(Pos2::new(label_x, rect.center().y), Align2::LEFT_CENTER, &row.label, font(26.0 * u), alpha(label_colour, fade));
+
+        let value_colour = if !live { alpha(CREAM, 0.3) } else if marked { Color32::WHITE } else { BLUE };
+        let cy = rect.center().y;
+        match &row.kind {
+            Kind::Choice { text, left, right } => {
+                let arrow = |on: bool| if !live || !on { alpha(GOLD_DIM, 0.35 * fade) } else if marked { alpha(GOLD, fade) } else { alpha(GOLD_DIM, fade) };
+                let (lx, rx) = (value_left + 12.0 * u, value_right - 12.0 * u);
+                triangle(&painter, Pos2::new(lx, cy), 8.0 * u, -1, arrow(*left));
+                triangle(&painter, Pos2::new(rx, cy), 8.0 * u, 1, arrow(*right));
+                painter.text(Pos2::new((lx + rx) / 2.0, cy), Align2::CENTER_CENTER, text, font(23.0 * u), alpha(value_colour, fade));
+                if pressed && live {
+                    if let Some(p) = pointer {
+                        let zone = |x: f32| Rect::from_center_size(Pos2::new(x, cy), vec2(44.0 * u, l.row_h));
+                        if zone(lx).contains(p) {
+                            acts.push(MouseAct::Arrow(index, -1));
+                        } else if zone(rx).contains(p) {
+                            acts.push(MouseAct::Arrow(index, 1));
+                        } else if rect.contains(p) {
+                            acts.push(MouseAct::Click(index));
+                        }
+                    }
+                }
+            }
+            Kind::Slider { frac, text } => {
+                let text_w = 74.0 * u;
+                let bar = Rect::from_min_max(Pos2::new(value_left, cy - 5.0 * u), Pos2::new(value_right - text_w - 12.0 * u, cy + 5.0 * u));
+                painter.rect_filled(bar, 5.0 * u, alpha(Color32::from_rgb(0x08, 0x12, 0x18), fade));
+                painter.rect_stroke(bar, 5.0 * u, Stroke::new(1.0, alpha(if live { GOLD_DIM } else { alpha(GOLD_DIM, 0.4) }, fade)), egui::StrokeKind::Inside);
+                let fill = Rect::from_min_max(bar.min, Pos2::new(bar.left() + bar.width() * frac.clamp(0.0, 1.0), bar.bottom()));
+                if fill.width() > 1.0 {
+                    gradient_h(&painter, fill.shrink(1.5 * u), alpha(BLUE_DEEP, if live { fade } else { 0.4 * fade }), alpha(if live { GOLD } else { GOLD_DIM }, fade));
+                }
+                diamond(&painter, Pos2::new(fill.right(), cy), 8.5 * u, alpha(if live { GOLD } else { GOLD_DIM }, fade), Stroke::new(1.0, alpha(INK, fade)));
+                painter.text(Pos2::new(value_right, cy), Align2::RIGHT_CENTER, text, font(23.0 * u), alpha(value_colour, fade));
+                if live && let Some(p) = pointer {
+                    let zone = bar.expand2(vec2(10.0 * u, 12.0 * u));
+                    if (pressed || down) && zone.contains(p) {
+                        acts.push(MouseAct::Slider(index, ((p.x - bar.left()) / bar.width().max(1.0)).clamp(0.0, 1.0)));
+                    }
+                }
+            }
+            Kind::Toggle { on } => {
+                let track = Rect::from_center_size(Pos2::new(value_right - 34.0 * u, cy), vec2(66.0 * u, 28.0 * u));
+                let fill = if *on { alpha(BLUE_DEEP, fade) } else { alpha(Color32::from_rgb(0x1b, 0x2a, 0x32), fade) };
+                painter.rect_filled(track, 14.0 * u, fill);
+                painter.rect_stroke(track, 14.0 * u, Stroke::new(1.0, alpha(if *on { GOLD } else { GOLD_DIM }, fade)), egui::StrokeKind::Inside);
+                let knob_x = if *on { track.right() - 14.0 * u } else { track.left() + 14.0 * u };
+                painter.circle_filled(Pos2::new(knob_x, cy), 10.0 * u, alpha(if *on { GOLD } else { CREAM }, if *on { fade } else { 0.6 * fade }));
+                painter.text(
+                    Pos2::new(track.left() - 14.0 * u, cy),
+                    Align2::RIGHT_CENTER,
+                    if *on { lang.p("On", "Sí") } else { lang.p("Off", "No") },
+                    font(20.0 * u),
+                    alpha(value_colour, fade),
+                );
+                if pressed && live && pointer.is_some_and(|p| rect.contains(p)) {
+                    acts.push(MouseAct::Click(index));
+                }
+            }
+            Kind::Button => {
+                let cap = Rect::from_center_size(Pos2::new(value_right - 62.0 * u, cy), vec2(124.0 * u, 34.0 * u));
+                let fill = if marked { alpha(GOLD, fade) } else { alpha(Color32::from_rgb(0x1b, 0x34, 0x41), fade) };
+                painter.rect_filled(cap, 8.0 * u, fill);
+                painter.rect_stroke(cap, 8.0 * u, Stroke::new(1.0, alpha(if live { GOLD } else { GOLD_DIM }, fade)), egui::StrokeKind::Inside);
+                painter.text(
+                    cap.center(),
+                    Align2::CENTER_CENTER,
+                    if row.item == Item::ResetCounter { lang.p("Reset", "Reiniciar") } else { lang.p("Accept", "Aceptar") },
+                    font(18.0 * u),
+                    alpha(if marked { INK } else if live { GOLD } else { alpha(CREAM, 0.3) }, fade),
+                );
+                if pressed && live && pointer.is_some_and(|p| rect.contains(p)) {
+                    acts.push(MouseAct::Click(index));
+                }
+            }
+            Kind::Info { text } => {
+                painter.text(Pos2::new(value_right, cy), Align2::RIGHT_CENTER, text, font(22.0 * u), alpha(BLUE, 0.9 * fade));
+            }
+        }
+        // a fine line between rows
+        painter.line_segment(
+            [Pos2::new(rect.left() + 20.0 * u, rect.bottom()), Pos2::new(rect.right() - 20.0 * u, rect.bottom())],
+            Stroke::new(1.0, alpha(GOLD, 0.10 * fade)),
+        );
+    }
+    // more rows above or below
+    if first > 0 {
+        triangle(&painter, Pos2::new(l.rows.center().x, l.rows.top() + 2.0 * u), 6.0 * u, -2, alpha(GOLD, fade));
+    }
+    if first + fit < rows.len() {
+        triangle(&painter, Pos2::new(l.rows.center().x, l.rows.bottom() - 2.0 * u), 6.0 * u, 2, alpha(GOLD, fade));
+    }
+
+    // the help of the marked row
+    if let Some(row) = rows.get(state.sel).filter(|r| r.selectable() && !r.help.is_empty()) {
+        let galley = painter.layout(row.help.clone(), FontId::proportional(17.5 * u), alpha(CREAM, 0.88 * fade), l.help.width() - 40.0 * u);
+        let box_rect = Rect::from_min_size(l.help.min, vec2(l.help.width(), l.help.height().max(galley.size().y + 14.0 * u)));
+        painter.rect_filled(box_rect, 6.0 * u, alpha(Color32::from_rgb(0x08, 0x12, 0x18), 0.75 * fade));
+        painter.rect_stroke(box_rect, 6.0 * u, Stroke::new(1.0, alpha(BLUE_DEEP, fade)), egui::StrokeKind::Inside);
+        diamond(&painter, Pos2::new(box_rect.left() + 16.0 * u, box_rect.center().y), 4.5 * u, alpha(GOLD, fade), Stroke::NONE);
+        painter.galley(Pos2::new(box_rect.left() + 32.0 * u, box_rect.center().y - galley.size().y / 2.0), galley, CREAM);
+    }
+
+    // the keys
+    let mut x = l.keys.left();
+    let y = l.keys.center().y;
+    x += key_hint(&painter, Pos2::new(x, y), "A", lang.p("Accept  (Enter)", "Aceptar  (Enter)"), u, fade);
+    x += key_hint(&painter, Pos2::new(x, y), "B", lang.p("Back  (Esc)", "Volver  (Esc)"), u, fade);
+    x += key_hint(&painter, Pos2::new(x, y), "Y", lang.p("Usual  (Del)", "Normal  (Supr)"), u, fade);
+    key_hint(&painter, Pos2::new(x, y), "LB RB", lang.p("Pages  (Q / E)", "Páginas  (Q / E)"), u, fade);
+    acts
+}
