+//! Texture packs: a texture the game loads can be swapped for a DDS file, and the originals can be saved to make one.
+//!
+//! A texture is known by the CRC-32 of its first level as the port decodes it (the bytes the GPU gets, before any swap). A file
+//! whose name starts with that number as eight hex digits (`1a2b3c4d.dds`, or `1a2b3c4d_256x256_wall.dds`) in the packs folder
+//! (`MH3U_TEXTURE_PACKS`, searched with its subfolders) takes the texture's place. `MH3U_TEXTURE_DUMP` is a folder where each
+//! texture met is written once as `<crc>_<width>x<height>.dds`, in the channel order the replacements must keep. Only flat
+//! textures (no arrays, cubes or volumes) in RGBA8 and BC1 to BC5 (BC7 too on the way in) are touched; the others stay as the
+//! game made them.
+
+use crate::texture::{Decoded, Level};
+use std::collections::{HashMap, HashSet};
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, OnceLock};
+use wgpu::TextureFormat as F;
+
+struct Config {
+    packs: HashMap<u32, PathBuf>,
+    dump: Option<PathBuf>,
+    dumped: Mutex<HashSet<u32>>,
+    swapped: Mutex<u32>,
+}
+
+static CONFIG: OnceLock<Option<Config>> = OnceLock::new();
+
+fn config() -> Option<&'static Config> {
+    CONFIG
+        .get_or_init(|| {
+            let dir = |name: &str| std::env::var_os(name).filter(|v| !v.is_empty()).map(PathBuf::from);
+            let (packs_dir, dump) = (dir("MH3U_TEXTURE_PACKS"), dir("MH3U_TEXTURE_DUMP"));
+            if packs_dir.is_none() && dump.is_none() {
+                return None;
+            }
+            let mut packs = HashMap::new();
+            if let Some(d) = &packs_dir {
+                scan(d, &mut packs, 0);
+                eprintln!("[textures] pack folder {}: {} replacement(s)", d.display(), packs.len());
+            }
+            if let Some(d) = &dump {
+                let _ = std::fs::create_dir_all(d);
+                eprintln!("[textures] saving the textures met to {}", d.display());
+            }
+            Some(Config {
+                packs,
+                dump,
+                dumped: Mutex::new(HashSet::new()),
+                swapped: Mutex::new(0),
+            })
+        })
+        .as_ref()
+}
+
+fn scan(dir: &Path, out: &mut HashMap<u32, PathBuf>, depth: u32) {
+    let Ok(entries) = std::fs::read_dir(dir) else { return };
+    for e in entries.flatten() {
+        let path = e.path();
+        if path.is_dir() {
+            if depth < 4 {
+                scan(&path, out, depth + 1);
+            }
+        } else if path.extension().is_some_and(|x| x.eq_ignore_ascii_case("dds")) {
+            let stem = path.file_stem().and_then(|s| s.to_str()).unwrap_or("");
+            if let Some(crc) = stem.get(..8).and_then(|h| u32::from_str_radix(h, 16).ok()) {
+                out.entry(crc).or_insert(path);
+            }
+        }
+    }
+}
+
+/// CRC-32 (the common one, as zip uses).
+pub fn crc32(data: &[u8]) -> u32 {
+    static TABLE: OnceLock<[u32; 256]> = OnceLock::new();
+    let table = TABLE.get_or_init(|| {
+        std::array::from_fn(|i| {
+            (0..8).fold(i as u32, |c, _| if c & 1 != 0 { 0xedb8_8320 ^ (c >> 1) } else { c >> 1 })
+        })
+    });
+    !data.iter().fold(!0u32, |c, &b| table[((c ^ u32::from(b)) & 0xff) as usize] ^ (c >> 8))
+}
+
+/// Bytes per block (or per texel) and the block's side, for the formats handled.
+fn layout(f: F) -> Option<(u32, u32)> {
+    Some(match f {
+        F::Rgba8Unorm | F::Rgba8UnormSrgb => (4, 1),
+        F::Bc1RgbaUnorm | F::Bc1RgbaUnormSrgb | F::Bc4RUnorm => (8, 4),
+        F::Bc2RgbaUnorm
+        | F::Bc2RgbaUnormSrgb
+        | F::Bc3RgbaUnorm
+        | F::Bc3RgbaUnormSrgb
+        | F::Bc5RgUnorm
+        | F::Bc7RgbaUnorm
+        | F::Bc7RgbaUnormSrgb => (16, 4),
+        _ => return None,
+    })
+}
+
+fn is_srgb(f: F) -> bool {
+    matches!(
+        f,
+        F::Rgba8UnormSrgb | F::Bc1RgbaUnormSrgb | F::Bc2RgbaUnormSrgb | F::Bc3RgbaUnormSrgb | F::Bc7RgbaUnormSrgb
+    )
+}
+
+fn with_srgb(f: F, srgb: bool) -> F {
+    match (f, srgb) {
+        (F::Rgba8Unorm, true) => F::Rgba8UnormSrgb,
+        (F::Bc1RgbaUnorm, true) => F::Bc1RgbaUnormSrgb,
+        (F::Bc2RgbaUnorm, true) => F::Bc2RgbaUnormSrgb,
+        (F::Bc3RgbaUnorm, true) => F::Bc3RgbaUnormSrgb,
+        (F::Bc7RgbaUnorm, true) => F::Bc7RgbaUnormSrgb,
+        (F::Rgba8UnormSrgb, false) => F::Rgba8Unorm,
+        (F::Bc1RgbaUnormSrgb, false) => F::Bc1RgbaUnorm,
+        (F::Bc2RgbaUnormSrgb, false) => F::Bc2RgbaUnorm,
+        (F::Bc3RgbaUnormSrgb, false) => F::Bc3RgbaUnorm,
+        (F::Bc7RgbaUnormSrgb, false) => F::Bc7RgbaUnorm,
+        (f, _) => f,
+    }
+}
+
+fn put(out: &mut Vec<u8>, v: u32) {
+    out.extend_from_slice(&v.to_le_bytes());
+}
+
+/// The texture as a DDS file (every level it has).
+pub fn to_dds(d: &Decoded) -> Option<Vec<u8>> {
+    layout(d.format)?;
+    let mut out = b"DDS ".to_vec();
+    put(&mut out, 124);
+    put(&mut out, 0x1 | 0x2 | 0x4 | 0x1000 | 0x20000 | 0x80000); // caps, height, width, pixel format, mip count, linear size
+    put(&mut out, d.height);
+    put(&mut out, d.width);
+    put(&mut out, d.levels.first()?.data.len() as u32);
+    put(&mut out, 0);
+    put(&mut out, d.levels.len() as u32);
+    for _ in 0..11 {
+        put(&mut out, 0);
+    }
+    // the pixel format
+    put(&mut out, 32);
+    let fourcc: Option<&[u8; 4]> = match d.format {
+        F::Bc1RgbaUnorm | F::Bc1RgbaUnormSrgb => Some(b"DXT1"),
+        F::Bc2RgbaUnorm | F::Bc2RgbaUnormSrgb => Some(b"DXT3"),
+        F::Bc3RgbaUnorm | F::Bc3RgbaUnormSrgb => Some(b"DXT5"),
+        F::Bc4RUnorm => Some(b"BC4U"),
+        F::Bc5RgUnorm => Some(b"BC5U"),
+        F::Bc7RgbaUnorm | F::Bc7RgbaUnormSrgb => Some(b"DX10"),
+        _ => None,
+    };
+    match fourcc {
+        Some(c) => {
+            put(&mut out, 0x4);
+            out.extend_from_slice(c);
+            for _ in 0..5 {
+                put(&mut out, 0);
+            }
+        }
+        None => {
+            put(&mut out, 0x41);
+            put(&mut out, 0);
+            put(&mut out, 32);
+            put(&mut out, 0xff);
+            put(&mut out, 0xff00);
+            put(&mut out, 0xff_0000);
+            put(&mut out, 0xff00_0000);
+        }
+    }
+    put(&mut out, 0x1000 | 0x400000 | 0x8);
+    for _ in 0..4 {
+        put(&mut out, 0);
+    }
+    if matches!(d.format, F::Bc7RgbaUnorm | F::Bc7RgbaUnormSrgb) {
+        put(&mut out, if is_srgb(d.format) { 99 } else { 98 });
+        put(&mut out, 3); // 2D
+        put(&mut out, 0);
+        put(&mut out, 1);
+        put(&mut out, 0);
+    }
+    for l in &d.levels {
+        out.extend_from_slice(&l.data);
+    }
+    Some(out)
+}
+
+/// A DDS file read into levels (flat textures only), or why not. `was_srgb`: the original texture was in sRGB, and the swap keeps it.
+pub fn from_dds(file: &[u8], was_srgb: bool) -> Result<Decoded, String> {
+    let u32_at = |at: usize| {
+        file.get(at..at + 4)
+            .map(|b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+            .ok_or_else(|| "a short file".to_string())
+    };
+    if file.get(..4) != Some(b"DDS ") || u32_at(4)? != 124 {
+        return Err("not a DDS file".into());
+    }
+    let (height, width) = (u32_at(12)?, u32_at(16)?);
+    let mips = u32_at(28)?.max(1);
+    let (pf_flags, bits) = (u32_at(80)?, u32_at(88)?);
+    let fourcc: [u8; 4] = file.get(84..88).and_then(|b| b.try_into().ok()).ok_or("a short file")?;
+    if u32_at(112)? & (0x200 | 0x200000) != 0 {
+        return Err("cube maps and volumes are not supported".into());
+    }
+    let mut data_at = 128;
+    let mut swap_rb = false;
+    let format = if pf_flags & 0x4 != 0 {
+        match &fourcc {
+            b"DXT1" => F::Bc1RgbaUnorm,
+            b"DXT3" => F::Bc2RgbaUnorm,
+            b"DXT5" => F::Bc3RgbaUnorm,
+            b"BC4U" | b"ATI1" => F::Bc4RUnorm,
+            b"BC5U" | b"ATI2" => F::Bc5RgUnorm,
+            b"DX10" => {
+                let dxgi = u32_at(128)?;
+                if u32_at(140)? > 1 {
+                    return Err("texture arrays are not supported".into());
+                }
+                data_at = 148;
+                match dxgi {
+                    71 | 72 => F::Bc1RgbaUnorm,
+                    74 | 75 => F::Bc2RgbaUnorm,
+                    77 | 78 => F::Bc3RgbaUnorm,
+                    80 => F::Bc4RUnorm,
+                    83 => F::Bc5RgUnorm,
+                    98 | 99 => F::Bc7RgbaUnorm,
+                    28 | 29 => F::Rgba8Unorm,
+                    87 | 91 => {
+                        swap_rb = true;
+                        F::Rgba8Unorm
+                    }
+                    n => return Err(format!("the DXGI format {n} is not supported")),
+                }
+            }
+            _ => return Err("this DDS pixel format is not supported".into()),
+        }
+    } else if pf_flags & 0x40 != 0 && bits == 32 {
+        swap_rb = u32_at(92)? == 0xff_0000;
+        F::Rgba8Unorm
+    } else {
+        return Err("this DDS pixel format is not supported (use BC1/BC3/BC7 or 32-bit RGBA)".into());
+    };
+    let (bytes, block) = layout(format).ok_or("a format that cannot be used")?;
+    let format = with_srgb(format, was_srgb);
+    if width == 0 || height == 0 || width > 16384 || height > 16384 {
+        return Err("an empty or huge texture".into());
+    }
+    let max_levels = 32 - width.max(height).leading_zeros();
+    let mut levels = Vec::new();
+    let mut at = data_at;
+    for n in 0..mips.min(max_levels) {
+        let (w, h) = ((width >> n).max(1), (height >> n).max(1));
+        let (bw, bh) = (w.div_ceil(block), h.div_ceil(block));
+        let size = (bw * bh * bytes) as usize;
+        let Some(src) = file.get(at..at + size) else {
+            if levels.is_empty() {
+                return Err("the file is shorter than its first level".into());
+            }
+            break;
+        };
+        let mut data = src.to_vec();
+        if swap_rb {
+            for px in data.chunks_exact_mut(4) {
+                px.swap(0, 2);
+            }
+        }
+        levels.push(Level {
+            width: bw * block,
+            height: bh * block,
+            depth: 1,
+            bytes_per_row: bw * bytes,
+            data,
+        });
+        at += size;
+    }
+    Ok(Decoded {
+        width: width.next_multiple_of(block),
+        height: height.next_multiple_of(block),
+        layers: 1,
+        volume: false,
+        format,
+        laid_pitch: 0,
+        levels,
+    })
+}
+
+/// Called with every texture decoded: saves it to the dump folder and, if the packs have a file for it, puts that in its place.
+pub fn apply(d: &mut Decoded) {
+    let Some(c) = config() else { return };
+    if d.layers != 1 || d.volume || layout(d.format).is_none() || d.levels.is_empty() {
+        return;
+    }
+    let crc = crc32(&d.levels[0].data);
+    if let Some(dir) = &c.dump {
+        let first = c.dumped.lock().map(|mut s| s.insert(crc)).unwrap_or(false);
+        if first {
+            if let Some(file) = to_dds(d) {
+                let _ = std::fs::write(dir.join(format!("{crc:08x}_{}x{}.dds", d.width, d.height)), file);
+            }
+        }
+    }
+    if let Some(path) = c.packs.get(&crc) {
+        match std::fs::read(path).map_err(|e| e.to_string()).and_then(|f| from_dds(&f, is_srgb(d.format))) {
+            Ok(new) => {
+                let n = c
+                    .swapped
+                    .lock()
+                    .map(|mut n| {
+                        *n += 1;
+                        *n
+                    })
+                    .unwrap_or(0);
+                if n <= 20 {
+                    eprintln!("[textures] {crc:08x} replaced by {} ({}x{})", path.display(), new.width, new.height);
+                }
+                d.width = new.width;
+                d.height = new.height;
+                d.format = new.format;
+                d.levels = new.levels;
+            }
+            Err(e) => eprintln!("[textures] {} left out: {e}", path.display()),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn flat(format: F, w: u32, h: u32, byte: u8) -> Decoded {
+        let (bytes, block) = layout(format).unwrap();
+        let (bw, bh) = (w.div_ceil(block), h.div_ceil(block));
+        Decoded {
+            width: w,
+            height: h,
+            layers: 1,
+            volume: false,
+            format,
+            laid_pitch: 0,
+            levels: vec![Level {
+                width: w,
+                height: h,
+                depth: 1,
+                bytes_per_row: bw * bytes,
+                data: vec![byte; (bw * bh * bytes) as usize],
+            }],
+        }
+    }
+
+    #[test]
+    fn crc_is_the_common_one() {
+        assert_eq!(crc32(b"123456789"), 0xcbf4_3926);
+    }
+
+    #[test]
+    fn what_is_saved_reads_back_the_same() {
+        for f in [F::Rgba8Unorm, F::Bc1RgbaUnorm, F::Bc3RgbaUnorm, F::Bc5RgUnorm, F::Bc7RgbaUnorm] {
+            let d = flat(f, 16, 8, 0x5a);
+            let back = from_dds(&to_dds(&d).unwrap(), false).unwrap();
+            assert_eq!((back.width, back.height, back.format), (16, 8, f));
+            assert_eq!(back.levels[0].data, d.levels[0].data, "{f:?}");
+            assert_eq!(back.levels[0].bytes_per_row, d.levels[0].bytes_per_row);
+        }
+    }
+
+    #[test]
+    fn a_replacement_keeps_the_colour_space_of_the_original() {
+        let d = flat(F::Bc1RgbaUnorm, 8, 8, 1);
+        assert_eq!(from_dds(&to_dds(&d).unwrap(), true).unwrap().format, F::Bc1RgbaUnormSrgb);
+    }
+
+    #[test]
+    fn bad_files_are_refused() {
+        assert!(from_dds(b"nope", false).is_err());
+        let mut f = to_dds(&flat(F::Bc1RgbaUnorm, 8, 8, 1)).unwrap();
+        f.truncate(130);
+        assert!(from_dds(&f, false).is_err());
+    }
+}
