+/// The values every row goes back to with Y.
+fn default_values(v: &Values) -> Values {
+    let live = Live::factory(v.live.lang);
+    Values { live, sharp_pct: (live.sharpness * 100.0).round() as u32, stick_pct: live.right_stick, panels: PanelPrefs::default(), fx: FxPrefs::default() }
+}
+
+/// Moves a choice by `dir` (clamped), or sets a slider by steps.
+fn step(index: usize, count: usize, dir: i32) -> usize {
+    (index as i32 + dir).clamp(0, count as i32 - 1) as usize
+}
+
+/// Changes the value of `item` by one step in `dir` (-1 or 1). True if something changed.
+pub fn adjust(item: Item, dir: i32, v: &mut Values) -> bool {
+    let before = *v;
+    match item {
+        Item::Scale => v.live.scale = settings::SCALES[step(index_of(&settings::SCALES, v.live.scale), settings::SCALES.len(), dir)],
+        Item::Upscaler => v.live.upscaler = UPSCALERS[step(index_of(&UPSCALERS, v.live.upscaler), UPSCALERS.len(), dir)],
+        Item::Sharpness => {
+            if v.live.upscaler != Upscaler::Off {
+                v.sharp_pct = (v.sharp_pct as i32 + dir * SHARP_STEP as i32).clamp(SHARP_RANGE.0 as i32, SHARP_RANGE.1 as i32) as u32;
+            }
+        }
+        Item::Present => v.live.present = PRESENTS[step(index_of(&PRESENTS, v.live.present), PRESENTS.len(), dir)],
+        Item::FpsLimit => {
+            let all = fps_choices();
+            v.live.fps_limit = all[step(index_of(&all, v.live.fps_limit), all.len(), dir)];
+        }
+        Item::FpsCounter => v.live.fps_counter = !v.live.fps_counter,
+        Item::Bloom => v.fx.bloom = !v.fx.bloom,
+        Item::Blur => v.fx.blur = !v.fx.blur,
+        Item::SmoothCamera => v.fx.camera = !v.fx.camera,
+        Item::HoldGather => v.fx.gather = !v.fx.gather,
+        Item::Rumble => v.fx.rumble = !v.fx.rumble,
+        Item::QuestMap => v.fx.map = !v.fx.map,
+        Item::SmallMonsters => v.panels.small = !v.panels.small,
+        Item::PartsShown => v.panels.parts = !v.panels.parts,
+        Item::MonsterScope => v.panels.scope = if dir < 0 { Scope::Hit } else { Scope::All },
+        Item::CameraSens => {
+            v.stick_pct = (v.stick_pct as i32 + dir * STICK_STEP as i32).clamp(STICK_RANGE.0 as i32, STICK_RANGE.1 as i32) as u32;
+            v.live.right_stick = v.stick_pct;
+        }
+        Item::Language => v.live.lang = if dir < 0 { Lang::En } else { Lang::Es },
+        Item::ResetCounter | Item::ResetPanels | Item::MovePanels | Item::Info => {}
+    }
+    *v != before
+}
+
+/// Sets a slider to a fraction of its range (the mouse), in whole steps. True if something changed.
+pub fn set_slider(item: Item, frac: f32, v: &mut Values) -> bool {
+    let before = *v;
+    let pick = |(low, high): (u32, u32), step: u32| {
+        let raw = low as f32 + frac.clamp(0.0, 1.0) * (high - low) as f32;
+        (((raw - low as f32) / step as f32).round() as u32 * step + low).clamp(low, high)
+    };
+    match item {
+        Item::Sharpness if v.live.upscaler != Upscaler::Off => v.sharp_pct = pick(SHARP_RANGE, SHARP_STEP),
+        Item::CameraSens => {
+            v.stick_pct = pick(STICK_RANGE, STICK_STEP);
+            v.live.right_stick = v.stick_pct;
+        }
+        _ => {}
+    }
+    *v != before
+}
