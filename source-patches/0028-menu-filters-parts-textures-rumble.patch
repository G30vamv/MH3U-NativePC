+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_menu_sits_in_the_middle_and_inside_the_screen_at_any_size() {
+        for (w, h) in [(1280.0, 720.0), (1920.0, 1080.0), (2560.0, 1440.0), (3840.0, 2160.0), (1024.0, 768.0), (800.0, 600.0), (1280.0, 1024.0)] {
+            let screen = Rect::from_min_size(Pos2::ZERO, vec2(w, h));
+            let l = layout(screen);
+            assert!(screen.contains_rect(l.panel), "{w}x{h}: the panel is inside the screen");
+            assert!((l.panel.center() - screen.center()).length() < 1.0, "{w}x{h}: centred");
+            assert!(l.panel.contains_rect(l.rows) && l.panel.contains_rect(l.help) && l.panel.contains_rect(l.keys), "{w}x{h}");
+            assert!(l.rows.bottom() <= l.help.top() && l.help.bottom() <= l.keys.top() + 1.0, "{w}x{h}: rows, help and keys do not overlap");
+            assert!(l.rows.height() >= l.row_h * 4.0, "{w}x{h}: room for four rows at least");
+        }
+    }
+
+    #[test]
+    fn the_letters_grow_with_the_screen() {
+        let small = layout(Rect::from_min_size(Pos2::ZERO, vec2(1280.0, 720.0)));
+        let big = layout(Rect::from_min_size(Pos2::ZERO, vec2(2560.0, 1440.0)));
+        assert!((big.u / small.u - 2.0).abs() < 0.05);
+    }
+
+    #[test]
+    fn the_marked_row_is_always_in_view() {
+        let rect = Rect::from_min_size(Pos2::ZERO, vec2(400.0, 300.0));
+        assert_eq!(window(rect, 50.0, 4, 3), (0, 6), "all fit");
+        let (first, fit) = window(rect, 100.0, 10, 7);
+        assert_eq!(fit, 3);
+        assert!(first <= 7 && 7 < first + fit, "row 7 is shown with {fit} rows from {first}");
+        assert_eq!(window(rect, 100.0, 10, 0).0, 0);
+        assert_eq!(window(rect, 100.0, 10, 9).0, 7);
+    }
+}
