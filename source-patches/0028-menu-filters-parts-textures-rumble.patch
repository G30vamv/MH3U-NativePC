+//! The in-game menu's model: the tabs, the rows each one lists, what the buttons do to them, and how a held direction repeats.
+//! Nothing here draws or reads a device (`menu_draw.rs` and `overlay.rs` do): it is plain data and rules, so it can be tested.
+//!
+//! The menu is moved with a gamepad (the pad or the left stick for up, down, left and right; A accepts, B goes back, Y brings a
+//! value back to what it is without any choice, L and R change tab), with the keyboard (arrows, Enter, Escape, Delete, Q and E or
+//! Page Up and Page Down for the tabs) and with the mouse (the rows, their arrows and the tabs can be clicked).
+
+use crate::settings::{self, Lang, Live, Present, Upscaler};
+
+/// One page of the menu.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Tab {
+    Graphics,
+    Game,
+    Panels,
+    Controls,
+    Cheats,
+}
+
+pub const TABS: [Tab; 5] = [Tab::Graphics, Tab::Game, Tab::Panels, Tab::Controls, Tab::Cheats];
+
+impl Tab {
+    pub fn label(self, l: Lang) -> &'static str {
+        match self {
+            Tab::Graphics => l.p("Graphics", "Gráficos"),
+            Tab::Game => l.p("Game", "Juego"),
+            Tab::Panels => l.p("Panels", "Paneles"),
+            Tab::Controls => l.p("Controls", "Controles"),
+            Tab::Cheats => l.p("Cheats", "Trucos"),
+        }
+    }
+}
+
+/// What a row changes.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Item {
+    Scale,
+    Upscaler,
+    Sharpness,
+    Present,
+    FpsLimit,
+    FpsCounter,
+    Bloom,
+    Blur,
+    CameraSens,
+    SmoothCamera,
+    HoldGather,
+    Rumble,
+    QuestMap,
+    Language,
+    SmallMonsters,
+    MonsterScope,
+    PartsShown,
+    ResetCounter,
+    ResetPanels,
+    MovePanels,
+    /// A line that only tells something.
+    Info,
+}
+
+/// How a row shows its value.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Kind {
+    /// One of a few choices, with arrows at its sides (`left` / `right`: whether there is a choice that way).
+    Choice { text: String, left: bool, right: bool },
+    /// A number in a range, as a bar (`frac` 0 to 1) with its text.
+    Slider { frac: f32, text: String },
+    Toggle { on: bool },
+    Button,
+    Info { text: String },
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Row {
+    pub item: Item,
+    pub label: String,
+    /// The line shown under the menu while the row is marked.
+    pub help: String,
+    pub kind: Kind,
+    /// A row that cannot be used now (greyed out and skipped by the cursor).
+    pub enabled: bool,
+}
+
+impl Row {
+    /// Whether the cursor stops at the row (the lines that only tell something too: the cursor walks the long lists).
+    pub fn selectable(&self) -> bool {
+        self.enabled
+    }
+}
+
+/// Which monsters the life panel lists.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Scope {
+    /// The large monster the hunter hurt last, with its size and parts; until one is hurt, the life of the large ones.
+    Hit,
+    /// Every large monster of the quest, each with its size and parts.
+    All,
+}
+
+/// What the player chose for the monsters' panel (kept in `panel_prefs.txt`, apart from the settings the launcher knows).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PanelPrefs {
+    /// The small monsters (Jaggi, Felyne, Kelbi...) are listed too: off at first, the large ones are what matters.
+    pub small: bool,
+    pub scope: Scope,
+    /// The parts of a monster under its life.
+    pub parts: bool,
+}
+
+impl Default for PanelPrefs {
+    fn default() -> PanelPrefs {
+        PanelPrefs { small: false, scope: Scope::Hit, parts: true }
+    }
+}
+
+impl PanelPrefs {
+    /// From the file's text: lines `small=0|1`, `scope=hit|all`, `parts=0|1`; what is not understood keeps its usual value.
+    pub fn parse(text: &str) -> PanelPrefs {
+        let mut out = PanelPrefs::default();
+        for line in text.lines() {
+            let Some((key, value)) = line.split_once('=') else { continue };
+            let (key, value) = (key.trim(), value.trim());
+            let flag = matches!(value, "1" | "true" | "on" | "yes");
+            match key {
+                "small" => out.small = flag,
+                "parts" => out.parts = flag,
+                "scope" => out.scope = if value == "all" { Scope::All } else { Scope::Hit },
+                _ => {}
+            }
+        }
+        out
+    }
+
+    pub fn to_text(self) -> String {
+        format!("small={}\nscope={}\nparts={}\n", u8::from(self.small), if self.scope == Scope::All { "all" } else { "hit" }, u8::from(self.parts))
+    }
+
+    pub fn load(path: &std::path::Path) -> PanelPrefs {
+        std::fs::read_to_string(path).map(|t| PanelPrefs::parse(&t)).unwrap_or_default()
+    }
+
+    pub fn save(self, path: &std::path::Path) {
+        let _ = std::fs::write(path, self.to_text());
+    }
+}
+
+/// The screen filters (`mh3u_rt::filters`): the game's own glow and blur, on as the game has them.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct FxPrefs {
+    pub bloom: bool,
+    pub blur: bool,
+    /// The camera follows how far the right stick is pushed (`mh3u_rt::camera`).
+    pub camera: bool,
+    /// A held A gathers, carves and mines on its own (`mh3u_rt::gather`).
+    pub gather: bool,
+    /// The GamePad's rumble reaches the pad (`mh3u_rt::rumble`).
+    pub rumble: bool,
+    /// The quest's map is shown without the supply box's Map item (`mh3u_rt::questmap`).
+    pub map: bool,
+}
+
+impl Default for FxPrefs {
+    fn default() -> FxPrefs {
+        FxPrefs { bloom: true, blur: true, camera: true, gather: true, rumble: true, map: false }
+    }
+}
+
+impl FxPrefs {
+    /// From the file's text: lines `bloom=0|1` and `blur=0|1`; what is not understood keeps its usual value.
+    pub fn parse(text: &str) -> FxPrefs {
+        let mut out = FxPrefs::default();
+        for line in text.lines() {
+            let Some((key, value)) = line.split_once('=') else { continue };
+            let on = !matches!(value.trim(), "0" | "false" | "off" | "no");
+            match key.trim() {
+                "bloom" => out.bloom = on,
+                "blur" => out.blur = on,
+                "camera" => out.camera = on,
+                "gather" => out.gather = on,
+                "rumble" => out.rumble = on,
+                "map" => out.map = on,
+                _ => {}
+            }
+        }
+        out
+    }
+
+    pub fn to_text(self) -> String {
+        format!(
+            "bloom={}\nblur={}\ncamera={}\ngather={}\nrumble={}\nmap={}\n",
+            u8::from(self.bloom),
+            u8::from(self.blur),
+            u8::from(self.camera),
+            u8::from(self.gather),
+            u8::from(self.rumble),
+            u8::from(self.map)
+        )
+    }
+
+    /// The prefs in a file, or none when there is no file (then the launcher's settings, if any, stand).
+    pub fn load(path: &std::path::Path) -> Option<FxPrefs> {
+        std::fs::read_to_string(path).ok().map(|t| FxPrefs::parse(&t))
+    }
+
+    pub fn save(self, path: &std::path::Path) {
+        let _ = std::fs::write(path, self.to_text());
+    }
+}
+
+/// A monster the life panel lists, and whether it gets its size and parts too.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Shown {
+    /// Its place in the list of monsters.
+    pub index: usize,
+    pub detail: bool,
+}
+
+/// What the life panel lists: the large monsters first (all of them, or only the one being fought when `focus` is a large monster
+/// of the list and the scope is [`Scope::Hit`]), then the small ones if the player asked for them.
+pub fn shown(monsters: &[mh3u_rt::combat::Monster], focus: Option<u32>, prefs: &PanelPrefs, is_small: impl Fn(u8) -> bool) -> Vec<Shown> {
+    let large = || monsters.iter().enumerate().filter(|(_, m)| !is_small(m.id));
+    let fought = focus.and_then(|a| large().find(|(_, m)| m.address == a));
+    let mut out: Vec<Shown> = match (prefs.scope, fought) {
+        (Scope::Hit, Some((index, _))) => vec![Shown { index, detail: true }],
+        (scope, _) => large().map(|(index, _)| Shown { index, detail: scope == Scope::All }).collect(),
+    };
+    if prefs.small {
+        out.extend(monsters.iter().enumerate().filter(|(_, m)| is_small(m.id)).map(|(index, _)| Shown { index, detail: false }));
+    }
+    out
+}
+
+/// The values the menu edits, besides the ones in [`Live`] (a percent kept as the player sees it).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Values {
+    pub live: Live,
+    pub sharp_pct: u32,
+    pub stick_pct: u32,
+    pub panels: PanelPrefs,
+    pub fx: FxPrefs,
+}
+
+/// What the menu is told about the game and cannot change: which panels exist and what is listed in the information tabs.
+#[derive(Clone, Debug, Default)]
+pub struct Env {
+    /// The monsters' life and the damage meter are on (a cheat of the launcher).
+    pub life_on: bool,
+    pub meter_on: bool,
+    /// The keyboard and mouse bindings, as (what, keys).
+    pub controls: Vec<(String, String)>,
+    /// The cheats that are on, as (name, value).
+    pub cheats: Vec<(String, String)>,
+}
+
+/// What a row asks of the overlay besides changing a value.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Action {
+    ResetCounter,
+    ResetPanels,
+    MovePanels,
+}
+
+/// A press the menu understands.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Nav {
+    Up,
+    Down,
+    Left,
+    Right,
+    TabPrev,
+    TabNext,
+    Accept,
+    Back,
+    /// Y: the marked value goes back to its usual one.
+    Default,
+}
+
+/// What a press did.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Outcome {
+    Nothing,
+    /// A value changed (the overlay applies and keeps it).
+    Changed,
+    Action(Action),
+    /// The menu is to close.
+    Close,
+}
+
+/// The choices of each row that has them.
+const UPSCALERS: [Upscaler; 3] = [Upscaler::Fsr, Upscaler::Cas, Upscaler::Off];
+const PRESENTS: [Present; 3] = [Present::Fifo, Present::Mailbox, Present::Immediate];
+const SHARP_STEP: u32 = 5;
+const SHARP_RANGE: (u32, u32) = (20, 100);
+const STICK_STEP: u32 = 5;
+const STICK_RANGE: (u32, u32) = (25, 150);
+
+/// The frame limits in the order the menu goes through them: the numbers, then none.
+fn fps_choices() -> Vec<u32> {
+    settings::FPS_LIMITS.into_iter().chain([0]).collect()
+}
+
+fn index_of<T: PartialEq + Copy>(all: &[T], v: T) -> usize {
+    all.iter().position(|x| *x == v).unwrap_or(0)
+}
+
+fn upscaler_name(u: Upscaler, l: Lang) -> &'static str {
+    match u {
+        Upscaler::Fsr => "AMD FSR 1.0",
+        Upscaler::Cas => "AMD CAS",
+        Upscaler::Off => l.p("Off (bilinear)", "Desactivado (bilineal)"),
+    }
+}
+
+fn present_name(p: Present, l: Lang) -> &'static str {
+    match p {
+        Present::Fifo => "V-Sync",
+        Present::FifoRelaxed => l.p("V-Sync (relaxed)", "V-Sync (relajado)"),
+        Present::Mailbox => l.p("Mailbox (no tearing, low lag)", "Mailbox (sin cortes, poco retardo)"),
+        Present::Immediate => l.p("Immediate (no V-Sync)", "Inmediato (sin V-Sync)"),
+    }
+}
+
+fn limit_name(fps: u32, l: Lang) -> String {
+    match fps {
+        0 => l.p("No limit", "Sin límite").to_string(),
+        fps => format!("{fps} FPS"),
+    }
+}
+
+fn choice(text: String, index: usize, count: usize) -> Kind {
+    Kind::Choice { text, left: index > 0, right: index + 1 < count }
+}
+
+fn slider(value: u32, (low, high): (u32, u32), text: String) -> Kind {
+    Kind::Slider { frac: (value.saturating_sub(low)) as f32 / (high - low).max(1) as f32, text }
+}
+
