+/// The crown a large monster's size earns in the hunter's notes.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Crown {
+    Gold,
+    Silver,
+    /// The smallest ones.
+    Mini,
+}
+
+/// The crown of a monster of this kind and this size (in hundredths of the kind's usual size: 123 is 23 % bigger), if it earns one.
+/// The sizes each kind needs are the ones players have worked out for the game: most kinds share one set; small monsters and the
+/// kinds the game keeps no size record of get none.
+pub fn crown(id: u8, percent: u32) -> Option<Crown> {
+    if is_small(id) || percent == 0 {
+        return None;
+    }
+    let (gold, silver, mini) = match id {
+        // no size record: the Ceadeus and the Jhen Mohrans, Alatreon, Dire Miralis, Lucent Nargacuga, Abyssal Lagiacrus
+        20 | 24 | 25 | 61 | 69 | 70 | 75 | 85 => return None,
+        // Gigginox, Barioth, Glacial Agnaktor
+        4 | 5 | 57 => (116, 111, 92),
+        // Deviljho, and the hungry one
+        7 | 71 => (128, 120, 90),
+        // Great Baggi
+        14 => (137, 125, 83),
+        // the subspecies
+        // seen in a hunt: the one of id 67 at 108 % earned a silver crown, so its silver size is no more than that
+        67 => (123, 108, 98),
+        51..=56 | 58 | 60 | 62..=65 | 68 | 72 | 73 => (123, 117, 98),
+        _ => (123, 115, 90),
+    };
+    if percent >= gold {
+        Some(Crown::Gold)
+    } else if percent >= silver {
+        Some(Crown::Silver)
+    } else if percent <= mini {
+        Some(Crown::Mini)
+    } else {
+        None
+    }
+}
+
