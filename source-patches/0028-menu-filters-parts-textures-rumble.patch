+/// Where the cursor and the page are.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct MenuState {
+    pub tab: usize,
+    pub sel: usize,
+}
+
+impl MenuState {
+    pub fn tab(&self) -> Tab {
+        TABS[self.tab.min(TABS.len() - 1)]
+    }
+
+    /// Puts the cursor on the first row it can stop at (or row 0 when none).
+    fn home(&mut self, rows: &[Row]) {
+        self.sel = rows.iter().position(Row::selectable).unwrap_or(0);
+    }
+
+    /// The cursor moved to the next row it can stop at in `dir`, wrapping around.
+    fn walk(&mut self, rows: &[Row], dir: i32) {
+        let n = rows.len() as i32;
+        if n == 0 {
+            return;
+        }
+        let mut at = self.sel as i32;
+        for _ in 0..n {
+            at = (at + dir).rem_euclid(n);
+            if rows[at as usize].selectable() {
+                self.sel = at as usize;
+                return;
+            }
+        }
+    }
+
+    pub fn go_to_tab(&mut self, tab: usize, v: &Values, env: &Env) {
+        self.tab = tab.min(TABS.len() - 1);
+        self.home(&rows(self.tab(), v, env));
+    }
+
+    /// Applies a press. `v` is edited in place; the outcome says what the overlay has to do about it.
+    pub fn handle(&mut self, nav: Nav, v: &mut Values, env: &Env) -> Outcome {
+        let list = rows(self.tab(), v, env);
+        if self.sel >= list.len() || !list[self.sel].selectable() {
+            self.home(&list);
+        }
+        match nav {
+            Nav::Up => self.walk(&list, -1),
+            Nav::Down => self.walk(&list, 1),
+            Nav::TabPrev => self.go_to_tab((self.tab + TABS.len() - 1) % TABS.len(), v, env),
+            Nav::TabNext => self.go_to_tab((self.tab + 1) % TABS.len(), v, env),
+            Nav::Back => return Outcome::Close,
+            Nav::Left | Nav::Right => {
+                let Some(row) = list.get(self.sel).filter(|r| r.selectable()) else { return Outcome::Nothing };
+                let dir = if nav == Nav::Left { -1 } else { 1 };
+                if adjust(row.item, dir, v) {
+                    return Outcome::Changed;
+                }
+            }
+            Nav::Accept => {
+                let Some(row) = list.get(self.sel).filter(|r| r.selectable()) else { return Outcome::Nothing };
+                match row.item {
+                    Item::ResetCounter => return Outcome::Action(Action::ResetCounter),
+                    Item::ResetPanels => return Outcome::Action(Action::ResetPanels),
+                    Item::MovePanels => return Outcome::Action(Action::MovePanels),
+                    // a toggle flips; a choice goes to the next one (back to the first after the last)
+                    Item::FpsCounter | Item::Bloom | Item::Blur | Item::SmoothCamera | Item::HoldGather | Item::Rumble | Item::QuestMap | Item::SmallMonsters | Item::PartsShown => return if adjust(row.item, 1, v) { Outcome::Changed } else { Outcome::Nothing },
+                    Item::Scale | Item::Upscaler | Item::Present | Item::FpsLimit | Item::Language | Item::MonsterScope => {
+                        let more = match &row.kind {
+                            Kind::Choice { right, .. } => *right,
+                            _ => false,
+                        };
+                        if more {
+                            adjust(row.item, 1, v);
+                        } else {
+                            // after the last choice: back to the first
+                            for _ in 0..8 {
+                                adjust(row.item, -1, v);
+                            }
+                        }
+                        return Outcome::Changed;
+                    }
+                    Item::Sharpness | Item::CameraSens | Item::Info => {}
+                }
+            }
+            Nav::Default => {
+                let Some(row) = list.get(self.sel).filter(|r| r.selectable()) else { return Outcome::Nothing };
+                let d = default_values(v);
+                let before = *v;
+                match row.item {
+                    Item::Scale => v.live.scale = d.live.scale,
+                    Item::Upscaler => v.live.upscaler = d.live.upscaler,
+                    Item::Sharpness => v.sharp_pct = d.sharp_pct,
+                    Item::Present => v.live.present = d.live.present,
+                    Item::FpsLimit => v.live.fps_limit = d.live.fps_limit,
+                    Item::FpsCounter => v.live.fps_counter = d.live.fps_counter,
+                    Item::CameraSens => {
+                        v.stick_pct = d.stick_pct;
+                        v.live.right_stick = d.stick_pct;
+                    }
+                    Item::Bloom => v.fx.bloom = d.fx.bloom,
+                    Item::Blur => v.fx.blur = d.fx.blur,
+                    Item::SmoothCamera => v.fx.camera = d.fx.camera,
+                    Item::HoldGather => v.fx.gather = d.fx.gather,
+                    Item::Rumble => v.fx.rumble = d.fx.rumble,
+                    Item::QuestMap => v.fx.map = d.fx.map,
+                    Item::SmallMonsters => v.panels.small = d.panels.small,
+                    Item::MonsterScope => v.panels.scope = d.panels.scope,
+                    Item::PartsShown => v.panels.parts = d.panels.parts,
+                    Item::Language | Item::ResetCounter | Item::ResetPanels | Item::MovePanels | Item::Info => {}
+                }
+                if *v != before {
+                    return Outcome::Changed;
+                }
+            }
+        }
+        Outcome::Nothing
+    }
+
+    /// The mouse marks a row.
+    pub fn point_at(&mut self, row: usize, v: &Values, env: &Env) {
+        let list = rows(self.tab(), v, env);
+        if list.get(row).is_some_and(Row::selectable) {
+            self.sel = row;
+        }
+    }
+}
+
+/// A direction held down turns into presses: the first at once, then, after a wait, a steady beat (a menu that needs one press for
+/// each step is tiring for a slider; one that races is hard to stop on a row).
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Repeater {
+    held: Option<(Nav, f64)>,
+}
+
+/// Seconds before a held direction starts repeating, and between its repeats.
+const REPEAT_WAIT: f64 = 0.42;
+const REPEAT_BEAT: f64 = 0.085;
+
+impl Repeater {
+    /// `dir` is the direction held now (if any) and `now` the time in seconds; gives the press to make, if one is due.
+    pub fn update(&mut self, dir: Option<Nav>, now: f64) -> Option<Nav> {
+        match (dir, self.held) {
+            (None, _) => {
+                self.held = None;
+                None
+            }
+            (Some(d), Some((held, next))) if held == d => {
+                if now >= next {
+                    self.held = Some((d, now + REPEAT_BEAT));
+                    Some(d)
+                } else {
+                    None
+                }
+            }
+            (Some(d), _) => {
+                self.held = Some((d, now + REPEAT_WAIT));
+                Some(d)
+            }
+        }
+    }
+}
+
+/// The direction a pad is pushed in: the cross wins, else the left stick (past 0.6 on its larger axis; up is a positive y).
+pub fn direction(buttons: u32, stick: (f32, f32)) -> Option<Nav> {
+    use mh3u_rt::input::button;
+    if buttons & button::UP != 0 {
+        return Some(Nav::Up);
+    }
+    if buttons & button::DOWN != 0 {
+        return Some(Nav::Down);
+    }
+    if buttons & button::LEFT != 0 {
+        return Some(Nav::Left);
+    }
+    if buttons & button::RIGHT != 0 {
+        return Some(Nav::Right);
+    }
+    let (x, y) = stick;
+    if x.abs().max(y.abs()) < 0.6 {
+        return None;
+    }
+    Some(if y.abs() >= x.abs() {
+        if y > 0.0 { Nav::Up } else { Nav::Down }
+    } else if x > 0.0 {
+        Nav::Right
+    } else {
+        Nav::Left
+    })
+}
