diff --git a/crates/mh3u-rt/src/questmap.rs b/crates/mh3u-rt/src/questmap.rs
new file mode 100644
index 0000000..7ac729d
--- /dev/null
+++ b/crates/mh3u-rt/src/questmap.rs
@@ -0,0 +1,97 @@
+//! The quest's map on the screen without the Map item. In high rank and G rank the supply box holds the Map (item 0x3f2): until the
+//! hunter takes it there is no map. `f_0260eea8(_, hunter)` (the cockpit map's "is there a map" question, read with Ghidra,
+//! `docs/ghidra.md`) answers yes when the quest is of a kind that always has it, or when the hunter has that item, and never on the
+//! stage kind 6. With the switch on, the hook answers yes for every stage that can have a map (`MH3U_MAP=on` starts with it on;
+//! the overlay's menu turns it on and off while playing).
+
+use crate::guest::Guest;
+use crate::hooks::{Callback, Hook, Registry};
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering::Relaxed};
+
+static ON: AtomicBool = AtomicBool::new(false);
+
+pub fn enabled() -> bool {
+    ON.load(Relaxed)
+}
+
+pub fn set_enabled(on: bool) {
+    ON.store(on, Relaxed);
+}
+
+/// Where the game keeps the stage (`sStage::mpInstance`), the byte of it that says which stage this is, and the table that turns
+/// that byte into the kind of stage.
+const STAGE: u32 = 0x1031_5c80;
+const STAGE_INDEX: u32 = 0x115;
+const STAGE_KINDS: u32 = 0x1020_6ab0;
+/// The kind of stage that never has a map (the game's own answer for it stays).
+const NO_MAP_STAGE: u32 = 6;
+
+/// The kind of stage the game works out from the stage byte `index` and that byte's entry in its table (`f_0218c730`).
+fn stage_kind(index: u32, entry: u8) -> u32 {
+    if index > 0x1b {
+        0xff
+    } else if entry == 0xff {
+        index
+    } else {
+        u32::from(entry)
+    }
+}
+
+/// Registers the hook (nothing without it in the build, which is said); the callback does nothing while the switch is off.
+pub fn register(r: &mut Registry) {
+    set_enabled(crate::input::switch_setting(std::env::var("MH3U_MAP").ok().as_deref(), false));
+    if !r.on("map_available", answer()) {
+        eprintln!("[map] the quest map switch needs the hook map_available: build the game again with the launcher's current mods/hooks.txt");
+    }
+}
+
+fn answer() -> Callback {
+    let told = AtomicU32::new(0);
+    Box::new(move |h: &mut Hook| {
+        if !enabled() {
+            return;
+        }
+        let g = Guest::new(h.ctx.mem);
+        let stage = g.u32(STAGE);
+        if stage == 0 {
+            return;
+        }
+        let index = u32::from(g.u8(stage.wrapping_add(STAGE_INDEX)));
+        let entry = if index <= 0x1b { g.u8(STAGE_KINDS + index) } else { 0xff };
+        if stage_kind(index, entry) == NO_MAP_STAGE {
+            return;
+        }
+        h.ctx.r[3] = 1;
+        h.skip = true;
+        if told.fetch_add(1, Relaxed) == 0 {
+            eprintln!("[map] the quest's map is shown without the supply box's Map (stage {index})");
+        }
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::BTreeMap;
+
+    #[test]
+    fn the_stage_kind_is_worked_out_as_the_game_does() {
+        assert_eq!(stage_kind(3, 0xff), 3, "no entry: the stage byte is the kind");
+        assert_eq!(stage_kind(3, 6), 6, "an entry gives the kind");
+        assert_eq!(stage_kind(0x1c, 6), 0xff, "a byte past the table");
+    }
+
+    #[test]
+    fn the_hook_skips_the_question_only_while_the_switch_is_on() {
+        let list: BTreeMap<u32, String> = [(0x0260_eea8, "map_available".to_string())].into();
+        let mut r = Registry::new(&list);
+        assert!(r.on("map_available", answer()));
+        // a memory with the stage pointer, a stage byte and its table entry where the game keeps them is too far up for a small test
+        // memory: with the switch off nothing is asked of it at all
+        let mut m = vec![0u8; 0x400];
+        let mut ctx = crate::game::new_ctx(m.as_mut_ptr());
+        set_enabled(false);
+        assert!(!r.run(0x0260_eea8, &mut ctx), "off: the game answers");
+        assert_eq!(ctx.r[3], 0);
+    }
+}
diff --git a/crates/mh3u-rt/src/rumble.rs b/crates/mh3u-rt/src/rumble.rs
new file mode 100644
index 0000000..ee101ea
--- /dev/null
+++ b/crates/mh3u-rt/src/rumble.rs
@@ -0,0 +1,152 @@
+//! The GamePad's rumble: the game asks for a pattern with `VPADControlMotor(channel, pattern, bits)` (one bit for each 1/120 s, a
+//! 1 is the motor on) and stops it with `VPADStopMotor(channel)`. The pattern is played on the pads XInput hears (a real Xbox pad,
+//! or DSX / DS4Windows / Steam Input making one out of a PlayStation pad), both motors at the strength the player chose.
+//!
+//! `MH3U_RUMBLE=off` turns it off, `MH3U_RUMBLE_STRENGTH=<0-100>` sets the strength (default 80). The menu switch calls
+//! [`set_enabled`] and [`set_strength`].
+
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering::Relaxed};
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+/// One bit of a pattern lasts this long.
+const BIT: Duration = Duration::from_micros(8_333);
+/// The longest pattern kept (bits).
+const MAX_BITS: usize = 8 * 1024;
+
+static ENABLED: AtomicBool = AtomicBool::new(true);
+static STRENGTH: AtomicU32 = AtomicU32::new(80);
+static STARTED: AtomicBool = AtomicBool::new(false);
+static PLAYING: Mutex<Option<Pattern>> = Mutex::new(None);
+static LOGGED: AtomicU32 = AtomicU32::new(0);
+
+struct Pattern {
+    bytes: Vec<u8>,
+    bits: usize,
+    from: Instant,
+}
+
+impl Pattern {
+    /// Whether the motor is on at `at`; `None` when the pattern is over.
+    fn at(&self, at: Instant) -> Option<bool> {
+        let bit = (at.saturating_duration_since(self.from).as_micros() / BIT.as_micros()) as usize;
+        if bit >= self.bits {
+            return None;
+        }
+        Some(self.bytes.get(bit / 8).is_some_and(|b| b & (0x80 >> (bit % 8)) != 0))
+    }
+}
+
+pub fn enabled() -> bool {
+    ENABLED.load(Relaxed)
+}
+
+pub fn set_enabled(on: bool) {
+    ENABLED.store(on, Relaxed);
+    if !on {
+        stop();
+    }
+}
+
+pub fn strength() -> u32 {
+    STRENGTH.load(Relaxed)
+}
+
+pub fn set_strength(percent: u32) {
+    STRENGTH.store(percent.min(100), Relaxed);
+}
+
+/// Reads `MH3U_RUMBLE` and `MH3U_RUMBLE_STRENGTH` (once, when the game starts).
+pub fn init_from_env() {
+    if std::env::var("MH3U_RUMBLE").is_ok_and(|v| matches!(v.to_ascii_lowercase().as_str(), "off" | "0" | "no" | "false")) {
+        ENABLED.store(false, Relaxed);
+    }
+    if let Some(v) = std::env::var("MH3U_RUMBLE_STRENGTH").ok().and_then(|v| v.trim().parse::<u32>().ok()) {
+        set_strength(v);
+    }
+}
+
+/// `VPADControlMotor`: play `bytes` (`bits` of them) from now on, replacing what was playing.
+pub fn play(bytes: &[u8], bits: usize) {
+    if LOGGED.fetch_add(1, Relaxed) < 12 {
+        eprintln!("[rumble] pattern of {bits} bits, first bytes {:02x?}", &bytes[..bytes.len().min(8)]);
+    }
+    if !enabled() || bits == 0 {
+        return;
+    }
+    let bits = bits.min(MAX_BITS).min(bytes.len() * 8);
+    *PLAYING.lock().unwrap_or_else(|e| e.into_inner()) = Some(Pattern { bytes: bytes.to_vec(), bits, from: Instant::now() });
+    start();
+}
+
+/// `VPADStopMotor`.
+pub fn stop() {
+    *PLAYING.lock().unwrap_or_else(|e| e.into_inner()) = None;
+}
+
+fn start() {
+    if STARTED.swap(true, Relaxed) {
+        return;
+    }
+    let _ = std::thread::Builder::new().name("rumble".into()).spawn(|| {
+        let mut last: Option<u16> = None;
+        loop {
+            let level = {
+                let mut playing = PLAYING.lock().unwrap_or_else(|e| e.into_inner());
+                match playing.as_ref().map(|p| p.at(Instant::now())) {
+                    Some(Some(on)) => {
+                        if on {
+                            (strength().min(100) * 65535 / 100) as u16
+                        } else {
+                            0
+                        }
+                    }
+                    Some(None) => {
+                        *playing = None;
+                        0
+                    }
+                    None => 0,
+                }
+            };
+            if last != Some(level) {
+                last = Some(level);
+                output(level);
+            }
+            // nothing to play: sleep longer and wake with the next pattern
+            let idle = PLAYING.lock().unwrap_or_else(|e| e.into_inner()).is_none();
+            std::thread::sleep(Duration::from_millis(if idle { 20 } else { 4 }));
+        }
+    });
+}
+
+#[cfg(windows)]
+fn output(level: u16) {
+    use windows_sys::Win32::UI::Input::XboxController::{XINPUT_VIBRATION, XInputSetState};
+    let vibration = XINPUT_VIBRATION { wLeftMotorSpeed: level, wRightMotorSpeed: level };
+    for slot in 0..4 {
+        // SAFETY: XInputSetState reads one XINPUT_VIBRATION, passed by value of a local; a slot with no pad just returns an error
+        unsafe {
+            XInputSetState(slot, &vibration);
+        }
+    }
+}
+
+#[cfg(not(windows))]
+fn output(_level: u16) {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_pattern_plays_bit_by_bit_and_ends() {
+        let p = Pattern { bytes: vec![0b1010_0000, 0xff], bits: 12, from: Instant::now() };
+        let at = |n: u64| p.at(p.from + BIT * n as u32 + Duration::from_micros(100));
+        assert_eq!(at(0), Some(true));
+        assert_eq!(at(1), Some(false));
+        assert_eq!(at(2), Some(true));
+        assert_eq!(at(8), Some(true));
+        assert_eq!(at(11), Some(true));
+        assert_eq!(at(12), None);
+    }
+}
