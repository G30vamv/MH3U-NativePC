+/// A binding's name as the keyboard list gives it ("Move", "Camera", or the name of a button), in the player's language.
+fn pretty_label(what: &str, l: Lang) -> String {
+    match what {
+        "Move" => l.p("Move", "Moverse").to_string(),
+        "Camera" => l.p("Camera", "Cámara").to_string(),
+        other => other.to_string(),
+    }
+}
+
+/// The keys of a binding as a player reads them: `KeyW KeyA (walk: ControlLeft)` is `W A (walk: Ctrl)`, in the player's language.
+pub fn pretty_keys(text: &str, l: Lang) -> String {
+    let (mut out, mut word) = (String::new(), String::new());
+    for c in text.chars().chain(std::iter::once('\u{0}')) {
+        if c.is_alphanumeric() {
+            word.push(c);
+            continue;
+        }
+        if !word.is_empty() {
+            out.push_str(&pretty_word(&word, l));
+            word.clear();
+        }
+        if c != '\u{0}' {
+            out.push(c);
+        }
+    }
+    out
+}
+
+fn pretty_word(w: &str, l: Lang) -> String {
+    let es = l == Lang::Es;
+    let pick = |en: &str, sp: &str| if es { sp.to_string() } else { en.to_string() };
+    match w {
+        "MouseLeft" => pick("Left click", "Clic izq."),
+        "MouseRight" => pick("Right click", "Clic der."),
+        "MouseMiddle" => pick("Middle click", "Clic central"),
+        "ControlLeft" | "ControlRight" => "Ctrl".to_string(),
+        "ShiftLeft" | "ShiftRight" => "Shift".to_string(),
+        "AltLeft" | "AltRight" => "Alt".to_string(),
+        "Space" => pick("Space", "Espacio"),
+        "ArrowUp" => pick("Up", "Arriba"),
+        "ArrowDown" => pick("Down", "Abajo"),
+        "ArrowLeft" => pick("Left", "Izquierda"),
+        "ArrowRight" => pick("Right", "Derecha"),
+        "walk" => pick("walk", "caminar"),
+        "mouse" => pick("mouse", "ratón"),
+        "up" if es => "arriba".to_string(),
+        "and" if es => "y".to_string(),
+        "down" if es => "abajo".to_string(),
+        "inverted" if es => "invertidos".to_string(),
+        _ if w.len() == 4 && w.starts_with("Key") => w[3..].to_string(),
+        _ if w.len() == 6 && w.starts_with("Digit") => w[5..].to_string(),
+        _ => w.to_string(),
+    }
+}
