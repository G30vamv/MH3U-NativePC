@@ -0,0 +1,83 @@
+//! The screen filters the player can turn off: the glow around bright things (the bloom, `uBloomFilter`) and the blur (the game's
+//! depth of field and bokeh, `uDOFFilter` and `uBokehFilter`). Each one is drawn by one function, `vf11` of its class, which is
+//! hooked (`mods/hooks.txt`); with the filter off the hook skips that function, so it is never drawn and costs the graphics card
+//! nothing. The overlay's menu turns them on and off while the game runs (`set_bloom`, `set_blur`); `MH3U_BLOOM=off` and
+//! `MH3U_BLUR=off` start the game with them off.
+
+use crate::hooks::{Callback, Hook, Registry};
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering::Relaxed};
+
+static BLOOM: AtomicBool = AtomicBool::new(true);
+static BLUR: AtomicBool = AtomicBool::new(true);
+
+pub fn set_bloom(on: bool) {
+    BLOOM.store(on, Relaxed);
+}
+
+pub fn set_blur(on: bool) {
+    BLUR.store(on, Relaxed);
+}
+
+pub fn bloom_on() -> bool {
+    BLOOM.load(Relaxed)
+}
+
+pub fn blur_on() -> bool {
+    BLUR.load(Relaxed)
+}
+
+/// Registers the filters' hooks (nothing for one the build lacks, which is said).
+pub fn register(r: &mut Registry) {
+    let env = |name: &str| crate::input::switch_setting(std::env::var(name).ok().as_deref(), true);
+    set_bloom(env("MH3U_BLOOM"));
+    set_blur(env("MH3U_BLUR"));
+    let mut missing = Vec::new();
+    for (hook, flag, what) in [("bloom_draw", &BLOOM, "bloom"), ("dof_draw", &BLUR, "depth of field"), ("bokeh_draw", &BLUR, "bokeh")] {
+        if !r.on(hook, skipping(flag, what)) {
+            missing.push(hook);
+        }
+    }
+    if !missing.is_empty() {
+        eprintln!("[fx] the bloom and blur switches need the hook(s) {missing:?}: build the game again with the launcher's current mods/hooks.txt");
+    }
+}
+
+/// The callback of a filter's draw: it is skipped while its flag is off. The first draws are logged (which scenes use each filter).
+fn skipping(flag: &'static AtomicBool, what: &'static str) -> Callback {
+    let seen = AtomicU32::new(0);
+    Box::new(move |h: &mut Hook| {
+        let on = flag.load(Relaxed);
+        if seen.fetch_add(1, Relaxed) < 2 {
+            eprintln!("[fx] the game draws the {what} ({})", if on { "on" } else { "off: skipped" });
+        }
+        if !on {
+            h.skip = true;
+        }
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::BTreeMap;
+
+    #[test]
+    fn a_filter_that_is_off_is_skipped_and_one_that_is_on_is_not() {
+        let list: BTreeMap<u32, String> = [(0x0200_1000, "bloom_draw".to_string()), (0x0200_2000, "dof_draw".to_string()), (0x0200_3000, "bokeh_draw".to_string())].into();
+        let mut r = Registry::new(&list);
+        register(&mut r);
+        let mut ctx = crate::new_test_ctx();
+        set_bloom(true);
+        set_blur(true);
+        assert!(!r.run(0x0200_1000, &mut ctx));
+        assert!(!r.run(0x0200_2000, &mut ctx));
+        set_bloom(false);
+        assert!(r.run(0x0200_1000, &mut ctx), "the bloom is off");
+        assert!(!r.run(0x0200_2000, &mut ctx), "the blur is separate");
+        set_blur(false);
+        assert!(r.run(0x0200_2000, &mut ctx) && r.run(0x0200_3000, &mut ctx), "the depth of field and the bokeh follow the one switch");
+        set_bloom(true);
+        set_blur(true);
+        assert!(!r.run(0x0200_1000, &mut ctx), "back on");
+    }
+}
