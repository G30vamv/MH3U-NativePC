+
+/// The frame limits the player can choose: multiples of the console's 30 frames a second.
+pub const FPS_LIMITS: [u32; 8] = [30, 60, 90, 120, 150, 180, 210, 240];
+
+/// A frame limit from a setting (`MH3U_FPS_LIMIT`): one of [`FPS_LIMITS`], else 0 (no limit).
+pub fn fps_limit(setting: Option<&str>) -> u32 {
+    setting
+        .and_then(|value| value.trim().parse::<u32>().ok())
+        .filter(|fps| FPS_LIMITS.contains(fps))
+        .unwrap_or(0)
+}
+
+static FPS_LIMIT: AtomicU32 = AtomicU32::new(0);
+/// When the next frame is due, with a limit on.
+static NEXT_FRAME: Mutex<Option<Instant>> = Mutex::new(None);
+/// The game's thread waits for its frames itself (the resolver, `front.rs`), so the thread that draws them does not.
+static FRONT_PACES: AtomicBool = AtomicBool::new(false);
+
+/// Puts a frame limit in force (0: none). It takes effect at the next frame.
+pub fn set_fps_limit(fps: u32) {
+    if FPS_LIMIT.swap(fps, Relaxed) != fps {
+        *NEXT_FRAME.lock().unwrap_or_else(|e| e.into_inner()) = None;
+        if fps == 0 {
+            eprintln!("[gfx] frame limit: none");
+        } else {
+            eprintln!("[gfx] frame limit: {fps} frames a second");
+        }
+    }
+}
+
+/// When a frame due at `due` (if one was) is shown, and when the next one is due, for a frame that asks at `now` with `period`
+/// between frames. A frame that comes early waits; one that comes a little late is shown at once and the next keeps the beat; a
+/// game that fell further behind does not owe the frames it missed.
+fn paced(due: Option<Instant>, now: Instant, period: Duration) -> (Instant, Instant) {
+    let at = match due {
+        Some(due) if due > now || now - due < period => due,
+        _ => now,
+    };
+    (at, at + period)
+}
+
+/// Waits until `at`: sleeps all but the last millisecond, which it spends looking at the clock (a sleep wakes up late).
+fn wait_until(at: Instant) {
+    loop {
+        let now = Instant::now();
+        if now >= at {
+            return;
+        }
+        let left = at - now;
+        if left > Duration::from_micros(1500) {
+            std::thread::sleep(left - Duration::from_millis(1));
+        } else {
+            std::hint::spin_loop();
+        }
+    }
+}
+
+/// Called once a frame, before the frame is handed over to be shown: with a frame limit on, waits for the frame's turn. `front` is
+/// the game's own thread when the frames are drawn in another (the wait belongs there: the game is what must slow down).
+pub fn pace(front: bool) {
+    if front {
+        FRONT_PACES.store(true, Relaxed);
+    } else if FRONT_PACES.load(Relaxed) {
+        return;
+    }
+    let fps = FPS_LIMIT.load(Relaxed);
+    if fps == 0 {
+        return;
+    }
+    let period = Duration::from_nanos(1_000_000_000 / u64::from(fps));
+    let at = {
+        let mut next = NEXT_FRAME.lock().unwrap_or_else(|e| e.into_inner());
+        let (at, then) = paced(*next, Instant::now(), period);
+        *next = Some(then);
+        at
+    };
+    wait_until(at);
 }
 
