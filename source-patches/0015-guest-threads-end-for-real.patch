diff --git a/crates/mh3u-rt/src/kernel.rs b/crates/mh3u-rt/src/kernel.rs
index 71f711b..4525c81 100644
--- a/crates/mh3u-rt/src/kernel.rs
+++ b/crates/mh3u-rt/src/kernel.rs
@@ -433,6 +433,14 @@ pub fn retire(guard: MutexGuard<'static, Option<Kernel>>) -> ! {
     let mut guard = hand_on_for_good(guard);
     guard.as_mut().expect("kernel").baton.exited += 1;
     drop(guard);
+    // The translated frames below this one hold no destructors and nothing waits on the thread, so on Windows it ends here and its
+    // stack is freed (parking left one host thread per ended guest thread: about 30 a minute, thousands in a long session).
+    #[cfg(windows)]
+    // SAFETY: the kernel lock is released and only translated (C) frames are on this stack
+    unsafe {
+        windows_sys::Win32::System::Threading::ExitThread(0)
+    }
+    #[cfg(not(windows))]
     loop {
         std::thread::park();
     }
