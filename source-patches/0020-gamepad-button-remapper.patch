--- /dev/null
+++ b/crates/mh3u-rt/src/padmap.rs
@@ -0,0 +1,213 @@
+//! The gamepad button remapper: which GamePad button each button of the player's pad counts as.
+//!
+//! It works on the GamePad buttons after every pad reader (gilrs, XInput, HID) has turned its own into them with the layout
+//! (`MH3U_PAD_LAYOUT`), so it is the same for every pad. `MH3U_PAD_MAP` lists what is not as usual, as `from>to` pairs separated by
+//! commas: `B>A,A>B` swaps A and B, `ZL>` turns ZL off, `X>A+Y` makes X press A and Y together. Names: `A B X Y L R ZL ZR Plus Minus
+//! Home Up Down Left Right L3 R3`, in any case. A button not listed keeps doing what it did.
+//!
+//! The overlay's combination (Back + R) and the buttons of the overlay are read before the map, so no map can lock the player out.
+
+use crate::input::button;
+use std::sync::OnceLock;
+
+/// The buttons that can be mapped, by name.
+pub const NAMES: [(&str, u32); 17] = [
+    ("A", button::A),
+    ("B", button::B),
+    ("X", button::X),
+    ("Y", button::Y),
+    ("L", button::L),
+    ("R", button::R),
+    ("ZL", button::ZL),
+    ("ZR", button::ZR),
+    ("PLUS", button::PLUS),
+    ("MINUS", button::MINUS),
+    ("HOME", button::HOME),
+    ("UP", button::UP),
+    ("DOWN", button::DOWN),
+    ("LEFT", button::LEFT),
+    ("RIGHT", button::RIGHT),
+    ("L3", button::STICK_L),
+    ("R3", button::STICK_R),
+];
+
+/// The name of a single button's bit.
+pub fn name_of(mask: u32) -> Option<&'static str> {
+    NAMES.iter().find(|(_, m)| *m == mask).map(|(n, _)| *n)
+}
+
+fn bit_of(name: &str) -> Option<u32> {
+    let name = name.trim().to_ascii_uppercase();
+    NAMES.iter().find(|(n, _)| *n == name).map(|(_, m)| *m)
+}
+
+/// What each button of a pad counts as.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PadMap {
+    /// For each of `NAMES`, the buttons it presses (its own bit by default; 0 for none).
+    to: [u32; NAMES.len()],
+}
+
+impl Default for PadMap {
+    fn default() -> PadMap {
+        let mut to = [0; NAMES.len()];
+        for (t, (_, m)) in to.iter_mut().zip(NAMES) {
+            *t = m;
+        }
+        PadMap { to }
+    }
+}
+
+impl PadMap {
+    /// From a `MH3U_PAD_MAP` value. What cannot be read is left out and said in the second part (one line per problem).
+    pub fn parse(text: &str) -> (PadMap, Vec<String>) {
+        let mut map = PadMap::default();
+        let mut problems = Vec::new();
+        for pair in text.split(',').map(str::trim).filter(|p| !p.is_empty()) {
+            let Some((from, to)) = pair.split_once('>') else {
+                problems.push(format!("`{pair}` is not from>to"));
+                continue;
+            };
+            let Some(i) = bit_of(from).and_then(|m| NAMES.iter().position(|(_, x)| *x == m)) else {
+                problems.push(format!("`{}` is not a button", from.trim()));
+                continue;
+            };
+            let mut mask = 0;
+            let mut ok = true;
+            for part in to.split('+').map(str::trim).filter(|p| !p.is_empty()) {
+                match bit_of(part) {
+                    Some(m) => mask |= m,
+                    None => {
+                        problems.push(format!("`{part}` is not a button"));
+                        ok = false;
+                    }
+                }
+            }
+            if ok {
+                map.to[i] = mask;
+            }
+        }
+        (map, problems)
+    }
+
+    /// Whether nothing is changed.
+    pub fn is_default(&self) -> bool {
+        *self == PadMap::default()
+    }
+
+    /// The buttons the game gets for the pad buttons held (the bits that are not mappable buttons pass as they are).
+    pub fn apply(&self, held: u32) -> u32 {
+        let known = NAMES.iter().fold(0, |a, (_, m)| a | m);
+        let mut out = held & !known;
+        for ((_, m), to) in NAMES.iter().zip(self.to) {
+            if held & m != 0 {
+                out |= to;
+            }
+        }
+        out
+    }
+}
+
+/// The map of this run, read from `MH3U_PAD_MAP` the first time it is asked for (and described in the log then).
+pub fn current() -> &'static PadMap {
+    static MAP: OnceLock<PadMap> = OnceLock::new();
+    MAP.get_or_init(|| {
+        let text = std::env::var("MH3U_PAD_MAP").unwrap_or_default();
+        let (map, problems) = PadMap::parse(&text);
+        for p in &problems {
+            eprintln!("[input] MH3U_PAD_MAP: {p}; left out");
+        }
+        if !map.is_default() {
+            eprintln!("[input] gamepad buttons remapped (MH3U_PAD_MAP={text})");
+        }
+        map
+    })
+}
+
+/// `mh3u-tools pad-listen`: reads the pads as the game does (no window, so XInput and the HID reader) and writes `down NAME` and
+/// `up NAME` on stdout for each GamePad button pressed and let go, with the layout of `MH3U_PAD_LAYOUT` but no remap, so the launcher
+/// can ask the player to press the button to map. The pads' own lines (`gamepad: ...`, `[hid] ...`) go to stderr. Ends after
+/// `seconds`, or when the reader of stdout goes away.
+pub fn listen(seconds: u64) {
+    use crate::input::{FOCUSED, INPUT, start_gamepads};
+    use std::io::Write;
+    use std::sync::atomic::Ordering::Relaxed;
+    use std::time::{Duration, Instant};
+    // no window: gilrs hears nothing then on Windows, which is the case the background XInput reader is for
+    FOCUSED.store(false, Relaxed);
+    start_gamepads();
+    let end = Instant::now() + Duration::from_secs(seconds);
+    let mut held = 0;
+    let mut out = std::io::stdout().lock();
+    while Instant::now() < end {
+        std::thread::sleep(Duration::from_millis(5));
+        let now = INPUT.raw_pad_buttons();
+        if now == held {
+            continue;
+        }
+        for (name, m) in NAMES {
+            if (now ^ held) & m != 0 && writeln!(out, "{} {name}", if now & m != 0 { "down" } else { "up" }).is_err() {
+                return;
+            }
+        }
+        if out.flush().is_err() {
+            return;
+        }
+        held = now;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn nothing_listed_changes_nothing() {
+        let (m, problems) = PadMap::parse("");
+        assert!(m.is_default() && problems.is_empty());
+        let held = button::A | button::ZL | button::STICK_R | button::STICK_L_UP;
+        assert_eq!(m.apply(held), held);
+    }
+
+    #[test]
+    fn a_swap_turns_a_button_off_and_two_at_once_work() {
+        let (m, problems) = PadMap::parse("b>a, A>B ,zl>,x>A+Y");
+        assert!(problems.is_empty(), "{problems:?}");
+        assert_eq!(m.apply(button::B), button::A);
+        assert_eq!(m.apply(button::A), button::B);
+        assert_eq!(m.apply(button::A | button::B), button::A | button::B);
+        assert_eq!(m.apply(button::ZL), 0);
+        assert_eq!(m.apply(button::X), button::A | button::Y);
+        assert_eq!(m.apply(button::R), button::R, "what is not listed is as usual");
+    }
+
+    #[test]
+    fn two_buttons_on_one_target_and_the_sticks_directions_pass() {
+        let (m, _) = PadMap::parse("L>ZL,R>ZL");
+        assert_eq!(m.apply(button::L | button::R), button::ZL);
+        let stick = button::STICK_R_UP | button::STICK_L_LEFT;
+        assert_eq!(
+            m.apply(stick | button::L),
+            stick | button::ZL,
+            "the sticks' buttons are not remapped"
+        );
+    }
+
+    #[test]
+    fn what_cannot_be_read_is_left_out_and_said() {
+        let (m, problems) = PadMap::parse("A>B,Q>A,B>Z,junk,X>Y+nope");
+        assert_eq!(problems.len(), 4, "{problems:?}");
+        assert_eq!(m.apply(button::A), button::B, "the good pair still counts");
+        assert_eq!(m.apply(button::B), button::B);
+        assert_eq!(m.apply(button::X), button::X, "a pair with a bad target is not half-applied");
+    }
+
+    #[test]
+    fn every_name_round_trips() {
+        for (n, m) in NAMES {
+            assert_eq!(bit_of(n), Some(m));
+            assert_eq!(name_of(m), Some(n));
+        }
+        assert_eq!(NAMES.iter().fold(0u32, |a, (_, m)| a | m).count_ones(), 17);
+    }
+}
