+/// What the game would make of a push of the right stick (the camera's and the aim's directions): none under the length it counts
+/// (about 0.37), up or down in the 60 degrees around the vertical, else a side. Only used to tell the log when it changes.
+fn stick_sector(v: (f32, f32)) -> u32 {
+    if v.0.hypot(v.1) < 0.37 {
+        return 0;
+    }
+    let angle = v.1.atan2(v.0).to_degrees().rem_euclid(360.0);
+    if (60.0..120.0).contains(&angle) {
+        1
+    } else if (240.0..300.0).contains(&angle) {
+        2
+    } else {
+        3
     }
 }
