+/// `sAppPad`'s instance pointer (the game's pad as the rest of it reads it).
+const APPPAD_SINGLETON: u32 = 0x1031_2bb0;
+/// `sPad`'s instance pointer; `+0x38` and `+0x3c` hold the main loop's counters at the last pad update and `+0x40` how far they moved
+/// (what the game's key repeat counts with).
+const PAD_SINGLETON: u32 = 0x102c_ea34;
+
+/// A diagnostic for the bowgun's aim: while the right stick is pushed, two lines a second say what the game holds about the local
+/// hunter's controls (`*(hunter + 0xe30)`: its state, whether it stands on the ground, the pad words it works from) and about the pad
+/// (`sAppPad`: the stick as angle and length). Nothing is written to the game. At most 400 lines in a run.
+pub fn probe_aim(g: &Guest, sticks: [f32; 4]) {
+    static LAST: Mutex<Option<std::time::Instant>> = Mutex::new(None);
+    static LINES: AtomicU32 = AtomicU32::new(0);
+    if (sticks[2].hypot(sticks[3]) < 0.3 && sticks[0].hypot(sticks[1]) < 0.3) || LINES.load(Relaxed) >= 400 {
+        return;
+    }
+    {
+        let mut last = LAST.lock().unwrap_or_else(|e| e.into_inner());
+        let now = std::time::Instant::now();
+        if last.is_some_and(|t| now.duration_since(t) < std::time::Duration::from_millis(500)) {
+            return;
+        }
+        *last = Some(now);
+    }
+    let Some(number) = local_slot(g) else { return };
+    let hunter = g.u32(g.u32(PLAYER_SINGLETON) + 0x40 + 4 * u32::from(number));
+    let ctrl = g.u32(hunter + 0xe30);
+    let app = g.u32(APPPAD_SINGLETON);
+    let game = g.u32(GAME_SINGLETON);
+    if ctrl == 0 || app == 0 {
+        return;
+    }
+    LINES.fetch_add(1, Relaxed);
+    let words = |at: u32, n: u32| (0..n).map(|i| format!("{:04x}", g.u16(at + 2 * i))).collect::<Vec<_>>().join(" ");
+    eprintln!(
+        "[aim probe] right stick ({:.2}, {:.2}) left stick ({:.2}, {:.2}); hunter {number}: state {} land {} +58 {} +e00 {} item-window {} \
+         pad words {} | ctrl 1ac-1c2 {} | hunter angles pitch {:04x} yaw {:04x} | app 134-13e {} 144 angle {:04x} {:04x} length {} {} | button config (slot:action/held) {} | action group {} id {:#x} flags bae/baf/bb0 {}{}{} staging {:08x} {:08x} | camera gate: sGame+4e {} +48 {} +3c4 {} ctrl+9ab {} +5e8 {:08x} status[2400..240a] {} | commands now {:08x} before {:08x} | aim target pitch {:04x} pitch {:04x} input {} | spad counters {} {} step {}",
+        sticks[2],
+        sticks[3],
+        sticks[0],
+        sticks[1],
+        g.u8(ctrl + 2),
+        g.u8(ctrl + 0x3d),
+        g.u8(ctrl + 0x58),
+        g.u8(ctrl + 0xe00),
+        g.u8(ctrl + 0x1542),
+        words(ctrl + 0x19c, 6),
+        words(ctrl + 0x1ac, 12),
+        g.u32(ctrl + 0x11c) & 0xffff,
+        g.u32(ctrl + 0x120) & 0xffff,
+        words(app + 0x134, 6),
+        g.u16(app + 0x144),
+        g.u16(app + 0x146),
+        g.u32(app + 0x148),
+        g.u32(app + 0x14c),
+        (0..0x24u32)
+            .filter_map(|i| {
+                let (action, held) = (g.u16(ctrl + 0x4d8 + 4 * i), g.u16(ctrl + 0x4da + 4 * i) as i16);
+                (action != 0 || held != 0).then(|| format!("{i:x}:{action:x}/{held}"))
+            })
+            .collect::<Vec<_>>()
+            .join(" "),
+        g.u8(ctrl + 0x3e),
+        g.u16(ctrl + 0x40),
+        g.u8(ctrl + 0xbae),
+        g.u8(ctrl + 0xbaf),
+        g.u8(ctrl + 0xbb0),
+        g.u32(ctrl + 0x1c8),
+        g.u32(ctrl + 0x1cc),
+        g.u8(game + 0x4e),
+        g.u8(game + 0x48),
+        g.u32(game + 0x3c4),
+        g.u8(ctrl + 0x9ab),
+        g.u32(ctrl + 0x5e8),
+        (0..11).map(|i| format!("{:x}", g.u8(hunter + 0x2400 + i))).collect::<String>(),
+        g.u32(ctrl + 0x1d0),
+        g.u32(ctrl + 0x1f0),
+        g.u32(ctrl + 0x184) & 0xffff,
+        g.u16(ctrl + 0x188),
+        g.u16(ctrl + 0xe80) as i16,
+        g.u32(g.u32(PAD_SINGLETON) + 0x38),
+        g.u32(g.u32(PAD_SINGLETON) + 0x3c),
+        g.u32(g.u32(PAD_SINGLETON) + 0x40)
+    );
+}
