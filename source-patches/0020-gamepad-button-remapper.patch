+/// The right stick as pushed and as scaled for the game, in the log: a line each time the push changes between nothing, up, down and
+/// a side (so a camera or an aim that does not go up or down shows what the game was given), and with `MH3U_TRACE_STICK=1` also a
+/// few times a second while it is pushed. `MH3U_TRACE_STICK=0` turns it off.
+fn log_right_stick(pushed: (f32, f32), scaled: (f32, f32)) {
+    static LAST_TIME: AtomicU32 = AtomicU32::new(0);
+    static LAST_SECTOR: AtomicU32 = AtomicU32::new(0);
+    static LAST_CHANGE: AtomicU32 = AtomicU32::new(0);
+    static MODE: std::sync::OnceLock<u8> = std::sync::OnceLock::new();
+    let mode = *MODE.get_or_init(|| match std::env::var("MH3U_TRACE_STICK").ok().as_deref().map(str::trim) {
+        Some("0") => 0,
+        Some(_) => 2,
+        None => 1,
+    });
+    if mode == 0 {
+        return;
+    }
+    let sector = stick_sector(scaled);
+    let frame = crate::FRAMES.load(Relaxed) as u32;
+    // a change is told at most ten times a second, so a stick going round does not fill the log
+    let changed = LAST_SECTOR.load(Relaxed) != sector && frame.wrapping_sub(LAST_CHANGE.load(Relaxed)) >= 6;
+    if changed {
+        LAST_SECTOR.store(sector, Relaxed);
+        LAST_CHANGE.store(frame, Relaxed);
+    }
+    let now = frame / 20;
+    let periodic = mode == 2 && pushed.0.hypot(pushed.1) > RIGHT_STICK_DEAD && LAST_TIME.swap(now, Relaxed) != now;
+    if !changed && !periodic {
+        return;
+    }
+    let angle = |v: (f32, f32)| v.1.atan2(v.0).to_degrees().rem_euclid(360.0);
+    eprintln!(
+        "[stick] {} pushed ({:.2}, {:.2}) length {:.2} angle {:.0}; for the game ({:.2}, {:.2}) length {:.2} angle {:.0}; gain {:.2}",
+        ["none", "up", "down", "side"][sector as usize],
+        pushed.0,
+        pushed.1,
+        pushed.0.hypot(pushed.1),
+        angle(pushed),
+        scaled.0,
+        scaled.1,
+        scaled.0.hypot(scaled.1),
+        angle(scaled),
+        load(&RIGHT_STICK_GAIN)
+    );
+}
