+/// How many draws with a geometry shader one batch holds before it is handed to the GPU. Each of them records two compute passes and
+/// two buffer clears besides its own draw, and the interface of the equipment screens has some 300 in a row: all of that in one batch
+/// ended in a lost device on a Radeon RX 6600 and, with the GPU queue on its own thread, in memory that grew without end on AMD cards.
+/// Cut into batches of this size neither happens (`MH3U_GFX_GS_BATCH=<n>` changes it, 0 turns the limit off).
+const GEOMETRY_DRAWS_PER_BATCH: u32 = 32;
+
+/// The limit set by `MH3U_GFX_GS_BATCH`: its value, no limit for 0, and the default for anything else.
+fn geometry_batch_limit(setting: Option<&str>) -> u32 {
+    match setting.and_then(|v| v.trim().parse::<u32>().ok()) {
+        Some(0) => u32::MAX,
+        Some(n) => n,
+        None => GEOMETRY_DRAWS_PER_BATCH,
+    }
+}
+
+fn geometry_draws_per_batch() -> u32 {
+    static N: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *N.get_or_init(|| geometry_batch_limit(std::env::var("MH3U_GFX_GS_BATCH").ok().as_deref()))
+}
+
 /// How many bind groups are kept before the cache is emptied (it is also pruned of the ones not used for a second, see `prune`).
 const BIND_GROUP_LIMIT: usize = 16384;
 
