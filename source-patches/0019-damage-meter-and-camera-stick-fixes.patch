 pub fn set_right_stick_gain(gain: f32) {
     store(&RIGHT_STICK_GAIN, gain.clamp(0.2, 1.5));
 }
+
+/// The right stick counts as pushed past this length (the keyboard and the mouse take over below it).
+const RIGHT_STICK_DEAD: f32 = 0.05;
+
+/// The right stick with the player's sensitivity: its length times `gain` (at most 1) and the same direction. The game turns the
+/// stick into an angle and a length and only counts a direction when the angle falls in a sector (the camera's up and down in one
+/// of 60 degrees around straight up and down, left and right in ones of 120) and the length is at least about 0.37, so what is
+/// scaled must keep the angle: scaling and limiting each axis on its own bent a push towards the diagonal (an up that turned into
+/// a left or a right) and, with a low sensitivity, took the small axis under a dead zone of its own.
+fn scale_right_stick(x: f32, y: f32, gain: f32) -> (f32, f32) {
+    let length = x.hypot(y);
+    if length <= RIGHT_STICK_DEAD {
+        return (0.0, 0.0);
+    }
+    let scaled = (length * gain).min(1.0);
+    (x * scaled / length, y * scaled / length)
+}
+
+/// With `MH3U_TRACE_STICK` set: the right stick as pushed and as scaled for the game, a few times a second (to see what a
+/// sensitivity does to the camera or the aim).
+fn log_right_stick(pushed: (f32, f32), scaled: (f32, f32)) {
+    static LAST: AtomicU32 = AtomicU32::new(0);
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if !*ON.get_or_init(|| std::env::var_os("MH3U_TRACE_STICK").is_some()) || pushed.0.hypot(pushed.1) <= RIGHT_STICK_DEAD {
+        return;
+    }
+    let now = (crate::FRAMES.load(Relaxed) / 20) as u32;
+    if LAST.swap(now, Relaxed) != now {
+        let angle = |v: (f32, f32)| v.1.atan2(v.0).to_degrees().rem_euclid(360.0);
+        eprintln!(
+            "[stick] pushed ({:.2}, {:.2}) length {:.2} angle {:.0}; for the game ({:.2}, {:.2}) length {:.2} angle {:.0}; gain {:.2}",
+            pushed.0,
+            pushed.1,
+            pushed.0.hypot(pushed.1),
+            angle(pushed),
+            scaled.0,
+            scaled.1,
+            scaled.0.hypot(scaled.1),
+            angle(scaled),
+            load(&RIGHT_STICK_GAIN)
+        );
+    }
+}
