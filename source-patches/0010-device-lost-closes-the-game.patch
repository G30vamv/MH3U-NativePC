diff --git a/crates/mh3u-gfx/src/lost.rs b/crates/mh3u-gfx/src/lost.rs
new file mode 100644
index 0000000..0497d56
--- /dev/null
+++ b/crates/mh3u-gfx/src/lost.rs
@@ -0,0 +1,75 @@
+//! A graphics device the driver took away (a GPU reset, a driver crash): the game would go on with a frozen picture, sound and network
+//! alive and every buffer invalid. This tells the player what happened and closes the game instead.
+
+use crate::settings::Lang;
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicBool, Ordering::Relaxed};
+
+/// The adapter's name and backend, for the log line that says where the device was lost.
+pub(crate) static ADAPTER: OnceLock<String> = OnceLock::new();
+
+/// Only the driver or the GPU taking the device away closes the game; `Destroyed` is our own device going away at exit.
+fn is_a_loss(reason: wgpu::DeviceLostReason) -> bool {
+    !matches!(reason, wgpu::DeviceLostReason::Destroyed)
+}
+
+/// `MH3U_DEVICE_LOST_EXIT=off` keeps the old behaviour (log the loss and carry on).
+fn closes_the_game() -> bool {
+    !std::env::var("MH3U_DEVICE_LOST_EXIT").is_ok_and(|v| v.trim().eq_ignore_ascii_case("off"))
+}
+
+/// The title and the text of the message the player sees.
+fn message(lang: Lang) -> (&'static str, &'static str) {
+    (
+        lang.p("MH3U Port: graphics card stopped", "MH3U Port: la tarjeta gráfica se detuvo"),
+        lang.p(
+            "The graphics card stopped answering (usually a driver crash), so the picture can no longer be drawn. The game will close now; anything not saved is lost.\n\nTry this in the launcher: pick DirectX 12 as the graphics API, or lower the internal resolution to 1x. If it keeps happening, update the graphics driver (or go back to an older one).\n\nThe details are in mh3u_latest.log.",
+            "La tarjeta gráfica dejó de responder (suele ser un fallo del driver), así que ya no se puede dibujar la imagen. El juego se cerrará ahora; lo que no hayas guardado se pierde.\n\nPrueba esto en el launcher: elige DirectX 12 como API gráfica o baja la resolución interna a 1x. Si sigue pasando, actualiza el driver de la tarjeta (o vuelve a uno anterior).\n\nEl detalle está en mh3u_latest.log.",
+        ),
+    )
+}
+
+/// The device-lost callback: log where it happened, tell the player and close the game.
+pub(crate) fn on_lost(reason: wgpu::DeviceLostReason, text: &str) {
+    eprintln!("[gfx] DEVICE LOST ({reason:?}): {text}");
+    static ONCE: AtomicBool = AtomicBool::new(false);
+    if !is_a_loss(reason) || ONCE.swap(true, Relaxed) {
+        return;
+    }
+    eprintln!(
+        "[gfx] the device was lost on {} in scene {:?} at frame {}",
+        ADAPTER.get().map_or("an unknown adapter", String::as_str),
+        mh3u_rt::scene::scene(),
+        mh3u_rt::FRAMES.load(Relaxed)
+    );
+    if !closes_the_game() {
+        eprintln!("[gfx] MH3U_DEVICE_LOST_EXIT=off: the game goes on without a picture");
+        return;
+    }
+    eprintln!("[gfx] closing the game");
+    let (title, body) = message(Lang::parse(std::env::var("MH3U_UI_LANG").ok().as_deref()));
+    mh3u_rt::error_box(title, body);
+    std::process::exit(1);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_driver_loss_closes_the_game_and_our_own_teardown_does_not() {
+        assert!(is_a_loss(wgpu::DeviceLostReason::Unknown));
+        assert!(!is_a_loss(wgpu::DeviceLostReason::Destroyed));
+    }
+
+    #[test]
+    fn the_message_comes_in_both_languages_and_names_the_way_out() {
+        let (en_title, en) = message(Lang::En);
+        let (es_title, es) = message(Lang::Es);
+        assert_ne!(en_title, es_title);
+        assert_ne!(en, es);
+        for text in [en, es] {
+            assert!(text.contains("DirectX 12") && text.contains("1x") && text.contains("mh3u_latest.log"));
+        }
+    }
+}
