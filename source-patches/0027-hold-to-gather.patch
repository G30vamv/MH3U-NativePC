+//! Hold to gather (`MH3U_HOLD_GATHER=off` turns it off). Carving, gathering and mining give one item for each press of A. Every
+//! item got that way goes through `obtain_item`, `f_020eca2c` (the cockpit's "obtained" step; read with Ghidra, `docs/ghidra.md`).
+//! From an item on, an A that is kept held reaches the game as presses (`input::repeat_a`), as a hand tapping would, until A is
+//! let go or a few seconds pass with no other item (the spot is used up).
+
+use crate::hooks::{Callback, Hook, Registry};
+use std::sync::atomic::{AtomicU32, Ordering::Relaxed};
+use std::time::Duration;
+
+/// How long after an item a held A keeps repeating (carving one takes about two seconds; a large monster keeps the hunter busy
+/// for longer before the next carve can start).
+const GATHER_FOR: Duration = Duration::from_millis(6000);
+
+/// Registers it (nothing when it is off or the build lacks the hook).
+pub fn register(r: &mut Registry) {
+    if !crate::input::switch_setting(std::env::var("MH3U_HOLD_GATHER").ok().as_deref(), true) {
+        eprintln!("[gather] one press for each item, as the game has it (MH3U_HOLD_GATHER=off)");
+    } else if r.on("obtain_item", obtained()) {
+        eprintln!("[gather] holding A keeps carving, gathering and mining (MH3U_HOLD_GATHER=off turns it off)");
+    } else {
+        eprintln!("[gather] holding A to gather needs the hook obtain_item: build the game again with the launcher's current mods/hooks.txt");
+    }
+}
+
+fn obtained() -> Callback {
+    let n = AtomicU32::new(0);
+    Box::new(move |h: &mut Hook| {
+        crate::input::repeat_a(GATHER_FOR);
+        let k = n.fetch_add(1, Relaxed);
+        if k < 3 || k % 200 == 0 {
+            eprintln!("[gather] item {:#x} (time {}): a held A repeats for {} ms", h.ctx.r[5], k + 1, GATHER_FOR.as_millis());
+        }
+    })
+}
