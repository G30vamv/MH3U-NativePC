+/// Until when (milliseconds of [`clock_ms`], 0 = never asked) a held A reaches the game as presses (`gather.rs`: hold to gather).
+static REPEAT_A_UNTIL: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+/// A held A that repeats is given for this long and then let go for this long (more than a frame of the game at 30 a second).
+const REPEAT_ON_MS: u64 = 110;
+const REPEAT_OFF_MS: u64 = 70;
+
+/// Milliseconds since the first call.
+fn clock_ms() -> u64 {
+    static START: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+    START.get_or_init(std::time::Instant::now).elapsed().as_millis() as u64 + 1
+}
+
+/// From now and for `time`, an A that is kept held reaches the game as presses, as a hand tapping would.
+pub fn repeat_a(time: std::time::Duration) {
+    REPEAT_A_UNTIL.store(clock_ms() + time.as_millis() as u64, Relaxed);
+}
+
+/// The buttons the game gets at `now` when a held A repeats until `until`: A is let go for a moment every so often.
+fn repeated(buttons: u32, now: u64, until: u64) -> u32 {
+    if buttons & button::A != 0 && now < until && now % (REPEAT_ON_MS + REPEAT_OFF_MS) >= REPEAT_ON_MS {
+        buttons & !button::A
+    } else {
+        buttons
+    }
+}
